@* Pestaña Dashboard: indicadores y gráficos del gasto del hogar entre dos fechas, comparado con el periodo anterior de igual duración.
   Es interactivo como un cuadro de mando: pinchar una categoría, una persona o un tramo de la gráfica filtra el resto de elementos. *@
@using System.Globalization
@using MiParte.Web.Reparto
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject TimeProvider Reloj

<h1 class="sr">Dashboard de gastos de @Hogar.HogarActual?.Nombre</h1>

<section class="card" aria-labelledby="t-periodo">
    <div class="card-head"><h2 id="t-periodo">Dashboard de gastos</h2></div>
    <p class="muted">Elige el periodo que quieres controlar. Los gastos personales no cuentan en el total del hogar, igual que en el resumen mensual.</p>
    <div class="filtros" role="group" aria-label="Periodo">
        <label>Desde
            <input type="date" @bind="_m.Desde" @bind:after="_m.AplicarFechasAsync" max="@_m.Hasta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </label>
        <label>Hasta
            <input type="date" @bind="_m.Hasta" @bind:after="_m.AplicarFechasAsync" min="@_m.Desde.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </label>
    </div>
    <div class="u-fila-mt10" role="group" aria-label="Periodos rápidos">
        <button class="chip chip-btn" type="button" @onclick="() => _m.ElegirAsync(PeriodoRapido.EsteMes)">Este mes</button>
        <button class="chip chip-btn" type="button" @onclick="() => _m.ElegirAsync(PeriodoRapido.MesAnterior)">Mes anterior</button>
        <button class="chip chip-btn" type="button" @onclick="() => _m.ElegirAsync(PeriodoRapido.Ultimos30)">Últimos 30 días</button>
        <button class="chip chip-btn" type="button" @onclick="() => _m.ElegirAsync(PeriodoRapido.EsteAnio)">Este año</button>
    </div>
    @if (_m.ErrorPeriodo is { } errorPeriodo)
    {
        <div class="aviso err u-mt12" role="alert">@errorPeriodo</div>
    }
</section>

@if (_m.Cargando)
{
    <div class="spinbox" role="status"><div class="spin"></div><span>Cargando el dashboard…</span></div>
}
else if (_m.ErrorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_m.ErrorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (_m.R is not null && _m.RCat is not null && _m.RMiembro is not null && _m.RSerie is not null && _m.Base is not null)
{
    @if (_m.HayFiltros)
    {
        <div class="dash-filtros" role="group" aria-label="Filtros activos">
            <span class="muted">Filtrando por:</span>
            @if (_m.Filtro.Categoria is { } cat)
            {
                <button class="chip chip-btn sel" type="button" aria-label="Quitar el filtro de categoría @_m.NombreCategoriaRaiz(cat)" @onclick="() => _m.ElegirCategoria(cat)">Categoría: @_m.NombreCategoriaRaiz(cat) <Icono Nombre="x" Tamano="14" /></button>
            }
            @if (_m.Filtro.Miembro is { } mie)
            {
                <button class="chip chip-btn sel" type="button" aria-label="Quitar el filtro de persona @Formato.NombreMiembro(mie, _m.Miembros)" @onclick="() => _m.ElegirMiembro(mie)">Paga: @Formato.NombreMiembro(mie, _m.Miembros) <Icono Nombre="x" Tamano="14" /></button>
            }
            @if (_m.Filtro.CuentaComun)
            {
                <button class="chip chip-btn sel" type="button" aria-label="Quitar el filtro de cuenta común" @onclick="() => _m.ElegirMiembro(null)">Paga: cuenta común o ahorro <Icono Nombre="x" Tamano="14" /></button>
            }
            @if (_m.Tramo is { } tr)
            {
                <button class="chip chip-btn sel" type="button" aria-label="Quitar el filtro de fechas" @onclick="() => _m.ElegirTramo(tr)">Fechas: @GraficoLinea.EtiquetaTramo(tr) <Icono Nombre="x" Tamano="14" /></button>
            }
            <button class="linkbtn" type="button" @onclick="_m.QuitarFiltros">Quitar todos</button>
        </div>
    }
    else if (_m.Base.NumeroGastos > 0)
    {
        <p class="muted u-mt12">Pincha en una categoría, una persona o un punto de la gráfica para filtrar el resto.</p>
    }

    <section class="kpis" aria-label="Indicadores clave del periodo @_m.Periodo" aria-live="polite">
        <article class="kpi">
            <span class="kpi-lab">Gasto total</span>
            <b class="kpi-val" id="kpi-total">@Formato.Euros(_m.R.Total)</b>
            <span class="kpi-sub">@_m.R.NumeroGastos @(_m.R.NumeroGastos == 1 ? "gasto" : "gastos") entre @_m.Periodo</span>
        </article>
        <article class="kpi">
            <span class="kpi-lab">Frente al periodo anterior</span>
            @if (_m.R.Variacion is { } v)
            {
                <b class="kpi-val @(v > 0 ? "sube" : v < 0 ? "baja" : "")" id="kpi-variacion">@(v > 0 ? "▲ +" : v < 0 ? "▼ −" : "")@Math.Abs(v).ToString("P1", Es)</b>
                <span class="kpi-sub">@(v > 0 ? "Gastáis más" : v < 0 ? "Gastáis menos" : "Igual") que los @_m.Dias @(_m.Dias == 1 ? "día previo" : "días previos") (@Formato.Euros(_m.R.TotalAnterior))</span>
            }
            else
            {
                <b class="kpi-val" id="kpi-variacion">—</b>
                <span class="kpi-sub">Sin gastos en el periodo anterior con los que comparar</span>
            }
        </article>
        <article class="kpi">
            <span class="kpi-lab">Media diaria</span>
            <b class="kpi-val" id="kpi-media">@Formato.Euros(_m.R.MediaDiaria)</b>
            <span class="kpi-sub">En @_m.Dias @(_m.Dias == 1 ? "día" : "días")</span>
        </article>
        <article class="kpi">
            <span class="kpi-lab">Categoría principal</span>
            @if (_m.R.CategoriaPrincipal is { } cp)
            {
                <b class="kpi-val kpi-texto" id="kpi-categoria">@cp.Nombre</b>
                <span class="kpi-sub">@Formato.Euros(cp.Importe) · @ModeloDashboard.Porcentaje(cp.Importe, _m.R.Total) del total</span>
            }
            else
            {
                <b class="kpi-val" id="kpi-categoria">—</b>
                <span class="kpi-sub">Sin gastos con esta selección</span>
            }
        </article>
        <article class="kpi">
            <span class="kpi-lab">Mayor gasto</span>
            @if (_m.R.MayorGasto is { } mg)
            {
                <b class="kpi-val" id="kpi-mayor">@Formato.Euros(mg.Importe)</b>
                <span class="kpi-sub">@_m.NombreGasto(mg) · @mg.Fecha.ToString("dd/MM/yyyy", Es)</span>
            }
            else
            {
                <b class="kpi-val" id="kpi-mayor">—</b>
                <span class="kpi-sub">Sin gastos con esta selección</span>
            }
        </article>
    </section>

    @if (_m.Base.NumeroGastos == 0)
    {
        <section class="card">
            <div class="empty">No hay gastos del hogar entre estas fechas.@(_m.Base.Personales > 0 ? $" Hay {Formato.Euros(_m.Base.Personales)} en gastos personales." : "")</div>
        </section>
    }
    else
    {
        <section class="card" aria-labelledby="t-evolucion">
            <div class="card-head"><h2 id="t-evolucion">Evolución del gasto</h2><span class="tag">@_m.TextoGranularidad</span></div>
            <svg class="dash-svg" viewBox="0 0 520 220" role="group" aria-labelledby="t-evolucion">
                @foreach (var g in _g.Guias)
                {
                    <line class="gr-eje" x1="@GraficoLinea.N(GraficoLinea.MargenIzq)" x2="@GraficoLinea.N(GraficoLinea.Ancho - GraficoLinea.MargenDer)" y1="@g.Y" y2="@g.Y" />
                    @Etiqueta(GraficoLinea.N(GraficoLinea.MargenIzq - 6), g.YTexto, "end", g.Texto)
                }
                <path class="gr-area" d="@_g.Area" />
                <path class="gr-linea" d="@_g.Linea" />
                @for (var i = 0; i < _m.RSerie.Serie.Count; i++)
                {
                    var p = _m.RSerie.Serie[i];
                    var elegido = _m.Tramo?.Inicio == p.Inicio;
                    @if (elegido)
                    {
                        @* Guía vertical del tramo elegido, para localizarlo de un vistazo. *@
                        <line class="gr-sel" x1="@GraficoLinea.N(_g.X(i))" x2="@GraficoLinea.N(_g.X(i))" y1="@GraficoLinea.N(_g.Y(p.Importe))" y2="@GraficoLinea.N(GraficoLinea.MargenSup + GraficoLinea.AltoUtil)" />
                    }
                    <circle class="gr-punto @(elegido ? "sel" : _m.Tramo is not null ? "apagado" : "")" cx="@GraficoLinea.N(_g.X(i))" cy="@GraficoLinea.N(_g.Y(p.Importe))" r="@(_m.RSerie.Serie.Count > 62 ? "2.5" : "3.5")" />
                    @* Zona de pulsación más grande que el punto, también para el teclado. *@
                    <circle class="gr-hit" cx="@GraficoLinea.N(_g.X(i))" cy="@GraficoLinea.N(_g.Y(p.Importe))" r="11" tabindex="0" role="button" aria-pressed="@(elegido ? "true" : "false")"
                            aria-label="@GraficoLinea.EtiquetaTramo(p): @Formato.Euros(p.Importe). Filtrar por este tramo"
                            @onclick="() => _m.ElegirTramo(p)" @onkeydown="e => TeclaTramo(e, p)">
                        <title>@GraficoLinea.EtiquetaTramo(p): @Formato.Euros(p.Importe)</title>
                    </circle>
                    @if (_g.RotulaEje(i))
                    {
                        @Etiqueta(GraficoLinea.N(_g.X(i)), GraficoLinea.N(GraficoLinea.Alto - 8), _g.AnclaEje(i), GraficoLinea.EtiquetaEje(p))
                    }
                }
            </svg>
        </section>

        <div class="dash-dos">
            <section class="card" aria-labelledby="t-categorias">
                <div class="card-head"><h2 id="t-categorias">Gasto por categoría</h2></div>
                @foreach (var c in _m.CategoriasMostradas)
                {
                    var elegida = c.CategoriaId != Guid.Empty && _m.Filtro.Categoria == c.CategoriaId;
                    var porcentaje = ModeloDashboard.Porcentaje(c.Importe, _m.RCat.Total);
                    <button class="dash-fila dash-click @(elegida ? "sel" : _m.Filtro.Categoria is not null ? "apagada" : "")" type="button"
                            aria-pressed="@(elegida ? "true" : "false")" disabled="@(c.CategoriaId == Guid.Empty)"
                            aria-label="@c.Nombre: @Formato.Euros(c.Importe), @porcentaje. Filtrar por esta categoría" @onclick="() => _m.ElegirCategoria(c.CategoriaId)">
                        <span class="dash-fila-top">
                            <span class="dash-nombre">@c.Nombre</span>
                            <span class="g-importe">@Formato.Euros(c.Importe)</span>
                        </span>
                        <progress class="barra" max="100" value="@Math.Round(GraficoGastos.PorCiento(c.Importe, _m.RCat.Total), 1).ToString(CultureInfo.InvariantCulture)" aria-hidden="true"></progress>
                        <span class="muted dash-pie">@porcentaje · @c.Gastos @(c.Gastos == 1 ? "gasto" : "gastos")</span>
                    </button>
                }
            </section>

            <section class="card" aria-labelledby="t-quien">
                <div class="card-head"><h2 id="t-quien">Quién paga</h2></div>
                <p class="muted">Dinero adelantado por cada persona y parte que le corresponde según el reparto.</p>
                <svg class="dash-rosco" viewBox="0 0 42 42" role="img" aria-label="Reparto del dinero adelantado entre las personas del hogar">
                    <circle class="dn-fondo" cx="21" cy="21" r="15.915" fill="none" stroke-width="6" />
                    @foreach (var s in GraficoLinea.Rodajas(_m.RMiembro!.PorMiembro, id => ColorMiembro.De(id, _m.Miembros), _m.Filtro))
                    {
                        <circle class="@s.Clase dn-click @(s.Elegida ? "sel" : _m.HayMiembroElegido ? "apagada" : "")" cx="21" cy="21" r="15.915" fill="none" stroke-width="6"
                                stroke-dasharray="@s.Trazo" stroke-dashoffset="@s.Desfase" @onclick="() => _m.ElegirMiembro(s.Miembro)" />
                    }
                </svg>
                @foreach (var m in _m.RMiembro.PorMiembro)
                {
                    var elegido = m.MiembroId is { } mid ? _m.Filtro.Miembro == mid : _m.Filtro.CuentaComun;
                    <button class="dash-fila-top dash-miembro dash-click @(elegido ? "sel" : _m.HayMiembroElegido ? "apagada" : "")" type="button"
                            aria-pressed="@(elegido ? "true" : "false")" @onclick="() => _m.ElegirMiembro(m.MiembroId)">
                        <span class="dash-nombre">
                            @if (m.MiembroId is { } id)
                            {
                                <Avatar Nombre="@Formato.NombreMiembro(id, _m.Miembros)" Color="@ColorMiembro.De(id, _m.Miembros)" Tamano="sm" />
                                @Formato.NombreMiembro(id, _m.Miembros)
                            }
                            else
                            {
                                <span class="dn-punto" aria-hidden="true"></span>
                                @:Cuenta común o ahorro
                            }
                        </span>
                        <span class="muted">paga <b class="g-importe">@Formato.Euros(m.Pagado)</b> · le toca <b class="g-importe">@Formato.Euros(m.Asumido)</b></span>
                    </button>
                }
            </section>
        </div>

        <section class="card" aria-labelledby="t-mayores">
            <div class="card-head">
                <h2 id="t-mayores">Mayores gastos</h2>
                <a class="btn" href="@_m.UrlGastos" id="ver-gastos"><Icono Nombre="receipt" Tamano="16" />Ver y editar todos los gastos@(_m.HayFiltros ? " de la selección" : "")</a>
            </div>
            @foreach (var g in _m.R.Mayores)
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">@_m.NombreGasto(g)</div>
                        <div class="muted g-meta">@g.Fecha.ToString("dd/MM/yyyy", Es) · @ArbolCategorias.Ruta(_m.Categorias, g.CategoriaId)</div>
                    </div>
                    <div class="g-importe">@Formato.Euros(g.Importe)</div>
                </div>
            }
            @if (_m.R.Mayores.Count == 0)
            {
                <div class="empty">Ningún gasto del hogar con esta selección.</div>
            }
        </section>
    }

    @if (_m.R.Personales > 0 && _m.Base.NumeroGastos > 0)
    {
        <p class="muted">Además hay @Formato.Euros(_m.R.Personales) en gastos personales, fuera del total del hogar.</p>
    }
}

@code {
    private static readonly CultureInfo Es = new("es-ES");

    private ModeloDashboard _m = default!;

    // La geometría se recalcula solo cuando cambia la serie (una nueva carga o un filtro), no en cada punto que se pinta.
    private GraficoLinea? _graficoCache;
    private IReadOnlyList<PuntoSerie>? _serieCache;

    /// <summary>Geometría del gráfico de evolución para la serie actual.</summary>
    private GraficoLinea _g
    {
        get
        {
            var serie = _m.RSerie!.Serie;
            if (!ReferenceEquals(serie, _serieCache))
            {
                _serieCache = serie;
                _graficoCache = new GraficoLinea(serie);
            }

            return _graficoCache!;
        }
    }

    protected override Task OnInitializedAsync()
    {
        _m = new ModeloDashboard(Api, () => DateOnly.FromDateTime(Reloj.GetLocalNow().DateTime));
        return _m.IniciarAsync();
    }

    private Task CargarAsync() => _m.CargarAsync();

    private void TeclaTramo(KeyboardEventArgs e, PuntoSerie p)
    {
        if (e.Key is "Enter" or " ") _m.ElegirTramo(p);
    }

    /// <summary>Etiqueta de texto del SVG; se construye a mano porque en Razor <c>&lt;text&gt;</c> es una etiqueta reservada.</summary>
    private static RenderFragment Etiqueta(string x, string y, string ancla, string texto) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "class", "gr-txt");
        builder.AddAttribute(2, "x", x);
        builder.AddAttribute(3, "y", y);
        builder.AddAttribute(4, "text-anchor", ancla);
        builder.AddContent(5, texto);
        builder.CloseElement();
    };
}

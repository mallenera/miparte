@* Chat del asistente (vive en el panel flotante PanelAsistente). Las respuestas llegan en vivo y se pintan siempre como texto (nunca como HTML). Puede proponer un gasto como borrador: no se guarda hasta que la persona lo confirma. La pregunta también se puede dictar: la nota de voz se transcribe y vuelve al cuadro para revisarla antes de enviarla. Con la foto de un ticket se propone un borrador editable; ni el audio ni la foto se guardan. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AsistenteApiClient Api
@inject CoreApiClient Core
@inject EstadoHogar Hogar
@inject ServicioSesion Sesion
@inject MiParte.Web.Configuracion.OpcionesWeb Opciones
@using System.Globalization
@using MiParte.Web.Modelos
@using Microsoft.AspNetCore.Components.Forms

<div class="asist">
    <p class="muted">Pregunta por los gastos del hogar; las cifras salen de tus datos. Puede preparar un gasto nuevo, pero nunca lo guarda sin que lo confirmes.</p>
    @if (_mensajes.Count > 0)
    {
        <button class="linkbtn" type="button" @onclick="Reiniciar" disabled="@_enviando">Nueva conversación</button>
    }
    @if (_alta is not null)
    {
        <button class="linkbtn" type="button" @onclick="CancelarAlta">Cancelar el gasto</button>
    }

    @if (!Disponible)
    {
        <div class="aviso warn u-mt12" role="status">
            El asistente no está configurado en esta instalación (falta <code>Api:AssistantUrl</code>).
        </div>
    }
    else
    {
        <div class="chat" role="log" aria-live="polite" aria-label="Conversación con el asistente">
            @if (_mensajes.Count == 0)
            {
                <div class="empty">
                    <Icono Nombre="message-circle" Tamano="28" />
                    <button class="btn btn-sm alta-gasto" type="button" disabled="@_enviando" @onclick="IniciarAlta">Añadir gasto</button>
                    <div>O prueba con una de estas preguntas</div>
                    <div class="sugerencias">
                        @foreach (var s in Sugerencias)
                        {
                            var pregunta = s;
                            <button class="btn btn-ghost btn-sm" type="button" disabled="@_enviando" @onclick="() => EnviarAsync(pregunta)">@pregunta</button>
                        }
                    </div>
                </div>
            }
            @foreach (var m in _mensajes)
            {
                <div class="@(m.EsMio ? "burbuja mia" : "burbuja")">
                    <span class="quien">@(m.EsMio ? "Tú" : "Asistente")</span>
                    <div class="texto">@m.Texto</div>
                    @if (m.Herramientas.Count > 0)
                    {
                        <div class="fuente muted">Consultado: @string.Join(", ", m.Herramientas.Select(NombreHerramienta))</div>
                    }
                    @if (m.Borrador is { } b)
                    {
                        <div class="borrador" role="group" aria-label="Gasto propuesto">
                            <strong>Gasto propuesto (sin guardar)</strong>
                            @if (m.Ticket is { } t && m.EstadoBorrador == EstadoBorrador.Pendiente)
                            {
                                @foreach (var aviso in t.Avisos)
                                {
                                    <div class="aviso warn u-mt12" role="status">@aviso</div>
                                }
                                <label class="u-mt12">Importe (€)
                                    <input type="text" inputmode="decimal" autocomplete="off" @bind="t.Importe" />
                                </label>
                                <label class="u-mt12">Concepto
                                    <input type="text" autocomplete="off" maxlength="@ModeloAltaGastoChat.MaxConcepto" @bind="t.Concepto" />
                                </label>
                                <label class="u-mt12">Fecha
                                    <input type="date" @bind="t.Fecha" />
                                </label>
                            }
                            else if (m.Ticket is { } leido)
                            {
                                <div>@leido.Concepto · @leido.Importe € · @leido.Fecha.ToString(ModeloAltaGastoChat.FormatoFecha, CultureInfo.InvariantCulture)</div>
                            }
                            else
                            {
                                <div>@b.Concepto · @Formato.Euros(b.Importe) · @b.Fecha.ToString(ModeloAltaGastoChat.FormatoFecha, CultureInfo.InvariantCulture)</div>
                            }
                            <div class="muted">Categoría: @b.Categoria · Perfil: @b.Perfil</div>
                            @if (m.EstadoBorrador == EstadoBorrador.Pendiente)
                            {
                                <label class="u-mt12">Quién paga
                                    <select @bind="m.Pagador">
                                        <option value="">Elige a quien paga</option>
                                        @foreach (var adulto in _adultos)
                                        {
                                            <option value="@adulto.Id">@adulto.Nombre</option>
                                        }
                                    </select>
                                </label>
                                <div class="actions u-mt12">
                                    <button class="btn btn-sm" type="button" disabled="@(_confirmando || string.IsNullOrEmpty(m.Pagador))" @onclick="() => ConfirmarAsync(m)">Confirmar</button>
                                    <button class="linkbtn" type="button" disabled="@_confirmando" @onclick="() => Descartar(m)">Descartar</button>
                                </div>
                            }
                            else if (m.EstadoBorrador == EstadoBorrador.Guardado)
                            {
                                <div class="ok u-mt12" role="status">Gasto guardado.</div>
                            }
                            else
                            {
                                <div class="muted u-mt12">Descartado: no se ha guardado.</div>
                            }
                            @if (m.Aviso is not null)
                            {
                                <div class="aviso err u-mt12" role="alert">@m.Aviso</div>
                            }
                        </div>
                    }
                </div>
            }
            @if (_enviando && (_enCurso is null || _enCurso.Texto.Length == 0))
            {
                <div class="burbuja" role="status">
                    <span class="quien">Asistente</span>
                    <div class="texto muted">Consultando tus datos…</div>
                </div>
            }
        </div>

        @if (_error is not null)
        {
            <div class="aviso err u-mt12" role="alert">@_error</div>
        }
        @if (_grabando)
        {
            <div class="muted u-mt12" role="status">Grabando… pulsa el botón de parar al terminar (máximo @MaxSegundosVoz s).</div>
        }
        else if (_transcribiendo)
        {
            <div class="muted u-mt12" role="status">Pasando la nota de voz a texto…</div>
        }
        else if (_dictado)
        {
            <div class="muted u-mt12" role="status">Revisa el texto dictado y pulsa Enviar.</div>
        }
        @if (_leyendoTicket)
        {
            <div class="muted u-mt12" role="status">Leyendo el ticket…</div>
        }

        <form class="chatform" @onsubmit="() => EnviarFormularioAsync()">
            <label class="sr" for="pregunta">Tu pregunta</label>
            <input id="pregunta" type="text" autocomplete="off" maxlength="@MaxCaracteres" placeholder="@(_alta is null ? "Escribe tu pregunta…" : "Escribe tu respuesta…")"
                   @bind="_texto" @bind:event="oninput" disabled="@(_enviando || _grabando || _transcribiendo || _leyendoTicket)" />
            @if (!Sesion.EsDemoLocal)
            {
                <button class="btn btn-ghost btn-voz" type="button" disabled="@(_enviando || _transcribiendo || _leyendoTicket)" @onclick="AlternarGrabacionAsync"
                        aria-pressed="@(_grabando ? "true" : "false")" aria-label="@(_grabando ? "Parar la grabación" : "Dictar por voz")" title="@(_grabando ? "Parar la grabación" : "Dictar por voz")">
                    <Icono Nombre="@(_grabando ? "square" : "mic")" Tamano="18" />
                </button>
                @* La etiqueta abre el selector; en el móvil, capture="environment" ofrece la cámara trasera. La foto no se guarda. *@
                <label class="@(Ocupado ? "btn btn-ghost btn-voz is-disabled" : "btn btn-ghost btn-voz")" title="Foto del ticket">
                    <Icono Nombre="camera" Tamano="18" />
                    <span class="sr">Foto del ticket</span>
                    <InputFile class="sr" accept="image/*" capture="environment" disabled="@Ocupado" OnChange="LeerTicketAsync" />
                </label>
            }
            <button class="btn" type="submit" disabled="@(_enviando || string.IsNullOrWhiteSpace(_texto))">Enviar</button>
        </form>
    }
</div>

@code {
    /// <summary>Tope del cuadro de texto; coincide con el límite por defecto de Assistant.Api.</summary>
    private const int MaxCaracteres = 1500;

    /// <summary>Mensajes del historial que se envían como contexto (los más recientes).</summary>
    private const int MaxHistorial = 20;

    /// <summary>Duración máxima de una nota de voz; el servidor limita además el tamaño (<c>Asistente__MaxAudioBytes</c>).</summary>
    private const int MaxSegundosVoz = 30;

    /// <summary>Lado mayor de la foto del ticket tras reducirla en el navegador: legible para el modelo y ligera de enviar.</summary>
    private const int LadoMaxFoto = 1600;

    /// <summary>Tamaño máximo de la foto que se envía; coincide con <c>Asistente__MaxImagenBytes</c> por defecto.</summary>
    private const long MaxBytesFoto = 4 * 1024 * 1024;

    private static readonly string[] Sugerencias =
    [
        "¿Cuánto hemos gastado este mes?",
        "¿En qué se nos fue el dinero el mes pasado?",
        "¿Quién debe a quién este mes?",
        "¿Gastamos más que el mes pasado?",
    ];

    /// <summary>Estado de un borrador de gasto en la conversación.</summary>
    private enum EstadoBorrador { Pendiente, Guardado, Descartado }

    /// <summary>Un mensaje de la conversación. El del asistente se va completando mientras llega el streaming.</summary>
    private sealed class Burbuja(bool esMio, string texto, IReadOnlyList<string> herramientas)
    {
        public bool EsMio { get; } = esMio;
        public string Texto { get; set; } = texto;
        public IReadOnlyList<string> Herramientas { get; set; } = herramientas;
        public BorradorGastoDto? Borrador { get; set; }
        public EstadoBorrador EstadoBorrador { get; set; } = EstadoBorrador.Pendiente;
        public string Pagador { get; set; } = "";
        public string? Aviso { get; set; }

        /// <summary>Borrador leído de un ticket, editable antes de confirmar; null en los borradores del chat.</summary>
        public ModeloBorradorTicket? Ticket { get; init; }

        /// <summary>Mensaje del alta guiada: no se envía al asistente en el historial, solo el gasto completo al terminar.</summary>
        public bool DeAlta { get; init; }
    }

    private readonly List<Burbuja> _mensajes = [];
    private List<MiembroDto> _adultos = [];
    private Burbuja? _enCurso;
    private string _texto = "";
    private string? _error;
    private bool _enviando;
    private bool _confirmando;
    private ModeloAltaGastoChat? _alta;
    private bool _grabando;
    private bool _transcribiendo;
    private bool _dictado;
    private DotNetObjectReference<VistaAsistente>? _referencia;
    private bool _leyendoTicket;

    /// <summary>Mientras se pregunta, se graba o se lee algo, no se puede empezar otra cosa.</summary>
    private bool Ocupado => _enviando || _grabando || _transcribiendo || _leyendoTicket;

    private bool Disponible => Opciones.AsistenteConfigurado || Sesion.EsDemoLocal;

    private static string NombreHerramienta(string nombre) => nombre switch
    {
        "gasto_total" => "gasto total",
        "gasto_por_categoria" => "gasto por categoría",
        "balance_mes" => "balance del mes",
        "liquidacion_mes" => "liquidación del mes",
        "comparar_meses" => "comparación de meses",
        "proponer_gasto" => "propuesta de gasto",
        _ => nombre,
    };

    private void Reiniciar()
    {
        _mensajes.Clear();
        _enCurso = null;
        _error = null;
        _texto = "";
        _alta = null;
    }

    /// <summary>Empieza el alta guiada: el asistente pregunta importe, concepto y fecha de uno en uno.</summary>
    private void IniciarAlta()
    {
        _error = null;
        _texto = "";
        _alta = new ModeloAltaGastoChat();
        _mensajes.Add(new Burbuja(false, _alta.Pregunta, []) { DeAlta = true });
    }

    private void CancelarAlta()
    {
        _alta = null;
        _texto = "";
        _mensajes.Add(new Burbuja(false, "Gasto cancelado. No se ha guardado nada.", []) { DeAlta = true });
    }

    /// <summary>Envía el formulario: una respuesta del alta guiada, o una pregunta normal al asistente.</summary>
    private async Task EnviarFormularioAsync()
    {
        if (_alta is null)
        {
            await EnviarAsync(_texto);
            return;
        }
        if (_enviando) return;
        var respuesta = _texto.Trim();
        if (respuesta.Length == 0) return;

        var usuario = new Burbuja(true, respuesta, []) { DeAlta = true };
        _mensajes.Add(usuario);
        _texto = "";
        var error = _alta.Responder(respuesta);
        if (error is not null)
        {
            _mensajes.Add(new Burbuja(false, error, []) { DeAlta = true });
            return;
        }
        if (_alta.PasoActual != ModeloAltaGastoChat.Paso.Completa)
        {
            _mensajes.Add(new Burbuja(false, _alta.Pregunta, []) { DeAlta = true });
            return;
        }

        // Al completarse, la última respuesta no se muestra: el mensaje que va al asistente lo resume entero.
        var mensaje = _alta.MensajeParaAsistente();
        _alta = null;
        _mensajes.Remove(usuario);
        await EnviarAsync(mensaje);
    }

    private async Task EnviarAsync(string? pregunta)
    {
        pregunta = pregunta?.Trim();
        if (_enviando || string.IsNullOrEmpty(pregunta)) return; // evita el doble envío
        _enviando = true;
        _dictado = false;
        _error = null;
        var usuario = new Burbuja(true, pregunta, []);
        _mensajes.Add(usuario);
        _texto = "";
        var historial = _mensajes
            .Where(m => !m.DeAlta)
            .TakeLast(MaxHistorial)
            .Select(m => new MensajeChatDto(m.EsMio ? "user" : "assistant", m.Texto))
            .ToList();
        var asistente = new Burbuja(false, "", []);
        try
        {
            ChatResponse respuesta;
            if (Sesion.EsDemoLocal)
            {
                // La demo no tiene streaming: respuesta fija de una vez.
                respuesta = await Api.PreguntarAsync(historial);
                asistente.Texto = respuesta.Respuesta;
            }
            else
            {
                _mensajes.Add(asistente);
                _enCurso = asistente;
                respuesta = await Api.PreguntarEnDirectoAsync(historial, async trozo =>
                {
                    asistente.Texto += trozo;
                    StateHasChanged(); // cada trozo se pinta según llega
                    await Task.CompletedTask;
                });
                asistente.Texto = respuesta.Respuesta; // la respuesta final manda sobre los trozos
            }

            asistente.Herramientas = respuesta.Herramientas;
            asistente.Borrador = respuesta.Borrador;
            if (!_mensajes.Contains(asistente)) _mensajes.Add(asistente);
            if (respuesta.Borrador is not null && _adultos.Count == 0) await CargarAdultosAsync();
        }
        catch (ApiException e)
        {
            // La pregunta no llegó a contestarse: se quitan sus burbujas y se devuelve al cuadro para reintentarla.
            _mensajes.Remove(asistente);
            _mensajes.Remove(usuario);
            _texto = pregunta;
            _error = e.Message;
        }
        finally
        {
            _enCurso = null;
            _enviando = false;
        }
    }

    private async Task CargarAdultosAsync()
    {
        try
        {
            _adultos = (await Core.ListarMiembrosAsync()).Where(m => m.Activo && m.Tipo == TiposMiembro.Adulto).OrderBy(m => m.Nombre).ToList();
        }
        catch (ApiException)
        {
            _adultos = []; // sin lista no se puede elegir quién paga: el botón de confirmar queda desactivado
        }
    }

    private async Task ConfirmarAsync(Burbuja m)
    {
        if (m.Borrador is not { } b || !Guid.TryParse(m.Pagador, out var pagador) || _confirmando) return;
        var peticion = new ConfirmarGastoRequest(b.Importe, b.Concepto, b.Fecha, pagador, b.CategoriaId, b.PerfilRepartoId, b.Categoria, b.Perfil);
        if (m.Ticket is { } ticket)
        {
            // Del ticket se confirma lo que la persona ha revisado en la tarjeta, no lo leído.
            if (ticket.Preparar(pagador, out var editada) is { } invalido)
            {
                m.Aviso = invalido;
                return;
            }
            peticion = editada!;
        }
        _confirmando = true;
        m.Aviso = null;
        try
        {
            await Api.ConfirmarGastoAsync(peticion);
            m.EstadoBorrador = EstadoBorrador.Guardado;
        }
        catch (ApiException e) when (e.Codigo == System.Net.HttpStatusCode.Conflict)
        {
            // Los predeterminados cambiaron: esta propuesta ya no vale y no se puede confirmar; hay que pedir el gasto de nuevo.
            m.EstadoBorrador = EstadoBorrador.Descartado;
            m.Aviso = e.Message;
        }
        catch (ApiException e)
        {
            m.Aviso = e.Message; // el borrador sigue pendiente para reintentarlo
        }
        finally
        {
            _confirmando = false;
        }
    }

    /// <summary>Empieza a grabar una nota de voz o, si ya se está grabando, la termina (y se transcribe).</summary>
    private async Task AlternarGrabacionAsync()
    {
        _error = null;
        if (_grabando)
        {
            await JS.InvokeVoidAsync("grabacionAudio.detener");
            return;
        }
        _referencia ??= DotNetObjectReference.Create(this);
        var fallo = await JS.InvokeAsync<string>("grabacionAudio.iniciar", _referencia, MaxSegundosVoz);
        if (string.IsNullOrEmpty(fallo))
        {
            _grabando = true;
            _dictado = false;
        }
        else
        {
            _error = fallo;
        }
    }

    /// <summary>
    /// Recibe la grabación terminada (a mano o por tiempo) y la pasa a texto. El texto no se envía solo: queda en el cuadro
    /// para que la persona lo corrija; la nota de voz no se guarda en ningún sitio.
    /// </summary>
    /// <param name="base64">Audio en base64.</param>
    /// <param name="tipo">Tipo MIME de la grabación.</param>
    [JSInvokable]
    public async Task AlTerminarGrabacion(string base64, string tipo)
    {
        _grabando = false;
        _transcribiendo = true;
        StateHasChanged();
        try
        {
            var r = await Api.TranscribirAsync(Convert.FromBase64String(base64), tipo);
            _texto = r.Texto;
            _dictado = true;
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
        catch (FormatException)
        {
            _error = "No se ha podido leer la grabación. Prueba otra vez.";
        }
        finally
        {
            _transcribiendo = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Lee la foto elegida: la reduce en el navegador (JPEG de <see cref="LadoMaxFoto"/> px) y la manda a leer. El resultado es
    /// un borrador editable en la conversación; nada se guarda hasta confirmar, y la foto no se conserva.
    /// </summary>
    private async Task LeerTicketAsync(InputFileChangeEventArgs e)
    {
        if (Ocupado) return;
        _error = null;
        _leyendoTicket = true;
        try
        {
            var foto = e.File;
            try
            {
                foto = await e.File.RequestImageFileAsync("image/jpeg", LadoMaxFoto, LadoMaxFoto);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Si el navegador no puede reducirla (formato que no decodifica), se envía tal cual: el servidor valida tipo y tamaño.
            }
            if (foto.Size > MaxBytesFoto)
            {
                _error = "La foto es demasiado grande. Prueba con otra de menor resolución.";
                return;
            }

            using var memoria = new MemoryStream();
            await using (var flujo = foto.OpenReadStream(MaxBytesFoto))
                await flujo.CopyToAsync(memoria);
            var lectura = await Api.LeerTicketAsync(memoria.ToArray(), string.IsNullOrEmpty(foto.ContentType) ? "image/jpeg" : foto.ContentType);
            // Va fuera del historial (DeAlta): el asistente no necesita ver la tarjeta, solo la persona.
            _mensajes.Add(new Burbuja(false, "He leído el ticket. Revisa los datos y elige quién paga antes de confirmar.", [])
            {
                DeAlta = true,
                Borrador = lectura.Borrador,
                Ticket = new ModeloBorradorTicket(lectura),
            });
            if (_adultos.Count == 0) await CargarAdultosAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (IOException)
        {
            _error = "No se ha podido leer la foto. Prueba otra vez.";
        }
        finally
        {
            _leyendoTicket = false;
        }
    }

    /// <summary>Si se cierra el panel con una grabación en curso, se descarta y se apaga el micrófono.</summary>
    public async ValueTask DisposeAsync()
    {
        if (_grabando)
        {
            try
            {
                await JS.InvokeVoidAsync("grabacionAudio.cancelar");
            }
            catch (JSDisconnectedException)
            {
                // La página ya se ha descargado: el navegador libera el micrófono solo.
            }
        }
        _referencia?.Dispose();
    }

    private void Descartar(Burbuja m)
    {
        m.EstadoBorrador = EstadoBorrador.Descartado;
        m.Aviso = null;
    }
}

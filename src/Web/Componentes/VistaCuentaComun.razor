@* Pestaña Cuenta común (hay que activarla por hogar): saldo y efectivo del mes, su parte por persona, aportaciones fijas por adulto (con su parte de ahorro), reembolsos a quien adelantó gastos de la cuenta y el ahorro (lo que se gasta de él se anota como gasto con el perfil de cuenta común (ahorro)). *@
@using System.Globalization
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos
@inject ServicioPermisos Permisos

<h1 class="sr">Cuenta común de @Hogar.HogarActual?.Nombre</h1>

@if (_m.Cargando)
{
    <div class="spinbox" role="status"><div class="spin"></div><span>Cargando la cuenta común…</span></div>
}
else if (_m.ErrorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_m.ErrorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (_m.Estado is not null && !_m.Estado.Activa)
{
    <section class="card" aria-labelledby="t-cuenta-inactiva">
        <div class="card-head"><h2 id="t-cuenta-inactiva">Cuenta común</h2><span class="tag off">Sin activar</span></div>
        <p class="muted">
            La cuenta común es un fondo del hogar al que cada adulto aporta una cantidad fija al mes. Con ella puedes pagar gastos
            sin repartirlos entre personas, reembolsar a quien adelanta dinero y apartar un ahorro. Este hogar todavía no la usa.
        </p>
        @if (SoyAdmin)
        {
            <a class="btn u-mt12" href="hogar/configuracion">Habilitarla en la configuración del hogar</a>
        }
        else
        {
            <div class="aviso warn u-mt12" role="status">No tienes permiso para activarla: pídeselo a un administrador del hogar.</div>
        }
    </section>
}
else if (_m.Estado is not null)
{
    <section class="card" aria-labelledby="t-cuenta">
        <div class="card-head">
            <h2 id="t-cuenta">Cuenta común</h2>
            <div class="mesnav">
                <button class="linkbtn" type="button" aria-label="Mes anterior" @onclick="() => _m.CambiarMesAsync(-1)"><Icono Nombre="chevron-left" /></button>
                <span class="tag cur" aria-live="polite">@_m.NombreMes</span>
                <button class="linkbtn" type="button" aria-label="Mes siguiente" @onclick="() => _m.CambiarMesAsync(1)"><Icono Nombre="chevron-right" /></button>
            </div>
        </div>
        <p class="muted">Saldo acumulado hasta final de mes: aportaciones para gastos (sin el ahorro) menos los gastos cargados a la cuenta.</p>

        @if (_m.Error is not null)
        {
            <div class="aviso err u-mt12" role="alert">@_m.Error</div>
        }

        <div class="u-fila-mt10">
            <span class="chip">Saldo&nbsp;<b id="saldo">@Formato.Euros(_m.Estado.Saldo)</b></span>
            <span class="chip">Efectivo&nbsp;<b>@Formato.Euros(_m.Estado.Efectivo)</b></span>
            <span class="chip">Aportado este mes&nbsp;<b>@Formato.Euros(_m.Estado.AportadoMes)</b></span>
            <span class="chip">Aportado en total&nbsp;<b>@Formato.Euros(_m.Estado.Aportado)</b></span>
            <span class="chip">Gastado en total&nbsp;<b>@Formato.Euros(_m.Estado.Gastado)</b></span>
            @if (_m.Estado.AhorroActivo || _m.Estado.AhorroGastado != 0)
            {
                <span class="chip">Gastado del ahorro&nbsp;<b>@Formato.Euros(_m.Estado.AhorroGastado)</b></span>
            }
            @if (_m.Estado.AhorroActivo)
            {
                <span class="chip">Ahorro disponible&nbsp;<b id="ahorro">@Formato.Euros(_m.Estado.AhorroDisponible)</b></span>
            }
        </div>

        @if (_m.Estado.Saldo < 0)
        {
            <div class="aviso warn u-mt12" role="status">
                La cuenta no cubre los gastos: faltan @Formato.Euros(-_m.Estado.Saldo) para cubrirlos.
            </div>
        }
    </section>

    @if (_m.Estado.Resumen is { } res)
    {
        <section class="card" aria-labelledby="t-resumen">
            <div class="card-head"><h2 id="t-resumen">Resumen de @_m.NombreMes</h2></div>
            <p class="muted">Inicial es lo que quedó el mes anterior; el resto, solo de este mes. Lo que queda pasa al mes siguiente.</p>
            <div class="tabla-scroll">
                <table class="resumen-cuenta" id="resumen-cuenta">
                    <thead>
                        <tr>
                            <th scope="col"><span class="sr">Cuenta</span></th>
                            <th scope="col">Inicial</th>
                            <th scope="col">Ingresos</th>
                            <th scope="col">Ingresos sueltos</th>
                            <th scope="col">Gastos</th>
                            <th scope="col">Reembolsos</th>
                            <th scope="col">Disponible</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (nombre, fila, clase) in new[] { ("Hogar", res.Hogar, ""), ("Ahorro", res.Ahorro, ""), ("Total", res.Total, "total") })
                        {
                            <tr class="@clase">
                                <th scope="row">@nombre</th>
                                <td>@Formato.Euros(fila.Inicial)</td>
                                <td>@Formato.Euros(fila.Ingresos)</td>
                                <td>@Formato.Euros(fila.IngresosSueltos)</td>
                                <td>@Formato.Euros(fila.Gastos)</td>
                                <td>@Formato.Euros(fila.Reembolsos)</td>
                                <td><b>@Formato.Euros(fila.Disponible)</b></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (_m.Estado.Extracto is { } x)
    {
        <section class="card" aria-labelledby="t-extracto">
            <div class="card-head"><h2 id="t-extracto">Extracto de @_m.NombreMes</h2></div>
            <p class="muted">Cómo cambia el efectivo de la cuenta este mes, como un extracto del banco. El ahorro va aparte.</p>
            <table class="extracto" id="extracto">
                <tbody>
                    <tr><th scope="row">Efectivo al inicio del mes</th><td>@Formato.Euros(x.EfectivoInicial)</td></tr>
                    <tr><th scope="row">+ Aportaciones para gastos</th><td>@Formato.Euros(x.Aportaciones)</td></tr>
                    @if (x.SaldoInicialFijado != 0)
                    {
                        <tr><th scope="row">+ Saldo inicial fijado</th><td>@Formato.Euros(x.SaldoInicialFijado)</td></tr>
                    }
                    @if (x.Ingresos != 0)
                    {
                        <tr><th scope="row">+ Ingresos sueltos</th><td>@Formato.Euros(x.Ingresos)</td></tr>
                    }
                    <tr><th scope="row">− Gastos pagados por la cuenta</th><td>@Formato.Euros(x.GastosCuenta)</td></tr>
                    @if (x.GastosAdelantadosDelAhorro != 0)
                    {
                        <tr><th scope="row">+ Gastos del ahorro adelantados por un miembro</th><td>@Formato.Euros(x.GastosAdelantadosDelAhorro)</td></tr>
                    }
                    <tr><th scope="row">− Reembolsos a quien adelantó gastos</th><td>@Formato.Euros(x.Reembolsos)</td></tr>
                </tbody>
                <tfoot>
                    <tr class="total"><th scope="row">Efectivo al final del mes</th><td id="efectivo-final">@Formato.Euros(x.EfectivoFinal)</td></tr>
                </tfoot>
            </table>
        </section>
    }

    <PanelMovimientosCuenta />

    <section class="card" aria-labelledby="t-saldo-inicial">
        <div class="card-head"><h2 id="t-saldo-inicial">Saldo inicial</h2></div>
        <p class="muted">
            Dinero que había en la cuenta para gastos a una fecha, por ejemplo el saldo del banco al empezar a usar la app.
            Los meses anteriores a esa fecha no lo cuentan.
        </p>
        @if (_m.Estado.SaldoInicial is { } si)
        {
            <div class="u-fila-mt10">
                <span class="chip">A fecha del&nbsp;<b>@si.Fecha.ToString("dd/MM/yyyy", Es)</b>&nbsp;había&nbsp;<b>@Formato.Euros(si.Importe)</b></span>
            </div>
        }
        else
        {
            <div class="empty">Todavía no has fijado un saldo inicial.</div>
        }

        @if (PuedeCuenta)
        {
            <form class="addcat" id="form-saldo-inicial" @onsubmit="FijarSaldoInicialAsync">
                <label>Fecha
                    <input type="date" required @bind="_m.FechaSaldoInicial" />
                </label>
                <label>Importe (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_m.ImporteSaldoInicial" @bind:event="oninput" />
                </label>
                <button class="btn" type="submit" disabled="@(!_m.SaldoInicialValido || _m.Enviando)">Guardar saldo inicial</button>
                @if (_m.Estado.SaldoInicial is not null)
                {
                    <button class="linkbtn danger" type="button" disabled="@_m.Enviando" @onclick="QuitarSaldoInicialAsync">Quitar saldo inicial</button>
                }
            </form>
        }
    </section>

    <section class="card" aria-labelledby="t-partes">
        <div class="card-head"><h2 id="t-partes">Su parte</h2></div>
        <p class="muted">Lo que ha puesto cada persona y la porción que le corresponde del saldo (en proporción a lo aportado para gastos) @(_m.Estado.AhorroActivo ? "y del ahorro (en proporción a lo ahorrado)." : "")</p>
        @foreach (var p in _m.Estado.Partes ?? [])
        {
            <div class="catrow parte">
                <div class="c-name"><Avatar Nombre="@p.Nombre" Color="@ColorMiembro.De(p.MiembroId, _m.Miembros)" Tamano="sm" /> @p.Nombre</div>
                <div class="c-sel">
                    <span class="chip">Ha puesto&nbsp;<b>@Formato.Euros(p.Aportado)</b>&nbsp;para gastos (@ModeloCuentaComun.Porcentaje(p.PorcentajeGastos))</span>
                    @if (_m.Estado.AhorroActivo)
                    {
                        <span class="chip">Ahorro&nbsp;<b>@Formato.Euros(p.Ahorrado)</b>&nbsp;(@ModeloCuentaComun.Porcentaje(p.PorcentajeAhorro))</span>
                    }
                    <span class="chip">Su parte del saldo&nbsp;<b>@Formato.Euros(p.ParteSaldo)</b></span>
                    @if (_m.Estado.AhorroActivo)
                    {
                        <span class="chip">Su parte del ahorro&nbsp;<b>@Formato.Euros(p.ParteAhorro)</b></span>
                    }
                    @if (p.Pendiente > 0)
                    {
                        <span class="chip">La cuenta le debe&nbsp;<b>@Formato.Euros(p.Pendiente)</b></span>
                    }
                </div>
            </div>
        }
        @if ((_m.Estado.Partes ?? []).Count == 0)
        {
            <div class="empty">Todavía nadie ha aportado a la cuenta.</div>
        }
    </section>

    <section class="card" aria-labelledby="t-aportaciones">
        <div class="card-head"><h2 id="t-aportaciones">Aportación mensual</h2></div>
        <p class="muted">Importe fijo que aporta cada adulto al mes@(_m.Estado.AhorroActivo ? "; una parte puede ir a ahorro y el resto queda para gastos" : ""). Un cambio vale desde el mes elegido en adelante.</p>
        <div class="u-mt10">
            @foreach (var a in _m.Adultos)
            {
                <div class="catrow">
                    <div class="c-name"><Avatar Nombre="@a.Nombre" Color="@ColorMiembro.De(a.Id, _m.Miembros)" Tamano="sm" /> @a.Nombre</div>
                    <div class="c-sel">@Formato.Euros(_m.VigenteDe(a.Id)) al mes@(_m.AhorroVigenteDe(a.Id) > 0 ? $" ({Formato.Euros(_m.AhorroVigenteDe(a.Id))} de ahorro)" : "")</div>
                </div>
            }
            @if (_m.Adultos.Count == 0)
            {
                <div class="empty">El hogar no tiene adultos activos.</div>
            }
        </div>

        @if (_m.Adultos.Count > 0 && PuedeCuenta)
        {
            <form class="addcat" id="form-aportacion" @onsubmit="FijarAportacionAsync">
                <label>Adulto
                    <select @bind="_m.Aportante" @bind:after="_m.AlCambiarAportante">
                        @foreach (var a in _m.Adultos)
                        {
                            <option value="@a.Id">@a.Nombre</option>
                        }
                    </select>
                </label>
                <label>Importe al mes (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_m.ImporteAportacion" @bind:event="oninput" />
                </label>
                @if (_m.Estado.AhorroActivo)
                {
                    <label>De ese importe, a ahorro (€)
                        <input id="ahorro-aportacion" inputmode="decimal" placeholder="0,00" @bind="_m.AhorroAportacion" @bind:event="oninput" />
                    </label>
                }
                <button class="btn" type="submit" disabled="@(!_m.AportacionValida || _m.Enviando)">Fijar desde @_m.NombreMes</button>
            </form>
        }
    </section>

    <section class="card" aria-labelledby="t-reembolsos">
        <div class="card-head"><h2 id="t-reembolsos">Reembolsos</h2></div>
        <p class="muted">Cuando una persona adelanta un gasto de la cuenta, esta le debe ese importe hasta reembolsárselo.</p>

        @if (_m.Estado.Pendientes.Count == 0)
        {
            <div class="empty">No hay reembolsos pendientes.</div>
        }
        @foreach (var p in _m.Estado.Pendientes)
        {
            <div class="catrow">
                <div class="c-name">@p.Nombre</div>
                <div class="c-sel">La cuenta le debe @Formato.Euros(p.Importe)</div>
            </div>
        }

        @foreach (var r in _m.Estado.Reembolsos.OrderByDescending(r => r.Fecha))
        {
            <div class="gastorow">
                <div class="g-main">
                    <div class="g-concepto">Reembolso a @Formato.NombreMiembro(r.MiembroId, _m.Miembros)</div>
                    <div class="muted g-meta">@r.Fecha.ToString("dd/MM/yyyy", Es)@(string.IsNullOrWhiteSpace(r.Concepto) ? "" : " · " + r.Concepto)</div>
                </div>
                <div class="g-importe">@Formato.Euros(r.Importe)</div>
                <div class="c-acc">
                    @if (_m.ConfirmandoEliminar == r.Id)
                    {
                        <span class="muted">¿Eliminar?</span>
                        <button class="linkbtn danger" type="button" @onclick="() => EliminarAsync(r)">Sí</button>
                        <button class="linkbtn" type="button" @onclick="() => _m.ConfirmandoEliminar = null">No</button>
                    }
                    else
                    {
                        <button class="linkbtn danger" type="button" aria-label="Eliminar reembolso a @Formato.NombreMiembro(r.MiembroId, _m.Miembros)" @onclick="() => _m.ConfirmandoEliminar = r.Id">Eliminar</button>
                    }
                </div>
            </div>
        }

        @if (_m.Estado.Pendientes.Count > 0 && PuedeCuenta)
        {
            <form class="addcat" id="form-reembolso" @onsubmit="ReembolsarAsync">
                <h3 class="u-titulo-form">Nuevo reembolso</h3>
                <label>A
                    <select @bind="_m.Reembolsado">
                        @foreach (var p in _m.Estado.Pendientes)
                        {
                            <option value="@p.MiembroId">@p.Nombre</option>
                        }
                    </select>
                </label>
                <label>Importe (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_m.ImporteReembolso" @bind:event="oninput" />
                </label>
                <label>Concepto
                    <input maxlength="200" placeholder="Opcional" @bind="_m.ConceptoReembolso" @bind:event="oninput" />
                </label>
                <button class="btn" type="submit" disabled="@(!_m.ReembolsoValido || _m.Enviando)">Reembolsar</button>
            </form>
        }
    </section>

    <section class="card" aria-labelledby="t-ingresos">
        <div class="card-head"><h2 id="t-ingresos">Ingresos</h2></div>
        <p class="muted">Dinero que entra a la cuenta común fuera de las aportaciones y del ahorro, por ejemplo lo que pagan las amigas de una cena. Suma al saldo y al efectivo de la cuenta; no cambia los reembolsos.</p>

        @if (_m.IngresosDelMes.Count == 0)
        {
            <div class="empty">No hay ingresos este mes.</div>
        }

        @foreach (var i in _m.IngresosDelMes)
        {
            <div class="gastorow">
                <div class="g-main">
                    <div class="g-concepto">@(string.IsNullOrWhiteSpace(i.Concepto) ? "Ingreso" : i.Concepto)</div>
                    <div class="muted g-meta">@i.Fecha.ToString("dd/MM/yyyy", Es) · ingresó @Formato.NombreMiembro(i.MiembroId, _m.Miembros)</div>
                </div>
                <div class="g-importe">@Formato.Euros(i.Importe)</div>
                @if (PuedeCuenta)
                {
                    <div class="c-acc">
                        @if (_m.ConfirmandoEliminar == i.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarIngresoAsync(i)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.ConfirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="linkbtn danger" type="button" aria-label="Eliminar ingreso de @Formato.NombreMiembro(i.MiembroId, _m.Miembros)" @onclick="() => _m.ConfirmandoEliminar = i.Id">Eliminar</button>
                        }
                    </div>
                }
            </div>
        }

        @if (_m.IngresosDelMes.Count > 0)
        {
            <div class="muted g-meta">Total ingresado este mes: @Formato.Euros(_m.TotalIngresosDelMes)</div>
        }

        @if (PuedeCuenta)
        {
            <form class="addcat" id="form-ingreso-cuenta" @onsubmit="IngresarAsync">
                <h3 class="u-titulo-form">Nuevo ingreso</h3>
                <label>Lo ingresa
                    <select @bind="_m.Ingresante">
                        @foreach (var miembro in _m.Miembros.Where(x => x.Activo))
                        {
                            <option value="@miembro.Id">@miembro.Nombre</option>
                        }
                    </select>
                </label>
                <label>Importe (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_m.ImporteIngreso" @bind:event="oninput" />
                </label>
                <label>Concepto
                    <input maxlength="200" placeholder="Por ejemplo, Cena amigas" @bind="_m.ConceptoIngreso" @bind:event="oninput" />
                </label>
                <button class="btn" type="submit" disabled="@(!_m.IngresoValido || _m.Enviando)">Ingresar</button>
            </form>
        }
    </section>

    @if (_m.Estado.AhorroActivo)
    {
        <section class="card" aria-labelledby="t-ahorro">
            <div class="card-head"><h2 id="t-ahorro">Ahorro</h2></div>
            <p class="muted">Suma la parte de las aportaciones que se aparta y lo que ingreses aparte (ahorro inicial, lotería…). Los gastos de la cuenta no la tocan: solo baja con los gastos de la cuenta común (ahorro), que se anotan en la pestaña Gastos.</p>
            <div class="u-fila-mt10">
                <span class="chip">Ahorrado este mes&nbsp;<b>@Formato.Euros(_m.Estado.AhorroMes)</b></span>
                <span class="chip">Ahorrado en total&nbsp;<b>@Formato.Euros(_m.Estado.AhorroAcumulado)</b></span>
                <span class="chip">Ingresado aparte&nbsp;<b>@Formato.Euros(_m.Estado.AhorroDepositado)</b></span>
                <span class="chip">Gastado del ahorro&nbsp;<b>@Formato.Euros(_m.Estado.AhorroGastado)</b></span>
            </div>

            @if (_m.Estado.AhorroDisponible < 0)
            {
                <div class="aviso warn u-mt12" role="status">
                    Se ha gastado más de lo ahorrado: faltan @Formato.Euros(-_m.Estado.AhorroDisponible) (revisa las aportaciones o los gastos del ahorro).
                </div>
            }

            @foreach (var d in (_m.Estado.DepositosAhorro ?? []).OrderByDescending(d => d.Fecha))
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">Ingreso de @Formato.NombreMiembro(d.MiembroId, _m.Miembros)</div>
                        <div class="muted g-meta">@d.Fecha.ToString("dd/MM/yyyy", Es)@(string.IsNullOrWhiteSpace(d.Concepto) ? "" : " · " + d.Concepto)</div>
                    </div>
                    <div class="g-importe">@Formato.Euros(d.Importe)</div>
                    <div class="c-acc">
                        @if (_m.ConfirmandoEliminar == d.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarDepositoAsync(d)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.ConfirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="linkbtn danger" type="button" aria-label="Eliminar ingreso de @Formato.NombreMiembro(d.MiembroId, _m.Miembros)" @onclick="() => _m.ConfirmandoEliminar = d.Id">Eliminar</button>
                        }
                    </div>
                </div>
            }

            @if (_m.Adultos.Count > 0 && PuedeAhorro)
            {
                <form class="addcat" id="form-deposito" @onsubmit="IngresarAhorroAsync">
                    <h3 class="u-titulo-form">Añadir al ahorro</h3>
                    <label>Lo ingresa
                        <select @bind="_m.Depositante">
                            @foreach (var a in _m.Adultos)
                            {
                                <option value="@a.Id">@a.Nombre</option>
                            }
                        </select>
                    </label>
                    <label>Importe (€)
                        <input inputmode="decimal" required placeholder="0,00" @bind="_m.ImporteDeposito" @bind:event="oninput" />
                    </label>
                    <label>Concepto
                        <input maxlength="200" placeholder="Ahorro inicial, lotería…" @bind="_m.ConceptoDeposito" @bind:event="oninput" />
                    </label>
                    <button class="btn" type="submit" disabled="@(!_m.DepositoValido || _m.Enviando)">Añadir</button>
                </form>
            }

            <a class="linkbtn u-mt8-inline" href="gastos">Anotar un gasto del ahorro</a>
        </section>
    }
}

@code {
    private static readonly CultureInfo Es = new("es-ES");

    private ModeloCuentaComun _m = default!;

    /// <summary>Si el usuario es admin del hogar: solo él activa o desactiva la cuenta común.</summary>
    private bool SoyAdmin => Permisos.Tiene(Claves.HogarFunciones);

    private bool PuedeCuenta => Permisos.Tiene(Claves.CuentaMovimientos);

    private bool PuedeAhorro => Permisos.Tiene(Claves.AhorroMovimientos);

    protected override Task OnInitializedAsync()
    {
        _m = new ModeloCuentaComun(Api, DateOnly.FromDateTime(DateTime.Today));
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        _m.IniciarCarga();
        await Permisos.AsegurarAsync();
        await _m.CargarAsync();
    }

    private Task FijarAportacionAsync() => Mostrar(_m.FijarAportacionAsync());

    private Task ReembolsarAsync() => Mostrar(_m.ReembolsarAsync());

    private Task IngresarAhorroAsync() => Mostrar(_m.IngresarAhorroAsync());

    private Task FijarSaldoInicialAsync() => Mostrar(_m.FijarSaldoInicialAsync());

    private Task QuitarSaldoInicialAsync() => Mostrar(_m.EliminarSaldoInicialAsync());

    private Task EliminarDepositoAsync(DepositoAhorroDto d) => Mostrar(_m.EliminarDepositoAsync(d));

    private Task EliminarAsync(ReembolsoCuentaDto r) => Mostrar(_m.EliminarAsync(r));

    private Task IngresarAsync() => Mostrar(_m.IngresarAsync());

    private Task EliminarIngresoAsync(IngresoCuentaComunDto i) => Mostrar(_m.EliminarIngresoAsync(i));

    /// <summary>Espera la operación del modelo y, si salió bien, muestra su aviso.</summary>
    private async Task Mostrar(Task<string?> operacion)
    {
        if (await operacion is { } aviso) Avisos.Mostrar(aviso);
    }
}

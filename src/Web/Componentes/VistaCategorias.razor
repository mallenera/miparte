@* Pestaña Categorías: árbol de categorías del hogar con su perfil de reparto por defecto. *@
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos
@inject ServicioPermisos Permisos

<h1 class="sr">Categorías de @Hogar.HogarActual?.Nombre</h1>

@if (_m.Cargando)
{
    <EsqueletoLista Texto="Cargando categorías…" Filas="4" />
}
else if (_m.ErrorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_m.ErrorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else
{
    <section class="card" aria-labelledby="t-categorias">
        <div class="card-head">
            <h2 id="t-categorias">Categorías de @Hogar.HogarActual?.Nombre</h2>
            <span class="tag">@_m.Categorias.Count @(_m.Categorias.Count == 1 ? "categoría" : "categorías")</span>
        </div>
        <p class="muted">El perfil por defecto decide cómo se reparte un gasto de esa categoría. Si la marcas «a cargo de la cuenta común», sus gastos la usan por defecto (sin reparto entre personas); hace falta tener la cuenta común activada. Con el perfil «Cuenta común (ahorro)» sus gastos salen del ahorro, no del saldo de gastos. Las subcategorías cuelgan de otra categoría.</p>

        @if (_m.Error is not null)
        {
            <div class="aviso err u-mt12" role="alert">@_m.Error</div>
        }

        <div class="u-mt10 catlista">
            @foreach (var nodo in _m.Arbol)
            {
                var c = nodo.Categoria;
                <div class="catrow cat">
                    <div class="c-name @(nodo.Nivel > 0 ? "sub" : "")">@c.Nombre</div>
                    <div class="c-sel">
                        @_m.NombrePerfil(c.PerfilRepartoId)
                        @if (c.PredeterminadoGastos)
                        {
                            <span class="tag">Predeterminada para gastos</span>
                        }
                        @if (c.ACargoCuentaComun)
                        {
                            <span class="tag cur">@(_m.DelAhorro(c) ? "A cargo de la cuenta común (ahorro)" : "A cargo de la cuenta común")</span>
                        }
                    </div>
                    <div class="c-acc">
                        @if (_m.ConfirmandoEliminar == c.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarAsync(c)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.ConfirmandoEliminar = null">No</button>
                        }
                        else if (Permisos.Tiene(Claves.CategoriasGestionar))
                        {
                            <button class="linkbtn" type="button" aria-label="Añadir subcategoría a @c.Nombre" @onclick="() => _m.NuevaSubcategoria(c)">Subcategoría</button>
                            <button class="linkbtn" type="button" aria-label="Editar @c.Nombre" @onclick="() => _m.EmpezarEdicion(c)">Editar</button>
                            <button class="linkbtn danger" type="button" aria-label="Eliminar @c.Nombre" @onclick="() => _m.ConfirmandoEliminar = c.Id">Eliminar</button>
                        }
                    </div>
                    @if (_m.Moviendo == c.Id)
                    {
                        <form class="editcat" id="mover-categoria" @onsubmit="() => MoverYEliminarAsync(c)">
                            <p class="muted">«@c.Nombre» tiene gastos o plantillas recurrentes. ¿A qué categoría los movemos antes de eliminarla?</p>
                            <label>Mover a
                                <select @bind="_m.Destino">
                                    <option value="">Elige una categoría</option>
                                    @foreach (var otra in _m.Arbol.Where(n => n.Categoria.Id != c.Id))
                                    {
                                        <option value="@otra.Categoria.Id">@(new string(' ', otra.Nivel * 3))@otra.Categoria.Nombre</option>
                                    }
                                </select>
                            </label>
                            <button class="btn btn-sm" type="submit" disabled="@string.IsNullOrEmpty(_m.Destino)">Mover y eliminar</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.Moviendo = null">Cancelar</button>
                        </form>
                    }
                    @if (_m.Editando == c.Id)
                    {
                        <form class="editcat" @onsubmit="() => GuardarEdicionAsync(c)">
                            <label>Nombre
                                <input maxlength="100" @bind="_m.Nombre" @bind:event="oninput" />
                            </label>
                            <label>Cuelga de
                                <select @bind="_m.Padre">
                                    <option value="">Ninguna (primer nivel)</option>
                                    @foreach (var otra in _m.PadresPosibles(c.Id))
                                    {
                                        <option value="@otra.Categoria.Id">@(new string(' ', otra.Nivel * 3))@otra.Categoria.Nombre</option>
                                    }
                                </select>
                            </label>
                            <label>Perfil por defecto
                                <select @bind="_m.Perfil">
                                    <option value="">Sin perfil</option>
                                    @foreach (var p in _m.Perfiles)
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                </select>
                            </label>
                            <label class="chk">
                                <input type="checkbox" @bind="_m.ACargo" />
                                A cargo de la cuenta común
                            </label>
                            <label class="chk">
                                <input type="checkbox" @bind="_m.Predeterminado" />
                                Predeterminada para gastos
                            </label>
                            <button class="btn btn-sm" type="submit" disabled="@string.IsNullOrWhiteSpace(_m.Nombre)">Guardar</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.Editando = null">Cancelar</button>
                        </form>
                    }
                </div>
            }

            @if (_m.Categorias.Count == 0)
            {
                <div class="empty">Todavía no hay categorías. Añade la primera abajo.</div>
            }
        </div>

        @if (!Permisos.Tiene(Claves.CategoriasGestionar))
        {
            <div class="aviso warn u-mt14" role="status">No tienes permiso para gestionar categorías. Pídeselo a un administrador del hogar.</div>
        }
        else
        {
        <form class="addcat" id="nueva-categoria" @onsubmit="AnadirAsync">
            <label>@(string.IsNullOrEmpty(_m.NuevoPadre) ? "Nueva categoría" : "Nueva subcategoría")
                <input maxlength="100" placeholder="Nombre" @bind="_m.NuevoNombre" @bind:event="oninput" />
            </label>
            <label>Cuelga de
                <select @bind="_m.NuevoPadre">
                    <option value="">Ninguna (primer nivel)</option>
                    @foreach (var n in _m.Arbol)
                    {
                        <option value="@n.Categoria.Id">@(new string(' ', n.Nivel * 3))@n.Categoria.Nombre</option>
                    }
                </select>
            </label>
            <label>Perfil por defecto
                <select @bind="_m.NuevoPerfil">
                    <option value="">Sin perfil</option>
                    @foreach (var p in _m.Perfiles)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </label>
            <label class="chk">
                <input type="checkbox" @bind="_m.NuevoACargo" />
                A cargo de la cuenta común
            </label>
            <label class="chk">
                <input type="checkbox" @bind="_m.NuevoPredeterminado" />
                Predeterminada para gastos
            </label>
            <button class="btn" type="submit" disabled="@string.IsNullOrWhiteSpace(_m.NuevoNombre)">Añadir</button>
        </form>
        }
    </section>
}

@code {
    private ModeloCategorias _m = default!;

    protected override Task OnInitializedAsync()
    {
        _m = new ModeloCategorias(Api);
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        _m.IniciarCarga();
        await Permisos.AsegurarAsync();
        await _m.CargarAsync();
    }

    private Task GuardarEdicionAsync(CategoriaDto c) => Mostrar(_m.GuardarEdicionAsync(c));

    private Task EliminarAsync(CategoriaDto c) => Mostrar(_m.EliminarAsync(c));

    private Task MoverYEliminarAsync(CategoriaDto c) => Mostrar(_m.MoverYEliminarAsync(c));

    private Task AnadirAsync() => Mostrar(_m.AnadirAsync());

    /// <summary>Espera la operación del modelo y, si salió bien, muestra su aviso.</summary>
    private async Task Mostrar(Task<string?> operacion)
    {
        if (await operacion is { } aviso) Avisos.Mostrar(aviso);
    }
}

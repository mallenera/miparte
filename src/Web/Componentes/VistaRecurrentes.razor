@* Pestaña Recurrentes: plantillas de gasto mensual (alta, edición, activar/desactivar, borrado) y generación de los gastos de un mes. *@
@using System.Globalization
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos
@inject TimeProvider Reloj
@inject ServicioPermisos Permisos

<h1 class="sr">Gastos recurrentes de @Hogar.HogarActual?.Nombre</h1>

@if (_m.Cargando)
{
    <EsqueletoLista Texto="Cargando gastos recurrentes…" Filas="4" />
}
else if (_m.ErrorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_m.ErrorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else
{
    <section class="card" aria-labelledby="t-generar">
        <div class="card-head">
            <h2 id="t-generar">Generar gastos del mes</h2>
            <div class="mesnav">
                <button class="linkbtn" type="button" aria-label="Mes anterior" @onclick="() => _m.CambiarMes(-1)"><Icono Nombre="chevron-left" /></button>
                <span class="tag cur" aria-live="polite">@_m.NombreMes</span>
                <button class="linkbtn" type="button" aria-label="Mes siguiente" @onclick="() => _m.CambiarMes(1)"><Icono Nombre="chevron-right" /></button>
            </div>
        </div>
        <p class="muted">Crea el gasto de cada plantilla activa que aún no lo tenga en el mes. Se puede repetir sin duplicar gastos.</p>
        <div class="actions u-mt10">
            <button class="btn" id="generar" type="button" disabled="@(_m.Generando || !Permisos.Tiene(Claves.RecurrentesGestionar) || _m.Plantillas.All(p => !p.Activo))" @onclick="GenerarAsync">Generar gastos de @_m.NombreMes</button>
        </div>
        @if (_m.Resultado is not null)
        {
            <div class="aviso ok u-mt12" role="status">@_m.Resultado</div>
        }
    </section>

    <section class="card" aria-labelledby="t-plantillas">
        <div class="card-head"><h2 id="t-plantillas">Plantillas</h2></div>
        <p class="muted">Un gasto que se repite cada mes (alquiler, suscripciones…). Editar una plantilla no cambia los gastos ya generados.</p>

        @if (_m.Error is not null)
        {
            <div class="aviso err u-mt12" role="alert">@_m.Error</div>
        }

        @if (_m.DiaPasado is { } dp)
        {
            <div class="aviso warn u-mt12" role="status" id="aviso-dia-pasado">
                El día @dp.Dia de este mes @(dp.Dia == _m.DiaHoy ? "es hoy" : "ya ha pasado"), así que «@dp.Nombre» no se ha creado como gasto de @_m.NombreMesActual.
                ¿Quieres crearlo ahora?
                <button class="linkbtn" type="button" id="crear-gasto-pasado" disabled="@_m.Generando" @onclick="GenerarMesActualAsync">Crear gasto de @_m.NombreMesActual</button>
                <button class="linkbtn" type="button" @onclick="() => _m.DiaPasado = null">Ahora no</button>
            </div>
        }

        <div class="u-mt10">
            @foreach (var p in _m.Plantillas)
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">@(string.IsNullOrWhiteSpace(p.Concepto) ? _m.NombreCategoria(p.CategoriaId) : p.Concepto)</div>
                        <div class="muted g-meta">
                            Día @p.DiaMes · @_m.NombreCategoria(p.CategoriaId) · paga @Formato.NombreMiembro(p.PagadoPor, _m.Miembros) · @_m.NombrePerfil(p.PerfilRepartoId)
                            @if (!p.Activo) { <span class="tag off">pausada</span> }
                        </div>
                    </div>
                    <div class="g-importe">@Formato.Euros(p.Importe)</div>
                    <div class="c-acc">
                        @if (_m.ConfirmandoEliminar == p.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" disabled="@_m.Guardando" @onclick="() => EliminarAsync(p)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.ConfirmandoEliminar = null">No</button>
                        }
                        else if (Permisos.Tiene(Claves.RecurrentesGestionar))
                        {
                            <button class="linkbtn" type="button" aria-label="Editar @_m.NombrePlantilla(p)" @onclick="() => EmpezarEdicion(p)">Editar</button>
                            <button class="linkbtn" type="button" disabled="@_m.Guardando" aria-label="@(p.Activo ? "Pausar" : "Reanudar") @_m.NombrePlantilla(p)" @onclick="() => AlternarActivaAsync(p)">@(p.Activo ? "Pausar" : "Reanudar")</button>
                            <button class="linkbtn danger" type="button" disabled="@_m.Guardando" aria-label="Eliminar @_m.NombrePlantilla(p)" @onclick="() => _m.ConfirmandoEliminar = p.Id">Eliminar</button>
                        }
                    </div>
                </div>
            }

            @if (_m.Plantillas.Count == 0)
            {
                <div class="empty">Todavía no hay gastos recurrentes. Añade el primero abajo.</div>
            }
        </div>

        @if (_m.Adultos.Count == 0 || _m.Categorias.Count == 0 || _m.Perfiles.Count == 0)
        {
            <div class="aviso warn u-mt14">Para crear plantillas hace falta al menos un adulto, una categoría y un perfil de reparto.</div>
        }
        else if (!Permisos.Tiene(Claves.RecurrentesGestionar))
        {
            <div class="aviso warn u-mt14" role="status">No tienes permiso para gestionar los gastos recurrentes. Pídeselo a un administrador del hogar.</div>
        }
        else
        {
            <form class="addcat" id="form-recurrente" @onsubmit="GuardarAsync">
                <h3 class="u-titulo-form">@(_m.Editando is null ? "Nueva plantilla" : "Editar plantilla")</h3>
                <label>Concepto
                    <input maxlength="200" placeholder="Opcional" @bind="_m.Concepto" @bind:event="oninput" />
                </label>
                <label>Importe (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_m.Importe" @bind:event="oninput" />
                </label>
                <label>Día del mes (1-28)
                    <input type="number" min="1" max="28" required @bind="_m.Dia" @bind:event="oninput" />
                </label>
                <label>Categoría
                    <select @bind="_m.Categoria" @bind:after="_m.AlCambiarCategoria">
                        @foreach (var n in _m.Arbol)
                        {
                            <option value="@n.Categoria.Id">@(new string(' ', n.Nivel * 3))@n.Categoria.Nombre</option>
                        }
                    </select>
                </label>
                <label>Paga
                    <select @bind="_m.Pagador">
                        @foreach (var m in _m.Adultos)
                        {
                            <option value="@m.Id">@m.Nombre</option>
                        }
                    </select>
                </label>
                <label>Reparto
                    <select @bind="_m.Perfil">
                        @foreach (var pf in _m.Perfiles)
                        {
                            <option value="@pf.Id">@pf.Nombre</option>
                        }
                    </select>
                </label>
                <button class="btn" type="submit" disabled="@(!_m.FormularioValido || _m.Guardando)">@(_m.Editando is null ? "Añadir" : "Guardar")</button>
                @if (_m.Editando is not null)
                {
                    <button class="linkbtn" type="button" @onclick="_m.ReiniciarFormulario">Cancelar</button>
                }
            </form>
        }
    </section>
}

@code {
    private ModeloRecurrentes _m = default!;

    protected override Task OnInitializedAsync()
    {
        _m = new ModeloRecurrentes(Api, () => Reloj.GetLocalNow().DateTime);
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        _m.IniciarCarga();
        await Permisos.AsegurarAsync();
        await _m.CargarAsync();
    }

    private void EmpezarEdicion(GastoRecurrenteResponse p) => _m.EmpezarEdicion(p);

    private Task GuardarAsync() => Mostrar(_m.GuardarAsync());

    private Task AlternarActivaAsync(GastoRecurrenteResponse p) => Mostrar(_m.AlternarActivaAsync(p));

    private Task EliminarAsync(GastoRecurrenteResponse p) => Mostrar(_m.EliminarAsync(p));

    private Task GenerarMesActualAsync() => Mostrar(_m.GenerarMesActualAsync());

    private Task GenerarAsync() => Mostrar(_m.GenerarAsync());

    /// <summary>Espera la operación del modelo y, si salió bien, muestra su aviso.</summary>
    private async Task Mostrar(Task<string?> operacion)
    {
        if (await operacion is { } aviso) Avisos.Mostrar(aviso);
    }
}

@* Pestaña Gastos: gastos del mes con su reparto, alta y edición. El servidor calcula el reparto según el perfil. *@
@using System.Globalization
@using Microsoft.JSInterop
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos
@inject ServicioPermisos Permisos

<h1 class="sr">@(SoloAlta ? $"Nuevo gasto en {Hogar.HogarActual?.Nombre}" : $"Gastos de {Hogar.HogarActual?.Nombre}")</h1>

@if (_m.Cargando)
{
    <EsqueletoLista Texto="Cargando gastos…" Filas="6" />
}
else if (_m.ErrorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_m.ErrorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else
{
    <section class="card" aria-labelledby="t-gastos">
        @* La pestaña «Nuevo gasto» muestra solo el formulario de alta, sin filtros ni lista. *@
        @if (SoloAlta)
        {
            <div class="card-head">
                <h2 id="t-gastos">Nuevo gasto</h2>
            </div>
        }
        else
        {
        <div class="card-head">
            <h2 id="t-gastos">Gastos</h2>
            <div class="modo" role="group" aria-label="Tipo de periodo">
                <button class="chip chip-btn @(_m.ModoRango ? "" : "sel")" type="button" aria-pressed="@(_m.ModoRango ? "false" : "true")" @onclick="() => _m.CambiarModoAsync(false)">Por mes</button>
                <button class="chip chip-btn @(_m.ModoRango ? "sel" : "")" type="button" aria-pressed="@(_m.ModoRango ? "true" : "false")" @onclick="() => _m.CambiarModoAsync(true)">Entre fechas</button>
            </div>
        </div>
        @if (_m.ModoRango)
        {
            <div class="filtros" role="group" aria-label="Periodo">
                <label>Desde
                    <input type="date" @bind="_m.Desde" @bind:after="_m.AplicarRangoAsync" max="@_m.Hasta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                </label>
                <label>Hasta
                    <input type="date" @bind="_m.Hasta" @bind:after="_m.AplicarRangoAsync" min="@_m.Desde.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                </label>
            </div>
            @if (_m.Desde > _m.Hasta)
            {
                <div class="aviso err u-mt12" role="alert">La fecha «Desde» no puede ser posterior a «Hasta».</div>
            }
        }
        else
        {
            <div class="mesnav">
                <button class="linkbtn" type="button" aria-label="Mes anterior" @onclick="() => _m.CambiarMesAsync(-1)"><Icono Nombre="chevron-left" /></button>
                <span class="tag cur" aria-live="polite">@NombreMes</span>
                <button class="linkbtn" type="button" aria-label="Mes siguiente" @onclick="() => _m.CambiarMesAsync(1)"><Icono Nombre="chevron-right" /></button>
            </div>
        }
        <div class="filtros" role="search" aria-label="Filtrar gastos">
            <label>Persona
                <select @bind="_m.FiltroMiembro" @bind:after="_m.AplicarFiltrosAsync">
                    <option value="">Todas</option>
                    @foreach (var m in _m.Miembros.Where(m => m.Activo))
                    {
                        <option value="@m.Id">@m.Nombre</option>
                    }
                </select>
            </label>
            <label>Categoría
                <select @bind="_m.FiltroCategoria" @bind:after="_m.AplicarFiltrosAsync">
                    <option value="">Todas</option>
                    @foreach (var n in _m.Arbol)
                    {
                        <option value="@n.Categoria.Id">@(new string(' ', n.Nivel * 3))@n.Categoria.Nombre</option>
                    }
                </select>
            </label>
            <label>Concepto
                <input type="search" maxlength="200" placeholder="Buscar…" @bind="_m.FiltroTexto" @bind:event="onchange" @bind:after="_m.AplicarFiltrosAsync" />
            </label>
            @if (_m.HayFiltros)
            {
                <button class="linkbtn" type="button" @onclick="_m.LimpiarFiltrosAsync">Quitar filtros</button>
            }
        </div>
        @if (_m.SoloPaga is not null || _m.SoloCuenta)
        {
            <p class="muted u-mt10" role="status">Solo lo que paga <b>@(_m.SoloPaga is { } p ? Formato.NombreMiembro(p, _m.Miembros) : "la cuenta común o el ahorro")</b>, no lo que solo asume.</p>
        }
        var totales = ListaGastos.Totales(_m.Gastos);
        <p class="muted">@(_m.HayFiltros ? "Total filtrado" : _m.ModoRango ? "Total del periodo" : "Total del mes"): <b>@Formato.Euros(totales.TotalHogar)</b> en @totales.CuantosHogar @(totales.CuantosHogar == 1 ? "gasto" : "gastos").
            @if (totales.HayPersonales)
            {
                <span>Personales (fuera de la liquidación): <b>@Formato.Euros(totales.TotalPersonales)</b>.</span>
            }
        </p>
        }

        @if (!_m.ModoRango && _m.MesCerrado)
        {
            <div class="aviso warn u-mt12" role="status">
                Este mes está cerrado: sus gastos no se pueden añadir, editar ni borrar. Un administrador puede reabrirlo desde Resumen.
            </div>
        }
        else if (_m.ModoRango && _m.Gastos.Any(_m.CerradoGasto))
        {
            <div class="aviso warn u-mt12" role="status">
                Los gastos de meses cerrados no se pueden editar ni borrar. Un administrador puede reabrir el mes desde Resumen.
            </div>
        }

        @if (_m.Error is not null)
        {
            <div class="aviso err u-mt12" role="alert">@_m.Error</div>
        }

        @* Con un gasto en edición el formulario sube sobre la lista (order en CSS): en un periodo largo no hay que bajar hasta el final. *@
        <div class="gastos-cuerpo">
        @if (!SoloAlta)
        {
        <div class="u-mt10">
            @foreach (var g in _m.Gastos)
            {
                <div class="gastorow @(g.Personal ? "personal" : "")">
                    <div class="g-main">
                        <div class="g-concepto">@(string.IsNullOrWhiteSpace(g.Concepto) ? _m.NombreCategoria(g.CategoriaId) : g.Concepto)</div>
                        <div class="muted g-meta">
                            @g.Fecha.ToString("dd/MM/yyyy", Es) · @_m.NombreCategoria(g.CategoriaId) · paga @(g.PagadoDesdeAhorro ? "el ahorro" : g.PagadoPor is { } quien ? Formato.NombreMiembro(quien, _m.Miembros) : "la cuenta común")
                            @if (g.GastoRecurrenteId is not null) { <span class="tag off">recurrente</span> }
                        </div>
                        <div class="g-reparto">
                            @if (g.Personal)
                            {
                                <span class="tag admin">Personal: no entra en la liquidación</span>
                            }
                            @if (g.ACargoCuentaComun)
                            {
                                <span class="tag cur">Cuenta común: sin reparto entre personas</span>
                            }
                            @if (g.PagadoDesdeAhorro)
                            {
                                <span class="tag cur">Descontado del ahorro</span>
                            }
                            @foreach (var r in g.Repartos)
                            {
                                <span class="chip"><Avatar Nombre="@Formato.NombreMiembro(r.MiembroId, _m.Miembros)" Color="@_m.ColorDe(r.MiembroId)" Tamano="sm" />@Formato.Euros(r.ImporteAsumido)</span>
                                @foreach (var a in g.RepartosACargo.Where(x => x.ResponsableId == r.MiembroId))
                                {
                                    <span class="chip"><Avatar Nombre="@Formato.NombreMiembro(a.MiembroId, _m.Miembros)" Color="@_m.ColorDe(a.MiembroId)" Tamano="sm" />@Formato.NombreMiembro(a.MiembroId, _m.Miembros) (a cargo de @Formato.NombreMiembro(a.ResponsableId, _m.Miembros)) @Formato.Euros(a.ImporteAsumido)</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="g-importe">@Formato.Euros(g.Importe)</div>
                    <div class="c-acc">
                        @if (_m.ConfirmandoEliminar == g.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarAsync(g)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.ConfirmandoEliminar = null">No</button>
                        }
                        else if (!_m.CerradoGasto(g))
                        {
                            @if (Permisos.Tiene(Claves.GastosEditar))
                            {
                                <button class="linkbtn" type="button" aria-label="Editar gasto @g.Concepto" @onclick="() => EmpezarEdicion(g)">Editar</button>
                            }
                            @if (Permisos.Tiene(Claves.GastosBorrar))
                            {
                                <button class="linkbtn danger" type="button" aria-label="Eliminar gasto @g.Concepto" @onclick="() => _m.ConfirmandoEliminar = g.Id">Eliminar</button>
                            }
                        }
                    </div>
                </div>
            }

            @if (_m.Gastos.Count == 0)
            {
                <div class="empty">@(_m.HayFiltros ? $"Ningún gasto de {(_m.ModoRango ? "este periodo" : "este mes")} coincide con los filtros." : _m.ModoRango ? "No hay gastos entre estas fechas." : "No hay gastos en este mes. Añade el primero abajo.")</div>
            }
        </div>
        }

        @if (_m.Adultos.Count == 0 || _m.Categorias.Count == 0 || _m.Perfiles.Count == 0)
        {
            <div class="aviso warn u-mt14">Para registrar gastos hace falta al menos un adulto, una categoría y un perfil de reparto.</div>
        }
        else if (!Permisos.Tiene(_m.Editando is null ? Claves.GastosCrear : Claves.GastosEditar))
        {
            <div class="aviso warn u-mt14" role="status">No tienes permiso para @(_m.Editando is null ? "crear" : "editar") gastos. Pídeselo a un administrador del hogar.</div>
        }
        else
        {
            <form class="addcat @(_m.Editando is not null ? "editando" : "")" @onsubmit="GuardarAsync">
                @if (!SoloAlta)
                {
                    <h3 class="u-titulo-form">@(_m.Editando is null ? "Nuevo gasto" : "Editar gasto")</h3>
                }
                <label>Fecha
                    <input type="date" required @bind="_m.Fecha" @ref="_campoFecha" />
                </label>
                <label>Importe (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_m.Importe" @bind:event="oninput" />
                </label>
                <label>Categoría
                    <select @bind="_m.Categoria" @bind:after="_m.AlCambiarCategoria">
                        @foreach (var n in _m.Arbol)
                        {
                            <option value="@n.Categoria.Id">@(new string(' ', n.Nivel * 3))@n.Categoria.Nombre</option>
                        }
                    </select>
                </label>
                <label>Paga
                    <select @bind="_m.OrigenPago" @bind:after="_m.AlCambiarPagador">
                        @foreach (var m in _m.Adultos)
                        {
                            <option value="@m.Id">@m.Nombre</option>
                        }
                        @if (_m.CuentaActiva && _m.PerfilCuentaComun is not null)
                        {
                            <option value="">Cuenta común (la paga directamente)</option>
                            @if (_m.AhorroActivo || _m.DesdeAhorro)
                            {
                                <option value="ahorro">Ahorro (se descuenta del ahorro)</option>
                            }
                        }
                    </select>
                </label>
                @if (_m.Pagador is not null)
                {
                    <label>Tipo de gasto
                        <select @bind="_m.TipoGasto">
                            <option value="hogar">Del hogar (se reparte)</option>
                            <option value="personal">Personal (solo de quien paga, fuera de la liquidación)</option>
                        </select>
                    </label>
                }
                <label>Reparto
                    <select @bind="_m.Perfil" disabled="@(_m.Personal && _m.Pagador is not null)">
                        @foreach (var p in _m.PerfilesOfrecidos)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                    @if (_m.CategoriaACargoDeLaCuenta)
                    {
                        <span class="muted">Esta categoría va por defecto a cargo de la cuenta común.</span>
                    }
                </label>
                <label>Concepto
                    <input maxlength="200" placeholder="Opcional" @bind="_m.Concepto" @bind:event="oninput" />
                </label>
                <button class="btn" type="submit" disabled="@(!_m.ImporteValido || _m.Guardando)">@(_m.Editando is null ? "Añadir" : "Guardar")</button>
                @if (_m.Editando is not null)
                {
                    <button class="linkbtn" type="button" @onclick="_m.CancelarEdicion">Cancelar</button>
                }
            </form>
        }
        </div>
    </section>
}

@code {
    private static readonly CultureInfo Es = new("es-ES");

    private ModeloGastos _m = default!;
    private ElementReference _campoFecha;
    private bool _enfocarFormulario;

    /// <summary>Categoría con la que se abre la lista (enlace desde el Dashboard).</summary>
    [Parameter] public Guid? CategoriaInicial { get; set; }

    /// <summary>Persona con la que se abre la lista (enlace desde el Dashboard).</summary>
    [Parameter] public Guid? MiembroInicial { get; set; }

    /// <summary>Solo los gastos que paga esta persona (enlace del Dashboard): a diferencia de <see cref="MiembroInicial"/>, no incluye los que solo asume en parte.</summary>
    [Parameter] public Guid? PagadorInicial { get; set; }

    /// <summary>Solo los gastos pagados por la cuenta común o el ahorro, sin persona (enlace del Dashboard).</summary>
    [Parameter] public bool CuentaComunInicial { get; set; }

    /// <summary>Primer día del periodo con el que se abre la lista; con <see cref="HastaInicial"/> activa el modo «entre fechas».</summary>
    [Parameter] public DateOnly? DesdeInicial { get; set; }

    /// <summary>Último día del periodo con el que se abre la lista.</summary>
    [Parameter] public DateOnly? HastaInicial { get; set; }

    /// <summary>Muestra solo el formulario de alta (pestaña «Nuevo gasto»), sin la lista del mes ni sus filtros.</summary>
    [Parameter] public bool SoloAlta { get; set; }

    private string NombreMes => _m.Mes.ToString("MMMM yyyy", Es);

    protected override Task OnInitializedAsync()
    {
        _m = new ModeloGastos(Api, DateOnly.FromDateTime(DateTime.Today));
        _m.Abrir(CategoriaInicial, MiembroInicial, PagadorInicial, CuentaComunInicial, DesdeInicial, HastaInicial);
        return CargarAsync();
    }

    /// <summary>
    /// Carga los datos. La cuenta común se ofrece si el hogar la tiene activada: se lee del hogar ya cargado (<c>/api/yo</c>, que se
    /// actualiza al cambiar las funciones) en lugar de pedir el estado completo de la cuenta, que son ~9 consultas solo para dos
    /// booleanos. Si otro administrador la activa desde otro dispositivo, la API sigue rechazando lo que no corresponda.
    /// </summary>
    private async Task CargarAsync()
    {
        _m.IniciarCarga();
        await Permisos.AsegurarAsync();
        var hogar = Hogar.HogarActual;
        await _m.CargarAsync(
            cuentaActiva: hogar is { CuentaComunActiva: true },
            ahorroActivo: hogar is { CuentaComunActiva: true, AhorroActivo: true });
    }

    private void EmpezarEdicion(GastoResponse g)
    {
        _m.EmpezarEdicion(g);
        _enfocarFormulario = true;
    }

    private async Task GuardarAsync()
    {
        if (await _m.GuardarAsync() is { } aviso) Avisos.Mostrar(aviso);
    }

    private async Task EliminarAsync(GastoResponse g)
    {
        if (await _m.EliminarAsync(g) is { } aviso) Avisos.Mostrar(aviso);
    }

    /// <summary>Al empezar a editar lleva el foco (y con él la vista) al formulario, aunque se pulsara «Editar» al final de una lista larga.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_enfocarFormulario) return;
        _enfocarFormulario = false;
        try
        {
            await _campoFecha.FocusAsync();
        }
        catch (Exception e) when (e is JSException or InvalidOperationException)
        {
            // El foco es una comodidad: sin JavaScript disponible la edición sigue funcionando.
        }
    }
}

# Copia este archivo a .env y rellénalo. .env está en .gitignore: nunca subas valores reales.

# URL del proyecto Supabase (emisor JWT: {Url}/auth/v1)
Supabase__Url=

# Solo si el proyecto aún usa el secreto HS256 legado (si se define, solo se aceptan tokens HS256)
# Supabase__JwtSecret=

# Cadena de conexión a Postgres (pooler de Supabase), formato:
# Host=aws-0-<region>.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__Default=

# Orígenes permitidos por CORS (uno por índice), p. ej. http://localhost:8080
Cors__OrigenesPermitidos__0=

# Assistant.Api: de momento no define variables propias (esqueleto).

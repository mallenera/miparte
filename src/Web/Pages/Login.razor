@page "/login"
@using System.ComponentModel.DataAnnotations
@using MiParte.Web.Configuracion
@using MiParte.Web.Demo
@inject ServicioSesion Sesion
@inject OpcionesWeb Opciones
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesión · Mi parte, tu parte</PageTitle>

<div class="acceso">
    <PanelBienvenida />
    <div class="auth">
        <h1 class="page-title">Iniciar sesión</h1>

        @if (!Opciones.EstaConfigurada)
        {
            <div class="aviso warn" role="alert">
                Falta configurar la aplicación (<code>Supabase:Url</code>, <code>Supabase:AnonKey</code> y <code>Api:CoreUrl</code> en <code>appsettings.json</code>).
            </div>
        }

        <EditForm Model="_modelo" OnValidSubmit="EnviarAsync">
            <DataAnnotationsValidator />
            <div class="fieldrow">
                <label for="email">Correo</label>
                <InputText id="email" type="email" inputmode="email" autocomplete="username" @bind-Value="_modelo.Email" />
                <ValidationMessage For="() => _modelo.Email" />
            </div>
            <div class="fieldrow">
                <label for="password">Contraseña</label>
                <CampoContrasena Id="password" Autocomplete="current-password" @bind-Value="_modelo.Password" />
                <ValidationMessage For="() => _modelo.Password" />
            </div>
            @if (_error is not null)
            {
                <div class="aviso err" role="alert">@_error</div>
                @if (_sinConfirmar)
                {
                    <p class="muted"><a href="@($"registro?email={Uri.EscapeDataString(_modelo.Email.Trim())}")">Introducir el código de confirmación</a></p>
                }
            }
            <button class="btn btn-block" type="submit" disabled="@(_enviando || !Opciones.EstaConfigurada)">
                @(_enviando ? "Entrando…" : "Entrar")<Icono Nombre="arrow-right" />
            </button>
        </EditForm>

        <BotonGoogle Deshabilitado="@(_enviando || !Opciones.EstaConfigurada)" />

        <div class="separador" aria-hidden="true">o</div>
        <button type="button" class="btn btn-ghost btn-block" disabled="@_enviando" @onclick="EntrarEnDemoAsync">
            <Icono Nombre="sparkles" />Probar la demo
        </button>
        <p class="muted">
            La demo local no necesita cuenta ni conexión y no guarda nada.
        </p>

        <p class="muted">¿No tienes cuenta? <a href="registro">Regístrate</a></p>
    </div>
</div>

@code {
    private readonly Modelo _modelo = new();
    private string? _error;
    private bool _enviando;
    private bool _sinConfirmar;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.InicializarAsync();
        try
        {
            // Retorno del login con Google: llega un código (PKCE) en la query; los errores pueden venir en query o fragmento.
            var uri = Navegacion.ToAbsoluteUri(Navegacion.Uri);
            if (await Sesion.CompletarGoogleAsync($"{uri.Query}&{uri.Fragment}"))
            {
                Navegacion.NavigateTo("", replace: true);
                return;
            }
        }
        catch (AuthException e)
        {
            _error = e.Message;
        }

        if (Sesion.SesionActual is not null) Navegacion.NavigateTo("", replace: true);
    }

    private async Task EnviarAsync()
    {
        _enviando = true;
        _error = null;
        _sinConfirmar = false;
        try
        {
            await Sesion.IniciarSesionAsync(_modelo.Email.Trim(), _modelo.Password);
            Navegacion.NavigateTo("", replace: true);
        }
        catch (AuthException e)
        {
            // Mensaje genérico para credenciales erróneas (no revela si el correo existe); solo se distingue la cuenta sin confirmar.
            _error = e.Message;
            _sinConfirmar = e.Message.StartsWith("Confirma tu correo", StringComparison.Ordinal);
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con Supabase. Comprueba tu conexión.";
        }
        finally
        {
            _enviando = false;
        }
    }

    private async Task EntrarEnDemoAsync()
    {
        await Sesion.IniciarDemoAsync();
        Navegacion.NavigateTo("", replace: true);
    }

    private sealed class Modelo
    {
        [Required(ErrorMessage = "Indica tu correo.")]
        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Indica tu contraseña.")]
        public string Password { get; set; } = "";
    }
}

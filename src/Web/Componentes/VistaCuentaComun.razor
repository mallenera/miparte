@* Pestaña Cuenta común (hay que activarla por hogar): saldo y efectivo del mes, su parte por persona, aportaciones fijas por adulto (con su parte de ahorro), reembolsos a quien adelantó gastos de la cuenta y retiradas del ahorro. *@
@using System.Globalization
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos
@inject ServicioPermisos Permisos

<h1 class="sr">Cuenta común de @Hogar.HogarActual?.Nombre</h1>

@if (_cargando)
{
    <div class="spinbox" role="status"><div class="spin"></div><span>Cargando la cuenta común…</span></div>
}
else if (_errorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_errorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (_estado is not null && !_estado.Activa)
{
    <section class="card" aria-labelledby="t-cuenta-inactiva">
        <div class="card-head"><h2 id="t-cuenta-inactiva">Cuenta común</h2><span class="tag off">Sin activar</span></div>
        <p class="muted">
            La cuenta común es un fondo del hogar al que cada adulto aporta una cantidad fija al mes. Con ella puedes pagar gastos
            sin repartirlos entre personas, reembolsar a quien adelanta dinero y apartar un ahorro. Este hogar todavía no la usa.
        </p>
        @if (SoyAdmin)
        {
            <a class="btn u-mt12" href="hogar/configuracion">Habilitarla en la configuración del hogar</a>
        }
        else
        {
            <div class="aviso warn u-mt12" role="status">No tienes permiso para activarla: pídeselo a un administrador del hogar.</div>
        }
    </section>
}
else if (_estado is not null)
{
    <section class="card" aria-labelledby="t-cuenta">
        <div class="card-head">
            <h2 id="t-cuenta">Cuenta común</h2>
            <div class="mesnav">
                <button class="linkbtn" type="button" aria-label="Mes anterior" @onclick="() => CambiarMesAsync(-1)"><Icono Nombre="chevron-left" /></button>
                <span class="tag cur" aria-live="polite">@NombreMes</span>
                <button class="linkbtn" type="button" aria-label="Mes siguiente" @onclick="() => CambiarMesAsync(1)"><Icono Nombre="chevron-right" /></button>
            </div>
        </div>
        <p class="muted">Saldo acumulado hasta final de mes: aportaciones para gastos (sin el ahorro) menos los gastos cargados a la cuenta.</p>

        @if (_error is not null)
        {
            <div class="aviso err u-mt12" role="alert">@_error</div>
        }

        <div class="u-fila-mt10">
            <span class="chip">Saldo&nbsp;<b id="saldo">@Formato.Euros(_estado.Saldo)</b></span>
            <span class="chip">Efectivo&nbsp;<b>@Formato.Euros(_estado.Efectivo)</b></span>
            <span class="chip">Aportado este mes&nbsp;<b>@Formato.Euros(_estado.AportadoMes)</b></span>
            <span class="chip">Aportado en total&nbsp;<b>@Formato.Euros(_estado.Aportado)</b></span>
            <span class="chip">Gastado en total&nbsp;<b>@Formato.Euros(_estado.Gastado)</b></span>
            @if (_estado.AhorroActivo)
            {
                <span class="chip">Ahorro disponible&nbsp;<b id="ahorro">@Formato.Euros(_estado.AhorroDisponible)</b></span>
            }
        </div>

        @if (_estado.Saldo < 0)
        {
            <div class="aviso warn u-mt12" role="status">
                La cuenta no cubre los gastos: faltan @Formato.Euros(-_estado.Saldo) para cubrirlos.
            </div>
        }
    </section>

    <section class="card" aria-labelledby="t-partes">
        <div class="card-head"><h2 id="t-partes">Su parte</h2></div>
        <p class="muted">Lo que ha puesto cada persona y la porción que le corresponde del saldo (en proporción a lo aportado para gastos) @(_estado.AhorroActivo ? "y del ahorro (en proporción a lo ahorrado)." : "")</p>
        @foreach (var p in _estado.Partes ?? [])
        {
            <div class="catrow parte">
                <div class="c-name"><Avatar Nombre="@p.Nombre" Color="@ColorMiembro.De(p.MiembroId, _miembros)" Tamano="sm" /> @p.Nombre</div>
                <div class="c-sel">
                    <span class="chip">Ha puesto&nbsp;<b>@Formato.Euros(p.Aportado)</b>&nbsp;para gastos (@Porcentaje(p.PorcentajeGastos))</span>
                    @if (_estado.AhorroActivo)
                    {
                        <span class="chip">Ahorro&nbsp;<b>@Formato.Euros(p.Ahorrado)</b>&nbsp;(@Porcentaje(p.PorcentajeAhorro))</span>
                    }
                    <span class="chip">Su parte del saldo&nbsp;<b>@Formato.Euros(p.ParteSaldo)</b></span>
                    @if (_estado.AhorroActivo)
                    {
                        <span class="chip">Su parte del ahorro&nbsp;<b>@Formato.Euros(p.ParteAhorro)</b></span>
                    }
                    @if (p.Pendiente > 0)
                    {
                        <span class="chip">La cuenta le debe&nbsp;<b>@Formato.Euros(p.Pendiente)</b></span>
                    }
                </div>
            </div>
        }
        @if ((_estado.Partes ?? []).Count == 0)
        {
            <div class="empty">Todavía nadie ha aportado a la cuenta.</div>
        }
    </section>

    <section class="card" aria-labelledby="t-aportaciones">
        <div class="card-head"><h2 id="t-aportaciones">Aportación mensual</h2></div>
        <p class="muted">Importe fijo que aporta cada adulto al mes@(_estado.AhorroActivo ? "; una parte puede ir a ahorro y el resto queda para gastos" : ""). Un cambio vale desde el mes elegido en adelante.</p>
        <div class="u-mt10">
            @foreach (var a in _adultos)
            {
                <div class="catrow">
                    <div class="c-name"><Avatar Nombre="@a.Nombre" Color="@ColorMiembro.De(a.Id, _miembros)" Tamano="sm" /> @a.Nombre</div>
                    <div class="c-sel">@Formato.Euros(VigenteDe(a.Id)) al mes@(AhorroVigenteDe(a.Id) > 0 ? $" ({Formato.Euros(AhorroVigenteDe(a.Id))} de ahorro)" : "")</div>
                </div>
            }
            @if (_adultos.Count == 0)
            {
                <div class="empty">El hogar no tiene adultos activos.</div>
            }
        </div>

        @if (_adultos.Count > 0 && PuedeCuenta)
        {
            <form class="addcat" id="form-aportacion" @onsubmit="FijarAportacionAsync">
                <label>Adulto
                    <select @bind="_aportante" @bind:after="AlCambiarAportante">
                        @foreach (var a in _adultos)
                        {
                            <option value="@a.Id">@a.Nombre</option>
                        }
                    </select>
                </label>
                <label>Importe al mes (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_importeAportacion" @bind:event="oninput" />
                </label>
                @if (_estado.AhorroActivo)
                {
                    <label>De ese importe, a ahorro (€)
                        <input id="ahorro-aportacion" inputmode="decimal" placeholder="0,00" @bind="_ahorroAportacion" @bind:event="oninput" />
                    </label>
                }
                <button class="btn" type="submit" disabled="@(!AportacionValida || _enviando)">Fijar desde @NombreMes</button>
            </form>
        }
    </section>

    <section class="card" aria-labelledby="t-reembolsos">
        <div class="card-head"><h2 id="t-reembolsos">Reembolsos</h2></div>
        <p class="muted">Cuando una persona adelanta un gasto de la cuenta, esta le debe ese importe hasta reembolsárselo.</p>

        @if (_estado.Pendientes.Count == 0)
        {
            <div class="empty">No hay reembolsos pendientes.</div>
        }
        @foreach (var p in _estado.Pendientes)
        {
            <div class="catrow">
                <div class="c-name">@p.Nombre</div>
                <div class="c-sel">La cuenta le debe @Formato.Euros(p.Importe)</div>
            </div>
        }

        @foreach (var r in _estado.Reembolsos.OrderByDescending(r => r.Fecha))
        {
            <div class="gastorow">
                <div class="g-main">
                    <div class="g-concepto">Reembolso a @Formato.NombreMiembro(r.MiembroId, _miembros)</div>
                    <div class="muted g-meta">@r.Fecha.ToString("dd/MM/yyyy", Es)@(string.IsNullOrWhiteSpace(r.Concepto) ? "" : " · " + r.Concepto)</div>
                </div>
                <div class="g-importe">@Formato.Euros(r.Importe)</div>
                <div class="c-acc">
                    @if (_confirmandoEliminar == r.Id)
                    {
                        <span class="muted">¿Eliminar?</span>
                        <button class="linkbtn danger" type="button" @onclick="() => EliminarAsync(r)">Sí</button>
                        <button class="linkbtn" type="button" @onclick="() => _confirmandoEliminar = null">No</button>
                    }
                    else
                    {
                        <button class="linkbtn danger" type="button" aria-label="Eliminar reembolso a @Formato.NombreMiembro(r.MiembroId, _miembros)" @onclick="() => _confirmandoEliminar = r.Id">Eliminar</button>
                    }
                </div>
            </div>
        }

        @if (_estado.Pendientes.Count > 0 && PuedeCuenta)
        {
            <form class="addcat" id="form-reembolso" @onsubmit="ReembolsarAsync">
                <h3 class="u-titulo-form">Nuevo reembolso</h3>
                <label>A
                    <select @bind="_reembolsado">
                        @foreach (var p in _estado.Pendientes)
                        {
                            <option value="@p.MiembroId">@p.Nombre</option>
                        }
                    </select>
                </label>
                <label>Importe (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_importeReembolso" @bind:event="oninput" />
                </label>
                <label>Concepto
                    <input maxlength="200" placeholder="Opcional" @bind="_conceptoReembolso" @bind:event="oninput" />
                </label>
                <button class="btn" type="submit" disabled="@(!ReembolsoValido || _enviando)">Reembolsar</button>
            </form>
        }
    </section>

    @if (_estado.AhorroActivo)
    {
        <section class="card" aria-labelledby="t-ahorro">
            <div class="card-head"><h2 id="t-ahorro">Ahorro</h2></div>
            <p class="muted">Suma la parte de las aportaciones que se aparta y lo que ingreses aparte (ahorro inicial, lotería…). Los gastos no la tocan: solo baja al retirarla o al pagar un gasto desde el ahorro.</p>
            <div class="u-fila-mt10">
                <span class="chip">Ahorrado este mes&nbsp;<b>@Formato.Euros(_estado.AhorroMes)</b></span>
                <span class="chip">Ahorrado en total&nbsp;<b>@Formato.Euros(_estado.AhorroAcumulado)</b></span>
                <span class="chip">Ingresado aparte&nbsp;<b>@Formato.Euros(_estado.AhorroDepositado)</b></span>
                <span class="chip">Retirado&nbsp;<b>@Formato.Euros(_estado.AhorroRetirado)</b></span>
                <span class="chip">Gastado del ahorro&nbsp;<b>@Formato.Euros(_estado.AhorroGastado)</b></span>
            </div>

            @if (_estado.AhorroDisponible < 0)
            {
                <div class="aviso warn u-mt12" role="status">
                    Se ha retirado más de lo ahorrado: faltan @Formato.Euros(-_estado.AhorroDisponible) (revisa las aportaciones o las retiradas).
                </div>
            }

            @foreach (var d in (_estado.DepositosAhorro ?? []).OrderByDescending(d => d.Fecha))
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">Ingreso de @Formato.NombreMiembro(d.MiembroId, _miembros)</div>
                        <div class="muted g-meta">@d.Fecha.ToString("dd/MM/yyyy", Es)@(string.IsNullOrWhiteSpace(d.Concepto) ? "" : " · " + d.Concepto)</div>
                    </div>
                    <div class="g-importe">@Formato.Euros(d.Importe)</div>
                    <div class="c-acc">
                        @if (_confirmandoEliminar == d.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarDepositoAsync(d)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="linkbtn danger" type="button" aria-label="Eliminar ingreso de @Formato.NombreMiembro(d.MiembroId, _miembros)" @onclick="() => _confirmandoEliminar = d.Id">Eliminar</button>
                        }
                    </div>
                </div>
            }

            @if (_adultos.Count > 0 && PuedeAhorro)
            {
                <form class="addcat" id="form-deposito" @onsubmit="IngresarAhorroAsync">
                    <h3 class="u-titulo-form">Añadir al ahorro</h3>
                    <label>Lo ingresa
                        <select @bind="_depositante">
                            @foreach (var a in _adultos)
                            {
                                <option value="@a.Id">@a.Nombre</option>
                            }
                        </select>
                    </label>
                    <label>Importe (€)
                        <input inputmode="decimal" required placeholder="0,00" @bind="_importeDeposito" @bind:event="oninput" />
                    </label>
                    <label>Concepto
                        <input maxlength="200" placeholder="Ahorro inicial, lotería…" @bind="_conceptoDeposito" @bind:event="oninput" />
                    </label>
                    <button class="btn" type="submit" disabled="@(!DepositoValido || _enviando)">Añadir</button>
                </form>
            }

            @foreach (var r in (_estado.RetiradasAhorro ?? []).OrderByDescending(r => r.Fecha))
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">Retirada de @Formato.NombreMiembro(r.MiembroId, _miembros)</div>
                        <div class="muted g-meta">@r.Fecha.ToString("dd/MM/yyyy", Es)@(string.IsNullOrWhiteSpace(r.Concepto) ? "" : " · " + r.Concepto)</div>
                    </div>
                    <div class="g-importe">@Formato.Euros(r.Importe)</div>
                    <div class="c-acc">
                        @if (_confirmandoEliminar == r.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarRetiradaAsync(r)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="linkbtn danger" type="button" aria-label="Eliminar retirada de @Formato.NombreMiembro(r.MiembroId, _miembros)" @onclick="() => _confirmandoEliminar = r.Id">Eliminar</button>
                        }
                    </div>
                </div>
            }

            @if (_estado.AhorroDisponible > 0 && _adultos.Count > 0 && PuedeAhorro)
            {
                <form class="addcat" id="form-retirada" @onsubmit="RetirarAhorroAsync">
                    <h3 class="u-titulo-form">Retirar del ahorro</h3>
                    <label>Lo retira
                        <select @bind="_retirante">
                            @foreach (var a in _adultos)
                            {
                                <option value="@a.Id">@a.Nombre</option>
                            }
                        </select>
                    </label>
                    <label>Importe (€)
                        <input inputmode="decimal" required placeholder="0,00" @bind="_importeRetirada" @bind:event="oninput" />
                    </label>
                    <label>Concepto
                        <input maxlength="200" placeholder="Opcional" @bind="_conceptoRetirada" @bind:event="oninput" />
                    </label>
                    <button class="btn" type="submit" disabled="@(!RetiradaValida || _enviando)">Retirar</button>
                </form>
            }
            else if (_estado.AhorroDisponible <= 0)
            {
                <div class="empty">No hay ahorro disponible para retirar.</div>
            }
        </section>
    }
}

@code {
    private static readonly CultureInfo Es = new("es-ES");

    private CuentaComunResponse? _estado;
    private List<MiembroDto> _miembros = [], _adultos = [];
    private bool _cargando = true, _enviando;
    private string? _errorCarga, _error;
    private DateOnly _mes = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private Guid? _confirmandoEliminar;

    private Guid _aportante, _reembolsado;
    private Guid _retirante, _depositante;
    private string _importeAportacion = "", _ahorroAportacion = "", _importeReembolso = "", _conceptoReembolso = "";
    private string _importeRetirada = "", _conceptoRetirada = "", _importeDeposito = "", _conceptoDeposito = "";

    /// <summary>Si el usuario es admin del hogar: solo él activa o desactiva la cuenta común.</summary>
    private bool SoyAdmin => Permisos.Tiene(Claves.HogarFunciones);

    private bool PuedeCuenta => Permisos.Tiene(Claves.CuentaMovimientos);

    private bool PuedeAhorro => Permisos.Tiene(Claves.AhorroMovimientos);

    private static string Porcentaje(decimal p) => $"{p.ToString("0.##", Es)} %";

    private string NombreMes => _mes.ToString("MMMM yyyy", Es);
    private bool AportacionValida => TryImporte(_importeAportacion, permitirCero: true, out var importe)
        && TryImporte(string.IsNullOrWhiteSpace(_ahorroAportacion) || _estado?.AhorroActivo == false ? "0" : _ahorroAportacion, permitirCero: true, out var ahorro) && ahorro <= importe;
    private bool DepositoValido => TryImporte(_importeDeposito, permitirCero: false, out _);
    private bool RetiradaValida => TryImporte(_importeRetirada, permitirCero: false, out _);
    private bool ReembolsoValido => TryImporte(_importeReembolso, permitirCero: false, out _);

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = null;
        await Permisos.AsegurarAsync();
        try
        {
            _miembros = await Api.ListarMiembrosAsync();
            _adultos = _miembros.Where(m => m.Tipo == TiposMiembro.Adulto && m.Activo).ToList();
            _aportante = _retirante = _depositante = (_adultos.FirstOrDefault(m => m.EsYo) ?? _adultos.FirstOrDefault())?.Id ?? Guid.Empty;
            await RecargarAsync();
        }
        catch (ApiException e)
        {
            _errorCarga = e.Message;
        }

        _cargando = false;
    }

    private async Task RecargarAsync()
    {
        _estado = await Api.ObtenerCuentaComunAsync(Formato.Mes(_mes));
        if (_estado.Pendientes.All(p => p.MiembroId != _reembolsado)) _reembolsado = _estado.Pendientes.FirstOrDefault()?.MiembroId ?? Guid.Empty;
        AlCambiarAportante();
    }

    private async Task CambiarMesAsync(int delta)
    {
        _mes = _mes.AddMonths(delta);
        _error = null;
        _confirmandoEliminar = null;
        try
        {
            await RecargarAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    /// <summary>Aportación de un adulto en el mes mostrado: la de la fila más reciente que no pase de ese mes.</summary>
    private decimal VigenteDe(Guid miembro) =>
        _estado?.Aportaciones.Where(a => a.MiembroId == miembro && a.Desde <= _mes)
            .OrderByDescending(a => a.Desde).Select(a => a.Importe).FirstOrDefault() ?? 0m;

    /// <summary>Parte de ahorro de la aportación de un adulto en el mes mostrado.</summary>
    private decimal AhorroVigenteDe(Guid miembro) =>
        _estado?.Aportaciones.Where(a => a.MiembroId == miembro && a.Desde <= _mes)
            .OrderByDescending(a => a.Desde).Select(a => a.Ahorro).FirstOrDefault() ?? 0m;

    /// <summary>Al elegir adulto (o cambiar de mes) los campos muestran su aportación y ahorro vigentes.</summary>
    private void AlCambiarAportante()
    {
        _importeAportacion = VigenteDe(_aportante).ToString(CultureInfo.InvariantCulture);
        _ahorroAportacion = AhorroVigenteDe(_aportante).ToString(CultureInfo.InvariantCulture);
    }

    private static bool TryImporte(string texto, bool permitirCero, out decimal valor) =>
        decimal.TryParse(texto.Trim().Replace(',', '.'), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out valor)
        && (valor > 0 || (permitirCero && valor == 0)) && decimal.Round(valor, 2) == valor;

    private Task FijarAportacionAsync() =>
        EjecutarAsync(async () =>
        {
            if (!TryImporte(_importeAportacion, permitirCero: true, out var importe))
                throw new ApiException(System.Net.HttpStatusCode.BadRequest, "Introduce un importe de 0 o más con máximo 2 decimales.");
            var ahorro = 0m;
            // Sin ahorro activado el campo no se muestra y la aportación queda entera para gastos.
            if (_estado!.AhorroActivo && !string.IsNullOrWhiteSpace(_ahorroAportacion) && (!TryImporte(_ahorroAportacion, permitirCero: true, out ahorro) || ahorro > importe))
                throw new ApiException(System.Net.HttpStatusCode.BadRequest, "El ahorro debe estar entre 0 y la aportación, con máximo 2 decimales.");
            await Api.FijarAportacionAsync(new FijarAportacionRequest(_aportante, _mes, importe, ahorro));
            return "Aportación guardada";
        });

    private Task ReembolsarAsync() =>
        EjecutarAsync(async () =>
        {
            if (!TryImporte(_importeReembolso, permitirCero: false, out var importe))
                throw new ApiException(System.Net.HttpStatusCode.BadRequest, "Introduce un importe mayor que 0 con máximo 2 decimales.");
            await Api.CrearReembolsoAsync(new CrearReembolsoRequest(
                _reembolsado, importe, null, string.IsNullOrWhiteSpace(_conceptoReembolso) ? null : _conceptoReembolso.Trim()));
            _importeReembolso = "";
            _conceptoReembolso = "";
            return "Reembolso registrado";
        });

    private Task IngresarAhorroAsync() =>
        EjecutarAsync(async () =>
        {
            if (!TryImporte(_importeDeposito, permitirCero: false, out var importe))
                throw new ApiException(System.Net.HttpStatusCode.BadRequest, "Introduce un importe mayor que 0 con máximo 2 decimales.");
            await Api.CrearDepositoAhorroAsync(new CrearDepositoAhorroRequest(
                _depositante, importe, null, string.IsNullOrWhiteSpace(_conceptoDeposito) ? null : _conceptoDeposito.Trim()));
            _importeDeposito = "";
            _conceptoDeposito = "";
            return "Ahorro añadido";
        });

    private Task EliminarDepositoAsync(DepositoAhorroDto d) =>
        EjecutarAsync(async () =>
        {
            await Api.EliminarDepositoAhorroAsync(d.Id);
            _confirmandoEliminar = null;
            return "Ingreso eliminado";
        });

    private Task RetirarAhorroAsync() =>
        EjecutarAsync(async () =>
        {
            if (!TryImporte(_importeRetirada, permitirCero: false, out var importe))
                throw new ApiException(System.Net.HttpStatusCode.BadRequest, "Introduce un importe mayor que 0 con máximo 2 decimales.");
            await Api.CrearRetiradaAhorroAsync(new CrearRetiradaAhorroRequest(
                _retirante, importe, null, string.IsNullOrWhiteSpace(_conceptoRetirada) ? null : _conceptoRetirada.Trim()));
            _importeRetirada = "";
            _conceptoRetirada = "";
            return "Retirada registrada";
        });

    private Task EliminarRetiradaAsync(RetiradaAhorroDto r) =>
        EjecutarAsync(async () =>
        {
            await Api.EliminarRetiradaAhorroAsync(r.Id);
            _confirmandoEliminar = null;
            return "Retirada eliminada";
        });

    private Task EliminarAsync(ReembolsoCuentaDto r) =>
        EjecutarAsync(async () =>
        {
            await Api.EliminarReembolsoAsync(r.Id);
            _confirmandoEliminar = null;
            return "Reembolso eliminado";
        });

    /// <summary>
    /// Ejecuta una operación, recarga el estado y muestra el aviso; los errores de la API salen en pantalla.
    /// Mientras hay una en curso se ignoran las demás (un doble clic crearía el registro dos veces).
    /// </summary>
    private async Task EjecutarAsync(Func<Task<string>> accion)
    {
        if (_enviando) return;
        _enviando = true;
        _error = null;
        try
        {
            var aviso = await accion();
            await RecargarAsync();
            Avisos.Mostrar(aviso);
        }
        catch (ApiException e)
        {
            _error = e.Message;
            _confirmandoEliminar = null;
        }
        finally
        {
            _enviando = false;
        }
    }
}

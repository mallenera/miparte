@* Permisos del hogar: los adultos con cuenta (admins incluidos) y, para quien puede cambiar permisos, sus checks con plantillas para asignar rápido. La API es quien los aplica. *@
@inject CoreApiClient Api
@inject ServicioAvisos Avisos

<section class="card" aria-labelledby="t-permisos">
    <div class="card-head"><h2 id="t-permisos">Permisos</h2></div>
    <p class="muted">Cada adulto con cuenta tiene los permisos que se le asignen, también los admins. Siempre debe quedar alguien con el permiso de cambiar permisos.</p>
    @if (_m.Error is not null)
    {
        <div class="aviso err" role="alert">@_m.Error</div>
    }
    <div class="mlist">
        @foreach (var m in Miembros.Where(m => m.Tipo == TiposMiembro.Adulto && m.Activo && m.Vinculado))
        {
            var miembro = m;
            var total = miembro.Permisos?.Count ?? 0;
            <div class="mrow">
                <Avatar Nombre="@miembro.Nombre" Color="@ColorMiembro.De(miembro.Id, Miembros)" Tamano="lg" />
                <div class="mname">
                    <strong>@miembro.Nombre</strong>
                    @if (miembro.EsYo) { <span class="tag cur">Tú</span> }
                    @if (miembro.Rol == "admin") { <span class="tag admin">Admin</span> }
                </div>
                <div class="mmeta">
                    <span>@(total == Claves.Todos.Count ? "Todos los permisos" : $"{total} de {Claves.Todos.Count} permisos")</span>
                </div>
                <div class="macc">
                    @if (Puede)
                    {
                        <button class="linkbtn" type="button" aria-expanded="@((_m.Abierto == miembro.Id).ToString().ToLowerInvariant())"
                                aria-label="Permisos de @miembro.Nombre" @onclick="() => _m.Alternar(miembro)">
                            @(_m.Abierto == miembro.Id ? "Cerrar" : "Permisos")
                        </button>
                    }
                </div>
                @if (_m.Abierto == miembro.Id)
                {
                    <div class="permisos">
                        <div class="plantillas" role="group" aria-label="Plantillas de permisos">
                            <span class="muted">Plantilla:</span>
                            @foreach (var plantilla in Claves.Plantillas)
                            {
                                var p = plantilla;
                                <button class="btn btn-ghost btn-sm" type="button" title="@p.Descripcion" disabled="@_m.Guardando" @onclick="() => _m.Aplicar(p.Claves)">@p.Nombre</button>
                            }
                            <button class="linkbtn" type="button" disabled="@_m.Guardando" @onclick="() => _m.Aplicar(Claves.Todos.Select(x => x.Clave))">Marcar todo</button>
                            <button class="linkbtn" type="button" disabled="@_m.Guardando" @onclick="() => _m.Aplicar([])">Desmarcar todo</button>
                        </div>
                        @foreach (var grupo in ModeloPermisos.Grupos)
                        {
                            <fieldset class="permisos-grupo">
                                <legend>@grupo.Key</legend>
                                @foreach (var p in grupo)
                                {
                                    var clave = p.Clave;
                                    <label class="chk">
                                        <input type="checkbox" @key="@(clave + _m.Version)" checked="@_m.Marcado(clave)" disabled="@_m.Guardando"
                                               @onchange="e => _m.Marcar(clave, (bool)e.Value!)" />
                                        @p.Etiqueta
                                    </label>
                                }
                            </fieldset>
                        }
                        @if (miembro.EsYo && !_m.Marcado(Claves.PermisosGestionar))
                        {
                            <div class="aviso warn u-mt12" role="status">Te quitas a ti mismo el permiso de cambiar permisos: después otra persona tendrá que devolvértelo.</div>
                        }
                        <div class="actions">
                            <button class="btn btn-sm" type="button" disabled="@_m.Guardando" @onclick="() => GuardarAsync(miembro)">Guardar permisos</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.Abierto = null">Cancelar</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    @if (!Puede)
    {
        <p class="muted u-mt12">No tienes permiso para cambiar los permisos. Pídeselo a un administrador del hogar.</p>
    }
</section>


@code {
    private ModeloPermisos _m = default!;

    /// <summary>Miembros del hogar con sus permisos efectivos.</summary>
    [Parameter] public List<MiembroDto> Miembros { get; set; } = [];

    /// <summary>Si quien mira puede cambiar permisos (permiso <c>permisos.gestionar</c>).</summary>
    [Parameter] public bool Puede { get; set; }

    /// <summary>Se invoca tras guardar, para que la vista recargue los miembros.</summary>
    [Parameter] public EventCallback OnCambiado { get; set; }

    protected override void OnInitialized() => _m = new ModeloPermisos(Api);

    private async Task GuardarAsync(MiembroDto m)
    {
        if (await _m.GuardarAsync(m) is not { } aviso) return;
        Avisos.Mostrar(aviso);
        await OnCambiado.InvokeAsync();
    }
}

@implements IDisposable
@inject ServicioSesion Sesion
@inject EstadoHogar Hogar
@inject NavigationManager Navegacion

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Mi Parte, Tu Parte</a>
        <button title="Menú de navegación" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
                    </NavLink>
                </div>
                @if (Hogar.Hogares.Count > 1)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="elegir-hogar">Cambiar de hogar</NavLink>
                    </div>
                }
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link" @onclick="CerrarSesionAsync">Cerrar sesión (@context.User.Identity?.Name)</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Iniciar sesión</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="registro">Crear cuenta</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized() => Hogar.Cambiado += AlCambiarHogar;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task CerrarSesionAsync()
    {
        await Sesion.CerrarSesionAsync();
        await Hogar.LimpiarAsync();
        Navegacion.NavigateTo("login");
    }

    private void AlCambiarHogar() => InvokeAsync(StateHasChanged);

    public void Dispose() => Hogar.Cambiado -= AlCambiarHogar;
}

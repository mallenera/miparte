@page "/unirse"
@using System.ComponentModel.DataAnnotations
@inject ServicioSesion Sesion
@inject CoreApiClient Api
@inject ServicioArranque Arranque
@inject IAlmacenLocal Almacen
@inject NavigationManager Navegacion

<PageTitle>Unirme al hogar · Mi parte, tu parte</PageTitle>

<div class="auth ancho">
    <h1 class="page-title">Te han invitado a un hogar</h1>

    @if (!_listo)
    {
        <p>Cargando…</p>
    }
    else if (_token is null)
    {
        <div class="aviso warn" role="alert">
            El enlace no trae ninguna invitación. Pide que te lo envíen de nuevo o pega el código en
            <a href="sin-hogar">«Unirme con una invitación»</a>.
        </div>
    }
    else if (Sesion.SesionActual is null)
    {
        <section class="card">
            <div class="card-body">
                <p>Para unirte necesitas una cuenta. Al entrar volverás aquí y podrás aceptar la invitación.</p>
                <div class="actions">
                    <a class="btn" href="login">Iniciar sesión</a>
                    <a class="btn btn-ghost" href="registro">Crear cuenta</a>
                </div>
            </div>
        </section>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="aviso err" role="alert">@_error</div>
        }
        <section class="card">
            <div class="card-body">
                <EditForm Model="_modelo" OnValidSubmit="UnirseAsync">
                    <DataAnnotationsValidator />
                    <div class="fieldrow">
                        <label for="nombre">Tu nombre (si la invitación no lo trae)</label>
                        <InputText id="nombre" @bind-Value="_modelo.Nombre" />
                        <ValidationMessage For="() => _modelo.Nombre" />
                    </div>
                    <button class="btn" type="submit" disabled="@_enviando">Aceptar invitación</button>
                </EditForm>
            </div>
        </section>
    }
</div>

@code {
    private readonly Modelo _modelo = new();
    private string? _token, _error;
    private bool _listo, _enviando;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.InicializarAsync();

        // El código llega en el fragmento; se guarda y se quita de la barra de direcciones para que no quede en el historial.
        var delEnlace = InvitacionPendiente.ExtraerToken(Navegacion.Uri);
        if (delEnlace is not null)
        {
            await InvitacionPendiente.GuardarAsync(Almacen, delEnlace);
            Navegacion.NavigateTo(InvitacionPendiente.Ruta, replace: true);
        }

        _token = await InvitacionPendiente.LeerAsync(Almacen);
        _listo = true;
    }

    private async Task UnirseAsync()
    {
        // Enter y clic seguidos lanzarían dos aceptaciones (la segunda daría 409 por invitación usada).
        if (_enviando || _token is null) return;
        _enviando = true;
        _error = null;
        try
        {
            var nombre = string.IsNullOrWhiteSpace(_modelo.Nombre) ? null : _modelo.Nombre.Trim();
            await Api.AceptarInvitacionAsync(new AceptarInvitacionRequest(_token, nombre));
            await InvitacionPendiente.DescartarAsync(Almacen);
            var destino = await Arranque.CargarAsync();
            Navegacion.NavigateTo(destino == DestinoArranque.ElegirHogar ? "elegir-hogar" : "", replace: true);
        }
        catch (ApiException e)
        {
            // Con 404/409 el código ya no sirve (usado, caducado o inválido): no se vuelve a ofrecer en cada acceso.
            if (e.Codigo is System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Conflict) await InvitacionPendiente.DescartarAsync(Almacen);
            _error = e.Message;
        }
        finally
        {
            _enviando = false;
        }
    }

    private sealed class Modelo
    {
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string? Nombre { get; set; }
    }
}

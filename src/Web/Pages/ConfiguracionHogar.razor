@page "/hogar/configuracion"
@page "/hogar"
@attribute [Authorize]

<PageTitle>Configuración del hogar · Mi parte, tu parte</PageTitle>

<RequiereHogar>
    <VistaConfiguracionHogar Pestana="Pestana" />
</RequiereHogar>

@code {
    /// <summary>Pestaña de la configuración en la URL (<c>?pestana=permisos</c>, etc.).</summary>
    [SupplyParameterFromQuery] public string? Pestana { get; set; }
}

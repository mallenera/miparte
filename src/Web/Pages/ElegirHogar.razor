@page "/elegir-hogar"
@attribute [Authorize]
@inject EstadoHogar Hogar
@inject ServicioArranque Arranque
@inject NavigationManager Navegacion

<PageTitle>Elegir hogar · Mi parte, tu parte</PageTitle>

<div class="auth ancho">
    <h1 class="page-title">¿Con qué hogar quieres trabajar?</h1>

    @if (_error is not null)
    {
        <div class="aviso err" role="alert">@_error</div>
    }

    @if (!Hogar.Cargado)
    {
        <p>Cargando tus hogares…</p>
    }
    else
    {
        <ul class="hogar-list">
            @foreach (var h in Hogar.Hogares)
            {
                var id = h.Id;
                <li>
                    <button class="hcard" type="button" @onclick="() => ElegirAsync(id)">
                        <h3>
                            @h.Nombre
                            @if (Hogar.HogarActual?.Id == id)
                            {
                                <span class="tag cur">Hogar actual</span>
                            }
                        </h3>
                        <span class="btn btn-ghost btn-sm" aria-hidden="true">Entrar</span>
                    </button>
                </li>
            }
        </ul>
        <a href="sin-hogar">Crear otro hogar o unirme a uno</a>
    }
</div>

@code {
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (Hogar.Cargado) return;
        try
        {
            var destino = await Arranque.CargarAsync();
            if (destino == DestinoArranque.SinHogar) Navegacion.NavigateTo("sin-hogar", replace: true);
            else if (destino == DestinoArranque.Listo) Navegacion.NavigateTo("", replace: true);
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    private async Task ElegirAsync(Guid id)
    {
        await Hogar.SeleccionarAsync(id);
        Navegacion.NavigateTo("");
    }
}

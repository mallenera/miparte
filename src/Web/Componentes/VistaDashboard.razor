@* Pestaña Dashboard: indicadores y gráficos del gasto del hogar entre dos fechas, comparado con el periodo anterior de igual duración.
   Es interactivo como un cuadro de mando: pinchar una categoría, una persona o un tramo de la gráfica filtra el resto de elementos. *@
@using System.Globalization
@using MiParte.Web.Reparto
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject TimeProvider Reloj

<h1 class="sr">Dashboard de gastos de @Hogar.HogarActual?.Nombre</h1>

<section class="card" aria-labelledby="t-periodo">
    <div class="card-head"><h2 id="t-periodo">Dashboard de gastos</h2></div>
    <p class="muted">Elige el periodo que quieres controlar. Los gastos personales no cuentan en el total del hogar, igual que en el resumen mensual.</p>
    <div class="filtros" role="group" aria-label="Periodo">
        <label>Desde
            <input type="date" @bind="_desde" @bind:after="AplicarFechasAsync" max="@_hasta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </label>
        <label>Hasta
            <input type="date" @bind="_hasta" @bind:after="AplicarFechasAsync" min="@_desde.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </label>
    </div>
    <div class="u-fila-mt10" role="group" aria-label="Periodos rápidos">
        <button class="chip chip-btn" type="button" @onclick="() => ElegirAsync(PeriodoRapido.EsteMes)">Este mes</button>
        <button class="chip chip-btn" type="button" @onclick="() => ElegirAsync(PeriodoRapido.MesAnterior)">Mes anterior</button>
        <button class="chip chip-btn" type="button" @onclick="() => ElegirAsync(PeriodoRapido.Ultimos30)">Últimos 30 días</button>
        <button class="chip chip-btn" type="button" @onclick="() => ElegirAsync(PeriodoRapido.EsteAnio)">Este año</button>
    </div>
    @if (_desde > _hasta)
    {
        <div class="aviso err u-mt12" role="alert">La fecha «Desde» no puede ser posterior a «Hasta».</div>
    }
</section>

@if (_cargando)
{
    <div class="spinbox" role="status"><div class="spin"></div><span>Cargando el dashboard…</span></div>
}
else if (_errorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_errorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (_r is not null && _rCat is not null && _rMiembro is not null && _rSerie is not null && _base is not null)
{
    @if (HayFiltros)
    {
        <div class="dash-filtros" role="group" aria-label="Filtros activos">
            <span class="muted">Filtrando por:</span>
            @if (_filtro.Categoria is { } cat)
            {
                <button class="chip chip-btn sel" type="button" aria-label="Quitar el filtro de categoría @NombreCategoriaRaiz(cat)" @onclick="() => ElegirCategoria(cat)">Categoría: @NombreCategoriaRaiz(cat) <Icono Nombre="x" Tamano="14" /></button>
            }
            @if (_filtro.Miembro is { } mie)
            {
                <button class="chip chip-btn sel" type="button" aria-label="Quitar el filtro de persona @NombreMiembro(mie)" @onclick="() => ElegirMiembro(mie)">Paga: @NombreMiembro(mie) <Icono Nombre="x" Tamano="14" /></button>
            }
            @if (_filtro.CuentaComun)
            {
                <button class="chip chip-btn sel" type="button" aria-label="Quitar el filtro de cuenta común" @onclick="() => ElegirMiembro(null)">Paga: cuenta común o ahorro <Icono Nombre="x" Tamano="14" /></button>
            }
            @if (_tramo is { } tr)
            {
                <button class="chip chip-btn sel" type="button" aria-label="Quitar el filtro de fechas" @onclick="() => ElegirTramo(tr)">Fechas: @EtiquetaTramo(tr) <Icono Nombre="x" Tamano="14" /></button>
            }
            <button class="linkbtn" type="button" @onclick="QuitarFiltros">Quitar todos</button>
        </div>
    }
    else if (_base.NumeroGastos > 0)
    {
        <p class="muted u-mt12">Pincha en una categoría, una persona o un punto de la gráfica para filtrar el resto.</p>
    }

    <section class="kpis" aria-label="Indicadores clave del periodo @Periodo" aria-live="polite">
        <article class="kpi">
            <span class="kpi-lab">Gasto total</span>
            <b class="kpi-val" id="kpi-total">@Euros(_r.Total)</b>
            <span class="kpi-sub">@_r.NumeroGastos @(_r.NumeroGastos == 1 ? "gasto" : "gastos") entre @Periodo</span>
        </article>
        <article class="kpi">
            <span class="kpi-lab">Frente al periodo anterior</span>
            @if (_r.Variacion is { } v)
            {
                <b class="kpi-val @(v > 0 ? "sube" : v < 0 ? "baja" : "")" id="kpi-variacion">@(v > 0 ? "▲ +" : v < 0 ? "▼ −" : "")@Math.Abs(v).ToString("P1", Es)</b>
                <span class="kpi-sub">@(v > 0 ? "Gastáis más" : v < 0 ? "Gastáis menos" : "Igual") que los @Dias @(Dias == 1 ? "día previo" : "días previos") (@Euros(_r.TotalAnterior))</span>
            }
            else
            {
                <b class="kpi-val" id="kpi-variacion">—</b>
                <span class="kpi-sub">Sin gastos en el periodo anterior con los que comparar</span>
            }
        </article>
        <article class="kpi">
            <span class="kpi-lab">Media diaria</span>
            <b class="kpi-val" id="kpi-media">@Euros(_r.MediaDiaria)</b>
            <span class="kpi-sub">En @Dias @(Dias == 1 ? "día" : "días")</span>
        </article>
        <article class="kpi">
            <span class="kpi-lab">Categoría principal</span>
            @if (_r.CategoriaPrincipal is { } cp)
            {
                <b class="kpi-val kpi-texto" id="kpi-categoria">@cp.Nombre</b>
                <span class="kpi-sub">@Euros(cp.Importe) · @Porcentaje(cp.Importe, _r.Total) del total</span>
            }
            else
            {
                <b class="kpi-val" id="kpi-categoria">—</b>
                <span class="kpi-sub">Sin gastos con esta selección</span>
            }
        </article>
        <article class="kpi">
            <span class="kpi-lab">Mayor gasto</span>
            @if (_r.MayorGasto is { } mg)
            {
                <b class="kpi-val" id="kpi-mayor">@Euros(mg.Importe)</b>
                <span class="kpi-sub">@NombreGasto(mg) · @mg.Fecha.ToString("dd/MM/yyyy", Es)</span>
            }
            else
            {
                <b class="kpi-val" id="kpi-mayor">—</b>
                <span class="kpi-sub">Sin gastos con esta selección</span>
            }
        </article>
    </section>

    @if (_base.NumeroGastos == 0)
    {
        <section class="card">
            <div class="empty">No hay gastos del hogar entre estas fechas.@(_base.Personales > 0 ? $" Hay {Euros(_base.Personales)} en gastos personales." : "")</div>
        </section>
    }
    else
    {
        <section class="card" aria-labelledby="t-evolucion">
            <div class="card-head"><h2 id="t-evolucion">Evolución del gasto</h2><span class="tag">@TextoGranularidad</span></div>
            <svg class="dash-svg" viewBox="0 0 520 220" role="group" aria-labelledby="t-evolucion">
                @foreach (var g in Guias)
                {
                    <line class="gr-eje" x1="@N(MargenIzq)" x2="@N(Ancho - MargenDer)" y1="@g.Y" y2="@g.Y" />
                    @Etiqueta(N(MargenIzq - 6), g.YTexto, "end", g.Texto)
                }
                <path class="gr-area" d="@Area" />
                <path class="gr-linea" d="@Linea" />
                @for (var i = 0; i < _rSerie.Serie.Count; i++)
                {
                    var p = _rSerie.Serie[i];
                    var elegido = _tramo?.Inicio == p.Inicio;
                    @if (elegido)
                    {
                        @* Guía vertical del tramo elegido, para localizarlo de un vistazo. *@
                        <line class="gr-sel" x1="@N(X(i))" x2="@N(X(i))" y1="@N(Y(p.Importe))" y2="@N(MargenSup + AltoUtil)" />
                    }
                    <circle class="gr-punto @(elegido ? "sel" : _tramo is not null ? "apagado" : "")" cx="@N(X(i))" cy="@N(Y(p.Importe))" r="@(_rSerie.Serie.Count > 62 ? "2.5" : "3.5")" />
                    @* Zona de pulsación más grande que el punto, también para el teclado. *@
                    <circle class="gr-hit" cx="@N(X(i))" cy="@N(Y(p.Importe))" r="11" tabindex="0" role="button" aria-pressed="@(elegido ? "true" : "false")"
                            aria-label="@EtiquetaTramo(p): @Euros(p.Importe). Filtrar por este tramo"
                            @onclick="() => ElegirTramo(p)" @onkeydown="e => TeclaTramo(e, p)">
                        <title>@EtiquetaTramo(p): @Euros(p.Importe)</title>
                    </circle>
                    @if (RotulaEje(i))
                    {
                        @Etiqueta(N(X(i)), N(Alto - 8), AnclaEje(i), EtiquetaEje(p))
                    }
                }
            </svg>
        </section>

        <div class="dash-dos">
            <section class="card" aria-labelledby="t-categorias">
                <div class="card-head"><h2 id="t-categorias">Gasto por categoría</h2></div>
                @foreach (var c in CategoriasMostradas)
                {
                    var elegida = c.CategoriaId != Guid.Empty && _filtro.Categoria == c.CategoriaId;
                    var porcentaje = Porcentaje(c.Importe, _rCat.Total);
                    <button class="dash-fila dash-click @(elegida ? "sel" : _filtro.Categoria is not null ? "apagada" : "")" type="button"
                            aria-pressed="@(elegida ? "true" : "false")" disabled="@(c.CategoriaId == Guid.Empty)"
                            aria-label="@c.Nombre: @Euros(c.Importe), @porcentaje. Filtrar por esta categoría" @onclick="() => ElegirCategoria(c.CategoriaId)">
                        <span class="dash-fila-top">
                            <span class="dash-nombre">@c.Nombre</span>
                            <span class="g-importe">@Euros(c.Importe)</span>
                        </span>
                        <progress class="barra" max="100" value="@Math.Round(Porcentaje(c.Importe, _rCat.Total, 100m), 1).ToString(CultureInfo.InvariantCulture)" aria-hidden="true"></progress>
                        <span class="muted dash-pie">@porcentaje · @c.Gastos @(c.Gastos == 1 ? "gasto" : "gastos")</span>
                    </button>
                }
            </section>

            <section class="card" aria-labelledby="t-quien">
                <div class="card-head"><h2 id="t-quien">Quién paga</h2></div>
                <p class="muted">Dinero adelantado por cada persona y parte que le corresponde según el reparto.</p>
                <svg class="dash-rosco" viewBox="0 0 42 42" role="img" aria-label="Reparto del dinero adelantado entre las personas del hogar">
                    <circle class="dn-fondo" cx="21" cy="21" r="15.915" fill="none" stroke-width="6" />
                    @foreach (var s in Rodajas)
                    {
                        <circle class="@s.Clase dn-click @(s.Elegida ? "sel" : HayMiembroElegido ? "apagada" : "")" cx="21" cy="21" r="15.915" fill="none" stroke-width="6"
                                stroke-dasharray="@s.Trazo" stroke-dashoffset="@s.Desfase" @onclick="() => ElegirMiembro(s.Miembro)" />
                    }
                </svg>
                @foreach (var m in _rMiembro.PorMiembro)
                {
                    var elegido = m.MiembroId is { } mid ? _filtro.Miembro == mid : _filtro.CuentaComun;
                    <button class="dash-fila-top dash-miembro dash-click @(elegido ? "sel" : HayMiembroElegido ? "apagada" : "")" type="button"
                            aria-pressed="@(elegido ? "true" : "false")" @onclick="() => ElegirMiembro(m.MiembroId)">
                        <span class="dash-nombre">
                            @if (m.MiembroId is { } id)
                            {
                                <Avatar Nombre="@NombreMiembro(id)" Color="@ColorMiembro.De(id, _miembros)" Tamano="sm" />
                                @NombreMiembro(id)
                            }
                            else
                            {
                                <span class="dn-punto" aria-hidden="true"></span>
                                @:Cuenta común o ahorro
                            }
                        </span>
                        <span class="muted">paga <b class="g-importe">@Euros(m.Pagado)</b> · le toca <b class="g-importe">@Euros(m.Asumido)</b></span>
                    </button>
                }
            </section>
        </div>

        <section class="card" aria-labelledby="t-mayores">
            <div class="card-head">
                <h2 id="t-mayores">Mayores gastos</h2>
                <a class="btn" href="@UrlGastos" id="ver-gastos"><Icono Nombre="receipt" Tamano="16" />Ver y editar todos los gastos@(HayFiltros ? " de la selección" : "")</a>
            </div>
            @foreach (var g in _r.Mayores)
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">@NombreGasto(g)</div>
                        <div class="muted g-meta">@g.Fecha.ToString("dd/MM/yyyy", Es) · @ArbolCategorias.Ruta(_categorias, g.CategoriaId)</div>
                    </div>
                    <div class="g-importe">@Euros(g.Importe)</div>
                </div>
            }
            @if (_r.Mayores.Count == 0)
            {
                <div class="empty">Ningún gasto del hogar con esta selección.</div>
            }
        </section>
    }

    @if (_r.Personales > 0 && _base.NumeroGastos > 0)
    {
        <p class="muted">Además hay @Euros(_r.Personales) en gastos personales, fuera del total del hogar.</p>
    }
}

@code {
    private static readonly CultureInfo Es = new("es-ES");

    private enum PeriodoRapido { EsteMes, MesAnterior, Ultimos30, EsteAnio }

    private List<GastoResponse> _gastos = [];
    private List<CategoriaDto> _categorias = [];
    private List<MiembroDto> _miembros = [];
    private bool _cargando = true;
    private string? _errorCarga;
    private DateOnly _desde, _hasta;

    // Selección cruzada. Cada gráfico se calcula con los filtros de los demás y no con el suyo, para poder
    // verlo entero con su elemento resaltado (como un cuadro de mando) y cambiar o quitar la selección.
    private FiltroAnalisis _filtro = new();
    private PuntoSerie? _tramo;

    /// <summary>Sin filtros: decide si hay algo que mostrar en el periodo.</summary>
    private ResultadoAnalisis? _base;

    /// <summary>Con todos los filtros: indicadores y mayores gastos.</summary>
    private ResultadoAnalisis? _r;

    /// <summary>Sin el filtro de categoría: gráfico de categorías.</summary>
    private ResultadoAnalisis? _rCat;

    /// <summary>Sin el filtro de persona: rosco y lista de quién paga.</summary>
    private ResultadoAnalisis? _rMiembro;

    /// <summary>Sin el filtro de fechas: gráfico de evolución, del periodo completo.</summary>
    private ResultadoAnalisis? _rSerie;

    /// <summary>Versión de la última petición: una respuesta tardía de otro periodo no pisa la actual.</summary>
    private int _version;

    private DateOnly Hoy => DateOnly.FromDateTime(Reloj.GetLocalNow().DateTime);

    private bool HayFiltros => _filtro.Activo || _tramo is not null;

    /// <summary>Enlace a Gastos con la selección actual (periodo o tramo, categoría y persona) para ver la lista completa y editarla.</summary>
    private string UrlGastos
    {
        get
        {
            var (desde, hasta) = _tramo is { } t ? (t.Inicio, t.Fin) : (_desde, _hasta);
            var url = $"gastos?desde={desde.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}&hasta={hasta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";
            if (_filtro.Categoria is { } c) url += $"&categoria={c}";
            if (_filtro.Miembro is { } m) url += $"&miembro={m}";
            return url;
        }
    }

    private bool HayMiembroElegido =>_filtro.Miembro is not null || _filtro.CuentaComun;

    private int Dias => AnalisisGastos.Dias(_r?.Desde ?? _desde, _r?.Hasta ?? _hasta);

    private string Periodo => _r is null ? "" : $"{_r.Desde.ToString("d MMM yyyy", Es)} y {_r.Hasta.ToString("d MMM yyyy", Es)}";

    private string TextoGranularidad => AnalisisGastos.GranularidadPara(AnalisisGastos.Dias(_desde, _hasta)) switch
    {
        Granularidad.Dia => "Por día",
        Granularidad.Semana => "Por semana",
        _ => "Por mes",
    };

    /// <summary>Hasta 7 categorías y el resto agrupado, para que el gráfico se lea en una pantalla pequeña; la elegida siempre se ve.</summary>
    private IReadOnlyList<GastoPorCategoria> CategoriasMostradas
    {
        get
        {
            const int max = 7;
            var todas = _rCat!.PorCategoria;
            if (todas.Count <= max) return todas;
            var visibles = todas.Take(max - 1).ToList();
            if (_filtro.Categoria is { } elegida && todas.FirstOrDefault(c => c.CategoriaId == elegida) is { } c && !visibles.Contains(c))
                visibles[^1] = c;
            var resto = todas.Where(c => !visibles.Contains(c)).ToList();
            return visibles
                .Append(new GastoPorCategoria(Guid.Empty, "Otras categorías", resto.Sum(c => c.Importe), resto.Sum(c => c.Gastos)))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var hoy = Hoy;
        _desde = new DateOnly(hoy.Year, hoy.Month, 1);
        _hasta = hoy;
        await CargarAsync();
    }

    private Task ElegirAsync(PeriodoRapido p)
    {
        var hoy = Hoy;
        (_desde, _hasta) = p switch
        {
            PeriodoRapido.EsteMes => (new DateOnly(hoy.Year, hoy.Month, 1), hoy),
            PeriodoRapido.MesAnterior => (new DateOnly(hoy.Year, hoy.Month, 1).AddMonths(-1), new DateOnly(hoy.Year, hoy.Month, 1).AddDays(-1)),
            PeriodoRapido.Ultimos30 => (hoy.AddDays(-29), hoy),
            _ => (new DateOnly(hoy.Year, 1, 1), hoy),
        };
        return CargarAsync();
    }

    private Task AplicarFechasAsync() => _desde > _hasta ? Task.CompletedTask : CargarAsync();

    private async Task CargarAsync()
    {
        var version = ++_version;
        _cargando = true;
        _errorCarga = null;
        var desde = _desde;
        var hasta = _hasta;
        try
        {
            // Una sola petición cubre el periodo y el anterior de igual duración, para calcular la variación.
            var gastos = Api.ListarGastosPorRangoAsync(AnalisisGastos.InicioAnterior(desde, hasta), hasta);
            var categorias = Api.ListarCategoriasAsync();
            var miembros = Api.ListarMiembrosAsync();
            await Task.WhenAll(gastos, categorias, miembros);
            if (version != _version) return;
            _gastos = gastos.Result;
            _categorias = categorias.Result;
            _miembros = miembros.Result;
            // Otro periodo es otra vista: la selección anterior ya no tiene por qué existir.
            _filtro = new FiltroAnalisis();
            _tramo = null;
            Recalcular();
        }
        catch (ApiException e) when (version == _version)
        {
            _errorCarga = e.Message;
            _r = _rCat = _rMiembro = _rSerie = _base = null;
        }
        catch (ApiException)
        {
            return; // fallo de una petición ya superada
        }

        _cargando = false;
    }

    /// <summary>Recalcula cada gráfico con los filtros de los demás, en el cliente: los gastos del periodo ya están cargados.</summary>
    private void Recalcular()
    {
        var (desde, hasta) = _tramo is { } t ? (t.Inicio, t.Fin) : (_desde, _hasta);
        List<GastoResponse> Con(FiltroAnalisis f) => AnalisisGastos.Filtrar(_gastos, _categorias, f);

        _base = AnalisisGastos.Calcular(_gastos, _categorias, _desde, _hasta);
        _r = AnalisisGastos.Calcular(Con(_filtro), _categorias, desde, hasta);
        _rCat = AnalisisGastos.Calcular(Con(_filtro with { Categoria = null }), _categorias, desde, hasta);
        _rMiembro = AnalisisGastos.Calcular(Con(_filtro with { Miembro = null, CuentaComun = false }), _categorias, desde, hasta);
        _rSerie = AnalisisGastos.Calcular(Con(_filtro), _categorias, _desde, _hasta);
    }

    /// <summary>Pincha en una categoría: la elige, o la quita si ya estaba elegida. «Otras categorías» no se puede elegir.</summary>
    private void ElegirCategoria(Guid id)
    {
        if (id == Guid.Empty) return;
        _filtro = _filtro with { Categoria = _filtro.Categoria == id ? null : id };
        Recalcular();
    }

    /// <summary>Pincha en una persona (o en la cuenta común si es null): la elige, o la quita si ya estaba elegida.</summary>
    private void ElegirMiembro(Guid? id)
    {
        _filtro = id is { } m
            ? _filtro with { Miembro = _filtro.Miembro == m ? null : m, CuentaComun = false }
            : _filtro with { CuentaComun = !_filtro.CuentaComun, Miembro = null };
        Recalcular();
    }

    /// <summary>Pincha en un punto de la gráfica: filtra por ese tramo de fechas, o lo quita si ya estaba elegido.</summary>
    private void ElegirTramo(PuntoSerie p)
    {
        _tramo = _tramo?.Inicio == p.Inicio ? null : p;
        Recalcular();
    }

    private void TeclaTramo(KeyboardEventArgs e, PuntoSerie p)
    {
        if (e.Key is "Enter" or " ") ElegirTramo(p);
    }

    private void QuitarFiltros()
    {
        _filtro = new FiltroAnalisis();
        _tramo = null;
        Recalcular();
    }

    private string NombreMiembro(Guid id) => _miembros.FirstOrDefault(m => m.Id == id)?.Nombre ?? "—";

    private string NombreCategoriaRaiz(Guid id) => _categorias.FirstOrDefault(c => c.Id == id)?.Nombre ?? "—";

    private string NombreGasto(GastoResponse g) =>
        string.IsNullOrWhiteSpace(g.Concepto) ? ArbolCategorias.Ruta(_categorias, g.CategoriaId) : g.Concepto;

    private static string Euros(decimal importe) => importe.ToString("C2", Es);

    private static string Porcentaje(decimal parte, decimal total) => (total > 0 ? parte / total : 0m).ToString("P1", Es);

    private static decimal Porcentaje(decimal parte, decimal total, decimal escala) => total > 0 ? parte / total * escala : 0m;

    // ───── Gráfico de líneas (SVG con atributos y clases: la CSP no admite estilos en línea) ─────

    private const double Ancho = 520, Alto = 220, MargenIzq = 58, MargenDer = 14, MargenSup = 14, MargenInf = 30;
    private const double AnchoUtil = Ancho - MargenIzq - MargenDer, AltoUtil = Alto - MargenSup - MargenInf;

    /// <summary>Etiqueta de texto del SVG; se construye a mano porque en Razor <c>&lt;text&gt;</c> es una etiqueta reservada.</summary>
    private static RenderFragment Etiqueta(string x, string y, string ancla, string texto) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "class", "gr-txt");
        builder.AddAttribute(2, "x", x);
        builder.AddAttribute(3, "y", y);
        builder.AddAttribute(4, "text-anchor", ancla);
        builder.AddContent(5, texto);
        builder.CloseElement();
    };

    private static string N(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>Importe máximo de la serie (el eje Y llega hasta él).</summary>
    private double MaxSerie => Math.Max(1.0, (double)_rSerie!.Serie.Max(p => p.Importe));

    private double X(int i) =>
        _rSerie!.Serie.Count == 1 ? MargenIzq + AnchoUtil / 2 : MargenIzq + AnchoUtil * i / (_rSerie.Serie.Count - 1);

    private double Y(decimal v) => MargenSup + AltoUtil * (1 - (double)v / MaxSerie);

    private string Linea => string.Join(' ', _rSerie!.Serie.Select((p, i) => $"{(i == 0 ? "M" : "L")}{N(X(i))} {N(Y(p.Importe))}"));

    private string Area => $"{Linea} L{N(X(_rSerie!.Serie.Count - 1))} {N(MargenSup + AltoUtil)} L{N(X(0))} {N(MargenSup + AltoUtil)} Z";

    /// <summary>Líneas guía horizontales: cero, mitad y máximo, con su importe.</summary>
    private IEnumerable<(string Y, string YTexto, string Texto)> Guias =>
        new[] { 0.0, 0.5, 1.0 }.Select(f =>
        {
            var y = MargenSup + AltoUtil * (1 - f);
            return (N(y), N(y + 4), ((decimal)(MaxSerie * f)).ToString("N0", Es) + " €");
        });

    /// <summary>Se rotula como mucho cada cuarto de la serie, para que las etiquetas no se pisen en pantallas estrechas.</summary>
    private int PasoEtiquetas => Math.Max(1, (int)Math.Ceiling((_rSerie!.Serie.Count - 1) / 4.0));

    private bool RotulaEje(int i) => i % PasoEtiquetas == 0 || i == _rSerie!.Serie.Count - 1;

    private string AnclaEje(int i) => i == 0 ? "start" : i == _rSerie!.Serie.Count - 1 ? "end" : "middle";

    private static string EtiquetaTramo(PuntoSerie p) => p.Granularidad switch
    {
        Granularidad.Dia => p.Inicio.ToString("d MMM yyyy", Es),
        Granularidad.Semana => "Semana del " + p.Inicio.ToString("d MMM yyyy", Es),
        _ => Es.TextInfo.ToTitleCase(p.Inicio.ToString("MMMM yyyy", Es)),
    };

    private static string EtiquetaEje(PuntoSerie p) => p.Granularidad switch
    {
        Granularidad.Mes => p.Inicio.ToString("MMM yy", Es),
        _ => p.Inicio.ToString("d MMM", Es),
    };

    // ───── Rosco de quién paga ─────

    /// <summary>Un arco por persona (o por la cuenta común): circunferencia de 100 unidades, así el trazo es el porcentaje.</summary>
    private IEnumerable<(string Clase, string Trazo, string Desfase, Guid? Miembro, bool Elegida)> Rodajas
    {
        get
        {
            var total = _rMiembro!.PorMiembro.Sum(m => m.Pagado);
            var acumulado = 0.0;
            foreach (var m in _rMiembro.PorMiembro.Where(m => m.Pagado > 0))
            {
                var parte = (double)(m.Pagado / total) * 100;
                var clase = m.MiembroId is { } id ? $"dn-m{ColorMiembro.De(id, _miembros)}" : "dn-comun";
                var elegida = m.MiembroId is { } mid ? _filtro.Miembro == mid : _filtro.CuentaComun;
                yield return (clase, $"{N(parte)} {N(100 - parte)}", N(25 - acumulado), m.MiembroId, elegida);
                acumulado += parte;
            }
        }
    }
}

@page "/registro"
@using System.ComponentModel.DataAnnotations
@using MiParte.Web.Configuracion
@inject ServicioSesion Sesion
@inject OpcionesWeb Opciones
@inject NavigationManager Navegacion

<PageTitle>Crear cuenta · Mi Parte, Tu Parte</PageTitle>

<div class="mx-auto" style="max-width: 24rem;">
    <h1 class="h3 mb-3">Crear cuenta</h1>

    @if (!Opciones.EstaConfigurada)
    {
        <div class="alert alert-warning" role="alert">
            Falta configurar la aplicación (<code>Supabase:Url</code>, <code>Supabase:AnonKey</code> y <code>Api:CoreUrl</code> en <code>appsettings.json</code>).
        </div>
    }

    @if (_pendienteConfirmar)
    {
        <div class="alert alert-success" role="status">
            Cuenta creada. Te hemos enviado un correo para confirmarla; después podrás <a href="login">iniciar sesión</a>.
        </div>
    }
    else
    {
        <EditForm Model="_modelo" OnValidSubmit="EnviarAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="email">Correo</label>
                <InputText id="email" class="form-control" type="email" autocomplete="username" @bind-Value="_modelo.Email" />
                <ValidationMessage For="() => _modelo.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Contraseña</label>
                <InputText id="password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_modelo.Password" />
                <ValidationMessage For="() => _modelo.Password" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="repetir">Repite la contraseña</label>
                <InputText id="repetir" class="form-control" type="password" autocomplete="new-password" @bind-Value="_modelo.Repetir" />
                <ValidationMessage For="() => _modelo.Repetir" />
            </div>
            @if (_error is not null)
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }
            <button class="btn btn-primary w-100" type="submit" disabled="@(_enviando || !Opciones.EstaConfigurada)">
                @(_enviando ? "Creando…" : "Crear cuenta")
            </button>
        </EditForm>

        <p class="mt-3">¿Ya tienes cuenta? <a href="login">Inicia sesión</a></p>
    }
</div>

@code {
    private readonly Modelo _modelo = new();
    private string? _error;
    private bool _enviando;
    private bool _pendienteConfirmar;

    private async Task EnviarAsync()
    {
        _enviando = true;
        _error = null;
        try
        {
            if (await Sesion.RegistrarAsync(_modelo.Email.Trim(), _modelo.Password)) Navegacion.NavigateTo("", replace: true);
            else _pendienteConfirmar = true;
        }
        catch (AuthException e)
        {
            _error = e.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con Supabase. Comprueba tu conexión.";
        }
        finally
        {
            _enviando = false;
        }
    }

    private sealed class Modelo
    {
        [Required(ErrorMessage = "Indica tu correo.")]
        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Indica una contraseña.")]
        [MinLength(6, ErrorMessage = "Mínimo 6 caracteres.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Repite la contraseña.")]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string Repetir { get; set; } = "";
    }
}

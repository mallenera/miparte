@* Cuando el service worker ha descargado una versión nueva de la web la aplica sola: tapa la app con una pantalla de
   carga mientras el worker nuevo se activa y la página se recarga. *@
@implements IDisposable
@inject IJSRuntime JS

@if (_aplicando)
{
    <div class="cargando-actualizacion" role="alert" aria-busy="true">
        <div class="spin" aria-hidden="true"></div>
        <p>Cargando actualización, por favor, espere…</p>
    </div>
}

@code {
    private DotNetObjectReference<AvisoActualizacion>? _referencia;
    private bool _aplicando;

    protected override async Task OnAfterRenderAsync(bool primera)
    {
        if (!primera) return;
        _referencia = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("miparteActualizacion.suscribir", _referencia);
    }

    /// <summary>La llama <c>registrar-sw.js</c> cuando hay una versión nueva instalada y a la espera: la aplica sin preguntar.</summary>
    [JSInvokable]
    public async Task HayVersionNueva()
    {
        if (_aplicando) return;
        _aplicando = true;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("miparteActualizacion.aplicar");
    }

    public void Dispose() => _referencia?.Dispose();
}

@page "/login"
@using System.ComponentModel.DataAnnotations
@using MiParte.Web.Configuracion
@inject ServicioSesion Sesion
@inject OpcionesWeb Opciones
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesión · Mi Parte, Tu Parte</PageTitle>

<div class="mx-auto" style="max-width: 24rem;">
    <h1 class="h3 mb-3">Iniciar sesión</h1>

    @if (!Opciones.EstaConfigurada)
    {
        <div class="alert alert-warning" role="alert">
            Falta configurar la aplicación (<code>Supabase:Url</code>, <code>Supabase:AnonKey</code> y <code>Api:CoreUrl</code> en <code>appsettings.json</code>).
        </div>
    }

    <EditForm Model="_modelo" OnValidSubmit="EnviarAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label" for="email">Correo</label>
            <InputText id="email" class="form-control" type="email" autocomplete="username" @bind-Value="_modelo.Email" />
            <ValidationMessage For="() => _modelo.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Contraseña</label>
            <InputText id="password" class="form-control" type="password" autocomplete="current-password" @bind-Value="_modelo.Password" />
            <ValidationMessage For="() => _modelo.Password" />
        </div>
        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        <button class="btn btn-primary w-100" type="submit" disabled="@(_enviando || !Opciones.EstaConfigurada)">
            @(_enviando ? "Entrando…" : "Entrar")
        </button>
    </EditForm>

    <p class="mt-3">¿No tienes cuenta? <a href="registro">Regístrate</a></p>
</div>

@code {
    private readonly Modelo _modelo = new();
    private string? _error;
    private bool _enviando;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.InicializarAsync();
        if (Sesion.SesionActual is not null) Navegacion.NavigateTo("", replace: true);
    }

    private async Task EnviarAsync()
    {
        _enviando = true;
        _error = null;
        try
        {
            await Sesion.IniciarSesionAsync(_modelo.Email.Trim(), _modelo.Password);
            Navegacion.NavigateTo("", replace: true);
        }
        catch (AuthException e)
        {
            _error = e.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con Supabase. Comprueba tu conexión.";
        }
        finally
        {
            _enviando = false;
        }
    }

    private sealed class Modelo
    {
        [Required(ErrorMessage = "Indica tu correo.")]
        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Indica tu contraseña.")]
        public string Password { get; set; } = "";
    }
}

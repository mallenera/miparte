@* Pestaña Resumen: gastos del mes por miembro y categoría, y liquidación (saldos, transferencias sugeridas y pagos registrados). *@
@using System.Globalization
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos

<h1 class="sr">Resumen de @Hogar.HogarActual?.Nombre</h1>

@if (_cargando)
{
    <div class="spinbox" role="status"><div class="spin"></div><span>Cargando el resumen…</span></div>
}
else if (_errorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_errorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (_resumen is not null && _liquidacion is not null)
{
    <div class="mesbar">
        <div class="mesnav">
            <button class="linkbtn" type="button" aria-label="Mes anterior" @onclick="() => CambiarMesAsync(-1)"><Icono Nombre="chevron-left" /></button>
            <span class="tag cur" aria-live="polite">@NombreMes</span>
            <button class="linkbtn" type="button" aria-label="Mes siguiente" @onclick="() => CambiarMesAsync(1)"><Icono Nombre="chevron-right" /></button>
        </div>
    </div>
    @if (_error is not null)
    {
        <div class="aviso err u-mt12" role="alert">@_error</div>
    }

    <section class="card" aria-labelledby="t-liquidacion">
        <div class="card-head"><h2 id="t-liquidacion">Liquidación</h2></div>
        <p class="muted">Quién debe a quién para quedar en paz este mes. Los pagos que registres, completos o parciales, se descuentan de los saldos.</p>

        @if (_liquidacion.Saldos.Count > 1)
        {
            <label class="filtro">Ver solo a
                <select @bind="_filtroMiembro" aria-label="Filtrar la liquidación por miembro">
                    <option value="">Todos</option>
                    @foreach (var s in _liquidacion.Saldos)
                    {
                        <option value="@s.MiembroId">@s.Nombre</option>
                    }
                </select>
            </label>
        }

        @foreach (var s in _liquidacion.Saldos.Where(s => FiltraMiembro(s.MiembroId)))
        {
            <div class="catrow">
                <div class="c-name"><Avatar Nombre="@s.Nombre" Color="@ColorMiembro.De(s.MiembroId, _miembros)" Tamano="sm" /> @s.Nombre</div>
                <div class="c-sel">
                    <b class="g-importe saldo @(s.Saldo > 0 ? "pos" : s.Saldo < 0 ? "neg" : "")">@Saldo(s.Saldo)</b>
                    <span>@(s.Saldo > 0 ? "le deben" : s.Saldo < 0 ? "debe" : "en paz")</span>
                </div>
            </div>
        }

        @if (_liquidacion.Transferencias.Count == 0)
        {
            <div class="aviso ok u-mt12" role="status">
                @(_liquidacion.Saldos.Count == 0 ? "Todavía no hay nada que liquidar este mes." : "Este mes está saldado: nadie debe nada.")
            </div>
        }
        else
        {
            <h3 class="u-sec">Transferencias sugeridas</h3>
            <p class="muted">Cambia el importe para registrar un pago parcial; lo que quede seguirá pendiente.</p>
            @foreach (var t in _liquidacion.Transferencias.Where(t => FiltraMiembro(t.De) || FiltraMiembro(t.A)))
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">@NombreMiembro(t.De) paga a @NombreMiembro(t.A)</div>
                        <div class="muted g-meta">Pendiente @Euros(t.Importe)</div>
                        @if (!ImporteValido(t))
                        {
                            <div id="@IdError(t)" class="muted g-meta" role="status">Importe entre 0,01 y @Euros(t.Importe), con máximo 2 decimales.</div>
                        }
                    </div>
                    <div class="c-acc pagoimp">
                        <label class="sr" for="@IdImporte(t)">Importe a pagar de @NombreMiembro(t.De) a @NombreMiembro(t.A)</label>
                        <input id="@IdImporte(t)" class="g-importe" inputmode="decimal" value="@ImporteEscrito(t)"
                               aria-invalid="@(ImporteValido(t) ? null : "true")" aria-describedby="@(ImporteValido(t) ? null : IdError(t))"
                               @oninput="e => EscribirImporte(t, e.Value?.ToString())" />
                        <button class="btn" type="button" aria-label="Registrar el pago de @NombreMiembro(t.De) a @NombreMiembro(t.A)"
                                disabled="@(_guardando || !ImporteValido(t))" @onclick="() => RegistrarPagoAsync(t)">Registrar pago</button>
                    </div>
                </div>
            }
        }

        @if (_liquidacion.Pagos.Count > 0)
        {
            <h3 class="u-sec">Pagos registrados</h3>
            @foreach (var p in _liquidacion.Pagos.Where(p => FiltraMiembro(p.DeMiembroId) || FiltraMiembro(p.AMiembroId)).OrderByDescending(p => p.Fecha))
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">@NombreMiembro(p.DeMiembroId) pagó a @NombreMiembro(p.AMiembroId)</div>
                        <div class="muted g-meta">@p.Fecha.ToString("dd/MM/yyyy", Es)@(string.IsNullOrWhiteSpace(p.Concepto) ? "" : " · " + p.Concepto)</div>
                    </div>
                    <div class="g-importe">@Euros(p.Importe)</div>
                    <div class="c-acc">
                        @if (_confirmandoEliminar == p.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarPagoAsync(p)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="linkbtn danger" type="button" aria-label="Eliminar el pago de @NombreMiembro(p.DeMiembroId) a @NombreMiembro(p.AMiembroId)" @onclick="() => _confirmandoEliminar = p.Id">Eliminar</button>
                        }
                    </div>
                </div>
            }
        }
    </section>

    @if (_resumen.CuentaComun is { } cuenta)
    {
        <section class="card" aria-labelledby="t-cuenta-resumen">
            <div class="card-head"><h2 id="t-cuenta-resumen">Cuenta común</h2></div>
            <p class="muted">Saldos al final de @NombreMes. Los gastos a su cargo no entran en la liquidación entre personas.</p>
            <div class="u-fila-mt10">
                <span class="chip">Saldo&nbsp;<b id="cuenta-saldo">@Euros(cuenta.Saldo)</b></span>
                <span class="chip">Efectivo&nbsp;<b>@Euros(cuenta.Efectivo)</b></span>
                <span class="chip">Aportado este mes&nbsp;<b>@Euros(cuenta.AportadoMes)</b></span>
                <span class="chip">Gastado este mes&nbsp;<b>@Euros(cuenta.GastadoMes)</b></span>
                <span class="chip">Ahorro disponible&nbsp;<b>@Euros(cuenta.AhorroDisponible)</b></span>
                @if (cuenta.Pendiente > 0)
                {
                    <span class="chip">Pendiente de reembolsar&nbsp;<b>@Euros(cuenta.Pendiente)</b></span>
                }
            </div>
            @if (cuenta.Saldo < 0)
            {
                <div class="aviso warn u-mt12" role="status">La cuenta no cubre los gastos: faltan @Euros(-cuenta.Saldo).</div>
            }
            <a class="linkbtn u-mt8-inline" href="cuenta-comun">Ver la cuenta común</a>
        </section>
    }

    <section class="card" aria-labelledby="t-resumen">
        <div class="card-head"><h2 id="t-resumen">Resumen del mes</h2></div>

        @if (_resumen.GastosTotales == 0)
        {
            <div class="empty">
                <span>No hay gastos en @NombreMes.</span>
                <a class="btn" href="gastos">Añadir un gasto</a>
            </div>
            @foreach (var m in _resumen.Miembros.Where(m => m.DebeCuentaComun > 0))
            {
                <div class="catrow">
                    <div class="c-name"><Avatar Nombre="@m.Nombre" Color="@ColorMiembro.De(m.MiembroId, _miembros)" Tamano="sm" /> @m.Nombre</div>
                    <div class="c-sel"><span class="chip">La cuenta común le debe&nbsp;<b>@Euros(m.DebeCuentaComun)</b></span></div>
                </div>
            }
        }
        else
        {
            <div class="u-fila-mt10">
                <span class="chip">Gastos del mes&nbsp;<b id="total">@Euros(_resumen.GastosTotales)</b></span>
            </div>

            <h3 class="u-sec">Por persona</h3>
            @foreach (var m in _resumen.Miembros)
            {
                <div class="catrow">
                    <div class="c-name"><Avatar Nombre="@m.Nombre" Color="@ColorMiembro.De(m.MiembroId, _miembros)" Tamano="sm" /> @m.Nombre</div>
                    <div class="c-sel">
                        Ha pagado @Euros(m.Pagado) · le corresponden @Euros(m.Asumido)
                        @if (m.DebeCuentaComun > 0)
                        {
                            <span class="chip">La cuenta común le debe&nbsp;<b>@Euros(m.DebeCuentaComun)</b></span>
                        }
                    </div>
                </div>
            }

            <h3 class="u-sec">Por categoría</h3>
            @foreach (var f in FilasCategorias())
            {
                var n = f.Nodo;
                var importe = f.Directo ? n.Propio : n.Total;
                <div class="catrow resrow nivel-@Math.Min(f.Nivel, 4)">
                    <div class="c-name @(f.Nivel > 0 ? "sub" : "")">
                        @if (!f.Directo && n.Hijos.Count > 0)
                        {
                            var abierto = _abiertas.Contains(n.CategoriaId);
                            <button class="linkbtn" type="button" aria-expanded="@(abierto ? "true" : "false")"
                                    aria-label="@(abierto ? "Contraer" : "Desplegar") @n.Nombre" @onclick="() => Alternar(n.CategoriaId)">@(abierto ? "▾" : "▸")</button>
                        }
                        @(f.Directo ? "Sin subcategoría" : n.Nombre)
                    </div>
                    <div class="c-sel">
                        <b class="g-importe">@Euros(importe)</b> <span class="muted">@Porcentaje(importe) %</span>
                        <progress class="barra" max="100" value="@Porcentaje(importe)" aria-label="@Porcentaje(importe) % del total del mes"></progress>
                        @if (!f.Directo && n.PorMiembro.Count > 0)
                        {
                            <span class="g-reparto">
                                @foreach (var p in n.PorMiembro)
                                {
                                    <span class="chip">
                                        <Avatar Nombre="@NombreMiembro(p.MiembroId)" Color="@ColorMiembro.De(p.MiembroId, _miembros)" Tamano="sm" />
                                        @Euros(p.Importe)
                                    </span>
                                }
                            </span>
                        }
                    </div>
                </div>
            }
        }
    </section>
}

@code {
    /// <summary>Fila visible del árbol «Por categoría»; <c>Directo</c> es el gasto propio de una madre desplegada.</summary>
    private sealed record FilaCat(NodoResumen Nodo, int Nivel, bool Directo);

    /// <summary>Aplana el árbol según las madres desplegadas.</summary>
    private IEnumerable<FilaCat> FilasCategorias()
    {
        IEnumerable<FilaCat> Recorrer(NodoResumen n, int nivel)
        {
            yield return new FilaCat(n, nivel, false);
            if (n.Hijos.Count == 0 || !_abiertas.Contains(n.CategoriaId)) yield break;
            if (n.Propio > 0) yield return new FilaCat(n, nivel + 1, true);
            foreach (var h in n.Hijos)
                foreach (var f in Recorrer(h, nivel + 1)) yield return f;
        }

        return ArbolCategorias.ResumenEnArbol(_categorias, _resumen!.Categorias).SelectMany(n => Recorrer(n, 0));
    }

    private string Porcentaje(decimal total) =>
        (_resumen!.GastosTotales > 0 ? Math.Round(total / _resumen.GastosTotales * 100m, 0) : 0m).ToString("0", CultureInfo.InvariantCulture);

    private readonly HashSet<Guid> _abiertas = [];

    private void Alternar(Guid id)
    {
        if (!_abiertas.Remove(id)) _abiertas.Add(id);
    }

    private static readonly CultureInfo Es = new("es-ES");

    private ResumenMensualResponse? _resumen;
    private LiquidacionResponse? _liquidacion;
    private List<MiembroDto> _miembros = [];
    private List<CategoriaDto> _categorias = [];
    private bool _cargando = true, _guardando;
    private string? _errorCarga, _error;
    private DateOnly _mes = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private Guid? _confirmandoEliminar;
    private string _filtroMiembro = "";
    private readonly Dictionary<(Guid, Guid), string> _importes = [];

    private string NombreMes => _mes.ToString("MMMM yyyy", Es);

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = null;
        try
        {
            _miembros = await Api.ListarMiembrosAsync();
            try
            {
                _categorias = await Api.ListarCategoriasAsync();
            }
            catch (ApiException)
            {
                // Solo sirven para mostrar la ruta de las subcategorías: sin ellas el resumen usa el nombre suelto.
                _categorias = [];
            }

            await RecargarAsync();
        }
        catch (ApiException e)
        {
            _errorCarga = e.Message;
        }

        _cargando = false;
    }

    private async Task RecargarAsync()
    {
        var mes = _mes.ToString("yyyy-MM", CultureInfo.InvariantCulture);
        _resumen = await Api.ObtenerResumenAsync(mes);
        _liquidacion = await Api.ObtenerLiquidacionAsync(mes);
    }

    private async Task CambiarMesAsync(int delta)
    {
        _mes = _mes.AddMonths(delta);
        _error = null;
        _confirmandoEliminar = null;
        _importes.Clear();
        try
        {
            await RecargarAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    /// <summary>Ruta «Padre › Hija» de la categoría del resumen; si no se pudo cargar el árbol, su nombre.</summary>
    private string NombreCategoria(ResumenCategoriaDto c) =>
        _categorias.Any(x => x.Id == c.CategoriaId) ? ArbolCategorias.Ruta(_categorias, c.CategoriaId) : c.Nombre;

    private string NombreMiembro(Guid id) => _miembros.FirstOrDefault(m => m.Id == id)?.Nombre ?? "—";

    private static string Euros(decimal importe) => importe.ToString("C2", Es);

    /// <summary>Saldo con signo explícito, para que no dependa solo del color.</summary>
    private static string Saldo(decimal saldo) => (saldo > 0 ? "+" : "") + Euros(saldo);

    /// <summary>Sin filtro pasa todo; con filtro, solo lo que afecta al miembro elegido.</summary>
    private bool FiltraMiembro(Guid id) => _filtroMiembro == "" || id.ToString() == _filtroMiembro;

    private static (Guid, Guid) Clave(TransferenciaDto t) => (t.De, t.A);

    private static string IdImporte(TransferenciaDto t) => $"pago-{t.De}-{t.A}";

    private static string IdError(TransferenciaDto t) => $"pago-error-{t.De}-{t.A}";

    /// <summary>Lo escrito por el usuario o, si aún no ha tocado el campo, el importe sugerido.</summary>
    private string ImporteEscrito(TransferenciaDto t) =>
        _importes.TryGetValue(Clave(t), out var texto) ? texto : t.Importe.ToString("0.00", Es);

    /// <summary>Importe del pago: mayor que 0, con máximo 2 decimales y sin pasar de lo pendiente.</summary>
    private bool TryImporte(TransferenciaDto t, out decimal valor)
    {
        var texto = ImporteEscrito(t).Trim().Replace(',', '.');
        // Se mira el texto y no solo el valor: «1,230» vale lo mismo que «1,23» pero tiene tres decimales.
        var decimales = texto.Contains('.') ? texto.Length - texto.IndexOf('.') - 1 : 0;
        return decimal.TryParse(texto, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out valor)
            && valor > 0 && valor <= t.Importe && decimales <= 2;
    }

    private void EscribirImporte(TransferenciaDto t, string? texto) => _importes[Clave(t)] = texto ?? "";

    private bool ImporteValido(TransferenciaDto t) => TryImporte(t, out _);

    private Task RegistrarPagoAsync(TransferenciaDto t) =>
        EjecutarAsync(async () =>
        {
            if (!TryImporte(t, out var importe)) throw new ApiException(System.Net.HttpStatusCode.BadRequest, "Introduce un importe mayor que 0 con máximo 2 decimales y sin pasar de lo pendiente.");
            await Api.CrearPagoLiquidacionAsync(new CrearPagoLiquidacionRequest(_mes, t.De, t.A, importe, null, null));
            _importes.Remove(Clave(t));
            return importe == t.Importe ? "Pago registrado" : "Pago parcial registrado";
        });

    private Task EliminarPagoAsync(PagoLiquidacionDto p) =>
        EjecutarAsync(async () =>
        {
            await Api.EliminarPagoLiquidacionAsync(p.Id);
            _confirmandoEliminar = null;
            return "Pago eliminado";
        });

    /// <summary>Ejecuta una operación, recarga el mes y muestra el aviso; los errores de la API salen en pantalla.</summary>
    private async Task EjecutarAsync(Func<Task<string>> accion)
    {
        _error = null;
        _guardando = true;
        try
        {
            var aviso = await accion();
            await RecargarAsync();
            Avisos.Mostrar(aviso);
        }
        catch (ApiException e)
        {
            _error = e.Message;
            _confirmandoEliminar = null;
        }
        finally
        {
            _guardando = false;
        }
    }
}

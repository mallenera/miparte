@page "/sin-hogar"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject CoreApiClient Api
@inject ServicioArranque Arranque
@inject NavigationManager Navegacion

<PageTitle>Tu hogar · Mi parte, tu parte</PageTitle>

<div class="auth ancho">
    <h1 class="page-title">Crea tu hogar o únete a uno</h1>

    @if (_error is not null)
    {
        <div class="aviso err" role="alert">@_error</div>
    }

    <section class="card">
        <div class="card-body">
            <h2>Crear un hogar nuevo</h2>
            <EditForm Model="_crear" OnValidSubmit="CrearAsync">
                <DataAnnotationsValidator />
                <div class="fieldrow">
                    <label for="hogar">Nombre del hogar</label>
                    <InputText id="hogar" @bind-Value="_crear.NombreHogar" />
                    <ValidationMessage For="() => _crear.NombreHogar" />
                </div>
                <div class="fieldrow">
                    <label for="yo">Tu nombre en el hogar</label>
                    <InputText id="yo" @bind-Value="_crear.NombreMiembro" />
                    <ValidationMessage For="() => _crear.NombreMiembro" />
                </div>
                <button class="btn" type="submit" disabled="@_enviando">Crear hogar</button>
            </EditForm>
        </div>
    </section>

    <section class="card">
        <div class="card-body">
            <h2>Unirme con una invitación</h2>
            <EditForm Model="_unirse" OnValidSubmit="UnirseAsync">
                <DataAnnotationsValidator />
                <div class="fieldrow">
                    <label for="token">Código de invitación</label>
                    <InputText id="token" @bind-Value="_unirse.Token" />
                    <ValidationMessage For="() => _unirse.Token" />
                </div>
                <div class="fieldrow">
                    <label for="nombre">Tu nombre (si la invitación no lo trae)</label>
                    <InputText id="nombre" @bind-Value="_unirse.Nombre" />
                    <ValidationMessage For="() => _unirse.Nombre" />
                </div>
                <button class="btn btn-ghost" type="submit" disabled="@_enviando">Unirme</button>
            </EditForm>
        </div>
    </section>
</div>

@code {
    private readonly CrearModelo _crear = new();
    private readonly UnirseModelo _unirse = new();
    private string? _error;
    private bool _enviando;

    private Task CrearAsync() =>
        EjecutarAsync(() => Api.CrearHogarAsync(new CrearHogarRequest(_crear.NombreHogar.Trim(), _crear.NombreMiembro.Trim())));

    private Task UnirseAsync() =>
        EjecutarAsync(() => Api.AceptarInvitacionAsync(new AceptarInvitacionRequest(
            _unirse.Token.Trim(), string.IsNullOrWhiteSpace(_unirse.Nombre) ? null : _unirse.Nombre.Trim())));

    private async Task EjecutarAsync(Func<Task<HogarResumen>> accion)
    {
        // Enter y clic seguidos lanzarían dos altas: el botón deshabilitado no frena el envío con teclado.
        if (_enviando) return;
        _enviando = true;
        _error = null;
        try
        {
            await accion();
            // Se vuelve a pedir /api/yo: con el hogar nuevo (u otro más) decide si seleccionar o elegir.
            var destino = await Arranque.CargarAsync();
            Navegacion.NavigateTo(destino == DestinoArranque.ElegirHogar ? "elegir-hogar" : "", replace: true);
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _enviando = false;
        }
    }

    private sealed class CrearModelo
    {
        [Required(ErrorMessage = "Indica el nombre del hogar.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string NombreHogar { get; set; } = "";

        [Required(ErrorMessage = "Indica tu nombre.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string NombreMiembro { get; set; } = "";
    }

    private sealed class UnirseModelo
    {
        [Required(ErrorMessage = "Pega el código de invitación.")]
        public string Token { get; set; } = "";

        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string? Nombre { get; set; }
    }
}

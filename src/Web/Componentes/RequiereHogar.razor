@* Envuelve las páginas que necesitan un hogar seleccionado: si aún no lo hay, pasa por el flujo de arranque. Antes de pintar la página
   genera los gastos recurrentes pendientes del mes (una vez al día por hogar), para que Resumen o Gastos ya los incluyan. *@
@implements IDisposable
@inject EstadoHogar Hogar
@inject ServicioArranque Arranque
@inject GeneradorRecurrentes Recurrentes
@inject NavigationManager Navegacion

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">
        @_error
        <button class="btn btn-link p-0 ms-2" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (Hogar.HogarActual is not null && _preparado)
{
    @ChildContent
}
else
{
    <p>Cargando tu hogar…</p>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? _error;
    private bool _preparado;

    protected override async Task OnInitializedAsync()
    {
        Hogar.Cambiado += AlCambiarHogar;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _error = null;
        try
        {
            if (Hogar.HogarActual is null)
            {
                var destino = await Arranque.CargarAsync();
                if (destino == DestinoArranque.SinHogar) Navegacion.NavigateTo("sin-hogar", replace: true);
                else if (destino == DestinoArranque.ElegirHogar) Navegacion.NavigateTo("elegir-hogar", replace: true);
            }

            // Si mientras se generaba se eligió otro hogar, AlCambiarHogar no lo prepara (aún no estaba preparado): se prepara aquí
            // antes de pintarlo. Sin cambio de hogar es una sola vuelta.
            Guid? preparado;
            do
            {
                preparado = Hogar.HogarActual?.Id;
                await Recurrentes.GenerarPendientesAsync();
            } while (Hogar.HogarActual?.Id != preparado);
            _preparado = true;
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    // Cambiar de hogar sin salir de la página también genera los del hogar nuevo (lo ya hecho hoy vuelve sin esperar).
    private void AlCambiarHogar() => InvokeAsync(async () =>
    {
        StateHasChanged();
        if (_preparado && await Recurrentes.GenerarPendientesAsync() > 0) StateHasChanged();
    });

    public void Dispose() => Hogar.Cambiado -= AlCambiarHogar;
}

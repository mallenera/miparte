@* Pestaña Gastos: gastos del mes con su reparto, alta y edición. El servidor calcula el reparto según el perfil. *@
@using System.Globalization
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos

<h1 class="sr">Gastos de @Hogar.HogarActual?.Nombre</h1>

@if (_cargando)
{
    <div class="spinbox" role="status"><div class="spin"></div><span>Cargando gastos…</span></div>
}
else if (_errorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_errorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else
{
    <section class="card" aria-labelledby="t-gastos">
        <div class="card-head">
            <h2 id="t-gastos">Gastos</h2>
            <div class="mesnav">
                <button class="linkbtn" type="button" aria-label="Mes anterior" @onclick="() => CambiarMesAsync(-1)"><Icono Nombre="chevron-left" /></button>
                <span class="tag cur" aria-live="polite">@NombreMes</span>
                <button class="linkbtn" type="button" aria-label="Mes siguiente" @onclick="() => CambiarMesAsync(1)"><Icono Nombre="chevron-right" /></button>
            </div>
        </div>
        <div class="filtros" role="search" aria-label="Filtrar gastos">
            <label>Persona
                <select @bind="_filtroMiembro" @bind:after="AplicarFiltrosAsync">
                    <option value="">Todas</option>
                    @foreach (var m in _miembros.Where(m => m.Activo))
                    {
                        <option value="@m.Id">@m.Nombre</option>
                    }
                </select>
            </label>
            <label>Categoría
                <select @bind="_filtroCategoria" @bind:after="AplicarFiltrosAsync">
                    <option value="">Todas</option>
                    @foreach (var n in _arbol)
                    {
                        <option value="@n.Categoria.Id">@(new string(' ', n.Nivel * 3))@n.Categoria.Nombre</option>
                    }
                </select>
            </label>
            <label>Concepto
                <input type="search" maxlength="200" placeholder="Buscar…" @bind="_filtroTexto" @bind:event="onchange" @bind:after="AplicarFiltrosAsync" />
            </label>
            @if (HayFiltros)
            {
                <button class="linkbtn" type="button" @onclick="LimpiarFiltrosAsync">Quitar filtros</button>
            }
        </div>
        <p class="muted">@(HayFiltros ? "Total filtrado" : "Total del mes"): <b>@Euros(_gastos.Where(g => !g.Personal).Sum(g => g.Importe))</b> en @_gastos.Count(g => !g.Personal) @(_gastos.Count(g => !g.Personal) == 1 ? "gasto" : "gastos").
            @if (_gastos.Any(g => g.Personal))
            {
                <span>Personales (fuera de la liquidación): <b>@Euros(_gastos.Where(g => g.Personal).Sum(g => g.Importe))</b>.</span>
            }
        </p>

        @if (_error is not null)
        {
            <div class="aviso err" role="alert" style="margin-top: 12px">@_error</div>
        }

        <div style="margin-top: 10px">
            @foreach (var g in _gastos)
            {
                <div class="gastorow @(g.Personal ? "personal" : "")">
                    <div class="g-main">
                        <div class="g-concepto">@(string.IsNullOrWhiteSpace(g.Concepto) ? NombreCategoria(g.CategoriaId) : g.Concepto)</div>
                        <div class="muted g-meta">
                            @g.Fecha.ToString("dd/MM/yyyy", Es) · @NombreCategoria(g.CategoriaId) · paga @(g.PagadoDesdeAhorro ? "el ahorro" : g.PagadoPor is { } quien ? NombreMiembro(quien) : "la cuenta común")
                            @if (g.GastoRecurrenteId is not null) { <span class="tag off">recurrente</span> }
                        </div>
                        <div class="g-reparto">
                            @if (g.Personal)
                            {
                                <span class="tag admin">Personal: no entra en la liquidación</span>
                            }
                            @if (g.ACargoCuentaComun)
                            {
                                <span class="tag cur">Cuenta común: sin reparto entre personas</span>
                            }
                            @if (g.PagadoDesdeAhorro)
                            {
                                <span class="tag cur">Descontado del ahorro</span>
                            }
                            @foreach (var r in g.Repartos)
                            {
                                <span class="chip"><Avatar Nombre="@NombreMiembro(r.MiembroId)" Color="@ColorDe(r.MiembroId)" Tamano="sm" />@Euros(r.ImporteAsumido)</span>
                            }
                        </div>
                    </div>
                    <div class="g-importe">@Euros(g.Importe)</div>
                    <div class="c-acc">
                        @if (_confirmandoEliminar == g.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarAsync(g)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="linkbtn" type="button" aria-label="Editar gasto @g.Concepto" @onclick="() => EmpezarEdicion(g)">Editar</button>
                            <button class="linkbtn danger" type="button" aria-label="Eliminar gasto @g.Concepto" @onclick="() => _confirmandoEliminar = g.Id">Eliminar</button>
                        }
                    </div>
                </div>
            }

            @if (_gastos.Count == 0)
            {
                <div class="empty">@(HayFiltros ? "Ningún gasto de este mes coincide con los filtros." : "No hay gastos en este mes. Añade el primero abajo.")</div>
            }
        </div>

        @if (_adultos.Count == 0 || _categorias.Count == 0 || _perfiles.Count == 0)
        {
            <div class="aviso warn" style="margin-top: 14px">Para registrar gastos hace falta al menos un adulto, una categoría y un perfil de reparto.</div>
        }
        else
        {
            <form class="addcat" @onsubmit="GuardarAsync">
                <h3 style="flex: 1 1 100%; margin: 0">@(_editando is null ? "Nuevo gasto" : "Editar gasto")</h3>
                <label>Fecha
                    <input type="date" required @bind="_fecha" />
                </label>
                <label>Importe (€)
                    <input inputmode="decimal" required placeholder="0,00" @bind="_importe" @bind:event="oninput" />
                </label>
                <label>Categoría
                    <select @bind="_categoria" @bind:after="AlCambiarCategoria">
                        @foreach (var n in _arbol)
                        {
                            <option value="@n.Categoria.Id">@(new string(' ', n.Nivel * 3))@n.Categoria.Nombre</option>
                        }
                    </select>
                </label>
                <label>Paga
                    <select @bind="OrigenPago" @bind:after="AlCambiarPagador">
                        @foreach (var m in _adultos)
                        {
                            <option value="@m.Id">@m.Nombre</option>
                        }
                        @if (_cuentaConfigurada && PerfilCuentaComun is not null)
                        {
                            <option value="">Cuenta común (la paga directamente)</option>
                            <option value="ahorro">Ahorro (se descuenta del ahorro)</option>
                        }
                    </select>
                </label>
                @if (_pagador is not null)
                {
                    <label>Tipo de gasto
                        <select @bind="TipoGasto">
                            <option value="hogar">Del hogar (se reparte)</option>
                            <option value="personal">Personal (solo de quien paga, fuera de la liquidación)</option>
                        </select>
                    </label>
                }
                <label>Reparto
                    <select @bind="_perfil" disabled="@(_personal && _pagador is not null)">
                        @foreach (var p in _perfiles)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                </label>
                <label>Concepto
                    <input maxlength="200" placeholder="Opcional" @bind="_concepto" @bind:event="oninput" />
                </label>
                <button class="btn" type="submit" disabled="@(!ImporteValido)">@(_editando is null ? "Añadir" : "Guardar")</button>
                @if (_editando is not null)
                {
                    <button class="linkbtn" type="button" @onclick="CancelarEdicion">Cancelar</button>
                }
            </form>
        }
    </section>
}

@code {
    private static readonly CultureInfo Es = new("es-ES");

    private List<GastoResponse> _gastos = [];
    private List<MiembroDto> _miembros = [], _adultos = [];
    private List<CategoriaDto> _categorias = [];
    private List<PerfilRepartoDto> _perfiles = [];
    private List<NodoCategoria> _arbol = [];
    private bool _cargando = true;
    private string? _errorCarga, _error;
    private DateOnly _mes = new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private Guid? _editando, _confirmandoEliminar;
    private string _filtroMiembro = "", _filtroCategoria = "", _filtroTexto = "";
    private DateOnly _fecha = DateOnly.FromDateTime(DateTime.Today);
    private string _importe = "", _concepto = "";
    private Guid _categoria, _perfil;
    private Guid? _pagador;
    private bool _cuentaConfigurada, _desdeAhorro, _personal;

    /// <summary>Quién paga en el selector: un adulto (su id), la cuenta común ("") o el ahorro ("ahorro").</summary>
    private string OrigenPago
    {
        get => _desdeAhorro ? "ahorro" : _pagador?.ToString() ?? "";
        set
        {
            _desdeAhorro = value == "ahorro";
            _pagador = _desdeAhorro || value == "" ? null : Guid.Parse(value);
        }
    }

    /// <summary>Tipo de gasto en el selector: «hogar» (se reparte y entra en la liquidación) o «personal» (solo de quien paga).</summary>
    private string TipoGasto
    {
        get => _personal ? "personal" : "hogar";
        set => _personal = value == "personal";
    }

    /// <summary>Perfil de modo cuenta común del hogar, el único con el que puede pagar la cuenta directamente.</summary>
    private PerfilRepartoDto? PerfilCuentaComun => _perfiles.FirstOrDefault(p => p.Modo == "cuenta_comun");

    private string NombreMes => _mes.ToString("MMMM yyyy", Es);

    private bool ImporteValido => TryImporte(out _);

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = null;
        try
        {
            var miembros = Api.ListarMiembrosAsync();
            var categorias = Api.ListarCategoriasAsync();
            var perfiles = Api.ListarPerfilesAsync();
            await Task.WhenAll(miembros, categorias, perfiles);
            _miembros = miembros.Result;
            _adultos = _miembros.Where(m => m.Tipo == "adulto" && m.Activo).ToList();
            _categorias = categorias.Result;
            _perfiles = perfiles.Result;
            _arbol = ArbolCategorias.Aplanar(_categorias);
            _cuentaConfigurada = await CuentaConfiguradaAsync();
            await RecargarGastosAsync();
            ReiniciarFormulario();
        }
        catch (ApiException e)
        {
            _errorCarga = e.Message;
        }

        _cargando = false;
    }

    /// <summary>La cuenta común está configurada si algún adulto tiene aportación definida; si la consulta falla se trata como no configurada.</summary>
    private async Task<bool> CuentaConfiguradaAsync()
    {
        try
        {
            var cuenta = await Api.ObtenerCuentaComunAsync(_mes.ToString("yyyy-MM", CultureInfo.InvariantCulture));
            return cuenta.Aportaciones.Count > 0 || cuenta.AhorroAcumulado > 0;
        }
        catch (ApiException)
        {
            return false;
        }
    }

    /// <summary>La cuenta común solo paga gastos con su perfil: al elegirla como pagador se selecciona ese perfil.</summary>
    private void AlCambiarPagador()
    {
        if (_pagador is null) _personal = false; // un gasto personal siempre lo paga una persona
        if (_pagador is null && PerfilCuentaComun is { } p) _perfil = p.Id;
    }

    private bool HayFiltros => _filtroMiembro != "" || _filtroCategoria != "" || !string.IsNullOrWhiteSpace(_filtroTexto);

    /// <summary>Versión de la última petición de gastos: una respuesta tardía de otra selección no pisa la actual.</summary>
    private int _versionCarga;

    private async Task RecargarGastosAsync()
    {
        var version = ++_versionCarga;
        try
        {
            var gastos = await Api.ListarGastosAsync(
                    _mes.ToString("yyyy-MM", CultureInfo.InvariantCulture),
                    Guid.TryParse(_filtroCategoria, out var categoria) ? categoria : null,
                    Guid.TryParse(_filtroMiembro, out var miembro) ? miembro : null,
                    _filtroTexto);
            if (version == _versionCarga) _gastos = gastos.OrderByDescending(g => g.Fecha).ToList();
        }
        catch (ApiException) when (version != _versionCarga)
        {
            // Un fallo de una petición ya superada no debe mostrar un error junto a los resultados de la nueva.
        }
    }

    /// <summary>Vuelve a pedir los gastos del mes con los filtros elegidos; los errores salen en pantalla.</summary>
    private async Task AplicarFiltrosAsync()
    {
        _error = null;
        _confirmandoEliminar = null;
        try
        {
            await RecargarGastosAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    private Task LimpiarFiltrosAsync()
    {
        _filtroMiembro = _filtroCategoria = _filtroTexto = "";
        return AplicarFiltrosAsync();
    }

    private async Task CambiarMesAsync(int delta)
    {
        _mes = _mes.AddMonths(delta);
        _error = null;
        _confirmandoEliminar = null;
        if (_editando is not null) ReiniciarFormulario();
        try
        {
            await RecargarGastosAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    private string NombreMiembro(Guid id) => _miembros.FirstOrDefault(m => m.Id == id)?.Nombre ?? "—";

    private int ColorDe(Guid id) => ColorMiembro.De(id, _miembros);

    private string NombreCategoria(Guid id) => ArbolCategorias.Ruta(_categorias, id);

    private static string Euros(decimal importe) => importe.ToString("C2", Es);

    private bool TryImporte(out decimal valor) =>
        decimal.TryParse(_importe.Trim().Replace(',', '.'), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out valor)
        && valor > 0 && decimal.Round(valor, 2) == valor;

    private void ReiniciarFormulario()
    {
        _editando = null;
        _importe = "";
        _concepto = "";
        _categoria = _arbol.Count > 0 ? _arbol[0].Categoria.Id : Guid.Empty;
        _pagador = (_adultos.FirstOrDefault(m => m.EsYo) ?? _adultos.FirstOrDefault())?.Id ?? Guid.Empty;
        _desdeAhorro = false;
        _personal = false;
        _perfil = _perfiles.FirstOrDefault()?.Id ?? Guid.Empty;
        AlCambiarCategoria();
    }

    /// <summary>Al elegir una categoría se propone su perfil de reparto por defecto.</summary>
    private void AlCambiarCategoria()
    {
        if (_editando is null && _categorias.FirstOrDefault(c => c.Id == _categoria)?.PerfilRepartoId is { } p) _perfil = p;
    }

    private void EmpezarEdicion(GastoResponse g)
    {
        _editando = g.Id;
        _fecha = g.Fecha;
        _importe = g.Importe.ToString(CultureInfo.InvariantCulture);
        _categoria = g.CategoriaId;
        _pagador = g.PagadoPor;
        _desdeAhorro = g.PagadoDesdeAhorro;
        _personal = g.Personal;
        _perfil = g.PerfilRepartoId;
        _concepto = g.Concepto ?? "";
        _error = null;
    }

    private void CancelarEdicion() => ReiniciarFormulario();

    private Task GuardarAsync() =>
        EjecutarAsync(async () =>
        {
            if (!TryImporte(out var importe)) throw new ApiException(System.Net.HttpStatusCode.BadRequest, "Introduce un importe mayor que 0 con máximo 2 decimales.");
            var peticion = new GastoRequest(_fecha, importe, _categoria, _pagador, _perfil,
                string.IsNullOrWhiteSpace(_concepto) ? null : _concepto.Trim(), _desdeAhorro, _personal && _pagador is not null);
            if (_editando is { } id)
            {
                await Api.GuardarGastoAsync(id, peticion);
                ReiniciarFormulario();
                return "Gasto guardado";
            }

            await Api.CrearGastoAsync(peticion);
            _importe = "";
            _concepto = "";
            return "Gasto añadido";
        });

    private Task EliminarAsync(GastoResponse g) =>
        EjecutarAsync(async () =>
        {
            await Api.EliminarGastoAsync(g.Id);
            _confirmandoEliminar = null;
            if (_editando == g.Id) ReiniciarFormulario();
            return "Gasto eliminado";
        });

    /// <summary>Ejecuta una operación, recarga el mes y muestra el aviso; los errores de la API salen en pantalla.</summary>
    private async Task EjecutarAsync(Func<Task<string>> accion)
    {
        _error = null;
        try
        {
            var aviso = await accion();
            await RecargarGastosAsync();
            Avisos.Mostrar(aviso);
        }
        catch (ApiException e)
        {
            _error = e.Message;
            _confirmandoEliminar = null;
        }
    }
}

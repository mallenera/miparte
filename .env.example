# Copia este archivo a .env y rellénalo. .env está en .gitignore: nunca subas valores reales.

# URL del proyecto Supabase (emisor JWT: {Url}/auth/v1)
Supabase__Url=

# Solo si el proyecto aún usa el secreto HS256 legado (si se define, solo se aceptan tokens HS256)
# Supabase__JwtSecret=

# Cadena de conexión de Core.Api a Postgres. En Supabase: botón Connect -> Session pooler (puerto 5432;
# el Transaction pooler 6543 no se lleva bien con las sentencias preparadas de Npgsql).
# Usuario: el rol miparte_api (lo crea `migrar`; contraseña aparte, ver docs/despliegue.md), NUNCA postgres:
# postgres es propietario de las tablas y se salta la RLS. postgres solo para `migrar`. Formato:
# Desarrollo local (cifra la conexión, pero Npgsql no valida la identidad del servidor):
# Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=miparte_api.<project-ref>;Password=<password>;SSL Mode=Require
# Producción: valida certificado y nombre del servidor. Descarga el certificado CA de tu proyecto
# (panel de Supabase -> Database -> Settings -> SSL Configuration) y apunta Root Certificate a su ruta:
# Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=miparte_api.<project-ref>;Password=<password>;SSL Mode=VerifyFull;Root Certificate=/ruta/al/ca.crt
# Si la contraseña lleva ; o =, ponla entre comillas dobles: Password="..."
ConnectionStrings__Default=

# URL de Core.Api tal como la ve el navegador; entra en la CSP (connect-src) del front en docker compose.
# Debe coincidir con Api:CoreUrl del appsettings.json del front. Por defecto http://localhost:5001.
# CoreUrl=http://localhost:5001

# Orígenes permitidos por CORS (uno por índice), p. ej. http://localhost:8080
Cors__OrigenesPermitidos__0=

# Límites de Core.Api (opcionales; valores por defecto): peticiones por minuto y usuario/IP, las de
# endpoints costosos (crear hogar, invitaciones, generar recurrentes) y tamaño máximo del cuerpo en bytes.
# Limites__PeticionesPorMinuto=120
# Limites__CostosasPorMinuto=10
# Limites__ContactoPorHora=5
# Limites__MaxCuerpoBytes=65536

# Avisos del navegador (push) de Core.Api. Claves VAPID: se generan una vez (ver docs/despliegue.md). La privada es secreta:
# solo por entorno. Sin ellas la API no ofrece clave pública y no envía avisos (el front lo explica al usuario).
# Notificaciones__VapidPublica=
# Notificaciones__VapidPrivada=
# Notificaciones__Contacto=mailto:tu-correo@ejemplo.com

# Formulario de contacto de Core.Api: correo por la API HTTP de Resend (ver docs/despliegue.md). La clave es secreta: solo por
# entorno. Sin clave o sin destino, POST /api/contacto responde 503 y el front ofrece escribir por correo.
# Correo__ResendApiKey=
# Correo__Remitente=Mi parte, tu parte <onboarding@resend.dev>
# Correo__Destino=tu-correo@ejemplo.com

# URL de Assistant.Api tal como la ve el navegador; entra en la CSP (connect-src) del front en docker compose.
# Debe coincidir con Api:AssistantUrl del appsettings.json del front. Por defecto http://localhost:5002.
# AssistantUrl=http://localhost:5002

# Assistant.Api (chatbot). La clave de la API de Anthropic SOLO va aqui o en el entorno del servidor: nunca en
# el repo ni en appsettings. Sin ella el chat responde 503 "El asistente no esta disponible".
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-sonnet-5-5) y limites opcionales (valores por defecto):
# Asistente__Modelo=claude-sonnet-5-5
# Asistente__MensajesPorMinuto=10
# Asistente__MaxMensajes=20
# Asistente__MaxCaracteresMensaje=1500

@* Pestaña Resumen: gastos del mes por miembro y categoría, y liquidación (saldos, transferencias sugeridas y pagos registrados). *@
@using System.Globalization
@inject CoreApiClient Api
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos
@inject ServicioPermisos Permisos

<h1 class="sr">Resumen de @Hogar.HogarActual?.Nombre</h1>

@if (_m.Cargando)
{
    <div class="spinbox" role="status"><div class="spin"></div><span>Cargando el resumen…</span></div>
}
else if (_m.ErrorCarga is not null)
{
    <div class="aviso err" role="alert">
        @_m.ErrorCarga
        <button class="linkbtn" type="button" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (_m.Resumen is not null && _m.Liquidacion is not null)
{
    <div class="mesbar">
        <div class="mesnav">
            <button class="linkbtn" type="button" aria-label="Mes anterior" @onclick="() => _m.CambiarMesAsync(-1)"><Icono Nombre="chevron-left" /></button>
            <span class="tag cur" aria-live="polite">@_m.NombreMes</span>
            <button class="linkbtn" type="button" aria-label="Mes siguiente" @onclick="() => _m.CambiarMesAsync(1)"><Icono Nombre="chevron-right" /></button>
        </div>
    </div>
    @if (_m.Error is not null)
    {
        <div class="aviso err u-mt12" role="alert">@_m.Error</div>
    }

    <TarjetaCierreMes Mes="_m.Mes" Cierre="_m.CierreDelMes" PuedeCerrar="Permisos.Tiene(Claves.MesCerrar)" PuedeReabrir="Permisos.Tiene(Claves.MesReabrir)" Cambiado="_m.RecargarTrasCierreAsync" />

    <section class="card" aria-labelledby="t-liquidacion">
        <div class="card-head"><h2 id="t-liquidacion">Liquidación</h2></div>
        @if (_m.PorCiclos)
        {
            <p class="muted">Quién debe a quién desde el último cierre. Cuando el grupo haya saldado sus cuentas, cierra la liquidación: los gastos quedan liquidados y el cierre se guarda.</p>
        }
        else
        {
            <p class="muted">Quién debe a quién para quedar en paz este mes. Los pagos que registres, completos o parciales, se descuentan de los saldos.</p>
        }

        @if (_m.Liquidacion.Saldos.Count > 1)
        {
            <label class="filtro">Ver solo a
                <select @bind="_m.FiltroMiembro" aria-label="Filtrar la liquidación por miembro">
                    <option value="">Todos</option>
                    @foreach (var s in _m.Liquidacion.Saldos)
                    {
                        <option value="@s.MiembroId">@s.Nombre</option>
                    }
                </select>
            </label>
        }

        @foreach (var s in _m.Liquidacion.Saldos.Where(s => _m.FiltraMiembro(s.MiembroId)))
        {
            <div class="catrow">
                <div class="c-name"><Avatar Nombre="@s.Nombre" Color="@ColorMiembro.De(s.MiembroId, _m.Miembros)" Tamano="sm" /> @s.Nombre</div>
                <div class="c-sel">
                    <b class="g-importe saldo @(s.Saldo > 0 ? "pos" : s.Saldo < 0 ? "neg" : "")">@Saldo(s.Saldo)</b>
                    <span>@(s.Saldo > 0 ? "le deben" : s.Saldo < 0 ? "debe" : "en paz")</span>
                </div>
            </div>
        }

        @if (_m.Liquidacion.Transferencias.Count == 0)
        {
            <div class="aviso ok u-mt12" role="status">
                @(_m.PorCiclos
                    ? "No hay gastos pendientes desde el último cierre."
                    : _m.Liquidacion.Saldos.Count == 0 ? "Todavía no hay nada que liquidar este mes." : "Este mes está saldado: nadie debe nada.")
            </div>
        }
        else
        {
            <h3 class="u-sec">Transferencias sugeridas</h3>
            @if (_m.PorCiclos)
            {
                <p class="muted">Lo que queda por pagar entre vosotros. En la liquidación por ciclos los pagos se hacen fuera de la app.</p>
            }
            else
            {
                <p class="muted">Cambia el importe para registrar un pago parcial; lo que quede seguirá pendiente.</p>
            }
            @foreach (var t in _m.Liquidacion.Transferencias.Where(t => _m.FiltraMiembro(t.De) || _m.FiltraMiembro(t.A)))
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">@Formato.NombreMiembro(t.De, _m.Miembros) paga a @Formato.NombreMiembro(t.A, _m.Miembros)</div>
                        <div class="muted g-meta">Pendiente @Formato.Euros(t.Importe)</div>
                        @if (!_m.ImporteValido(t))
                        {
                            <div id="@IdError(t)" class="muted g-meta" role="status">Importe entre 0,01 y @Formato.Euros(t.Importe), con máximo 2 decimales.</div>
                        }
                    </div>
                    @if (!_m.PorCiclos)
                    {
                    <div class="c-acc pagoimp">
                        <label class="sr" for="@IdImporte(t)">Importe a pagar de @Formato.NombreMiembro(t.De, _m.Miembros) a @Formato.NombreMiembro(t.A, _m.Miembros)</label>
                        <input id="@IdImporte(t)" class="g-importe" inputmode="decimal" value="@_m.ImporteEscrito(t)"
                               aria-invalid="@(_m.ImporteValido(t) ? null : "true")" aria-describedby="@(_m.ImporteValido(t) ? null : IdError(t))"
                               @oninput="e => _m.EscribirImporte(t, e.Value?.ToString())" />
                        @if (Permisos.Tiene(Claves.PagosRegistrar))
                        {
                            <button class="btn" type="button" aria-label="Registrar el pago de @Formato.NombreMiembro(t.De, _m.Miembros) a @Formato.NombreMiembro(t.A, _m.Miembros)"
                                    disabled="@(_m.Guardando || !_m.ImporteValido(t))" @onclick="() => RegistrarPagoAsync(t)">Registrar pago</button>
                        }
                        else
                        {
                            <span class="muted">Sin permiso para registrar pagos</span>
                        }
                    </div>
                    }
                </div>
            }
        }

        @if (_m.PorCiclos)
        {
            <h3 class="u-sec">Cerrar liquidación</h3>
            @if (_m.ConfirmandoCierre)
            {
                <div class="aviso warn u-mt12" role="status">
                    <p>¿Cerrar la liquidación? Se marcan como liquidados todos los gastos pendientes y el cierre queda guardado con su total. Los gastos siguen visibles.</p>
                    <div class="u-fila-mt10">
                        <button class="btn" type="button" disabled="@_m.Guardando" @onclick="CerrarCicloAsync">Sí, cerrar la liquidación</button>
                        <button class="linkbtn" type="button" @onclick="() => _m.ConfirmandoCierre = false">Cancelar</button>
                    </div>
                </div>
            }
            else if (Permisos.Tiene(Claves.PagosRegistrar))
            {
                <p class="muted">Cuando el grupo haya saldado sus cuentas, cierra la liquidación.</p>
                <button class="btn" type="button" disabled="@_m.Guardando" @onclick="() => _m.ConfirmandoCierre = true">Cerrar liquidación</button>
            }
            else
            {
                <span class="muted">Sin permiso para cerrar la liquidación</span>
            }

            @if (_m.Ciclos.Count > 0)
            {
                <h3 class="u-sec">Liquidaciones cerradas</h3>
                @foreach (var c in _m.Ciclos)
                {
                    <div class="gastorow">
                        <div class="g-main">
                            <div class="g-concepto">Liquidación n.º @c.Numero</div>
                            <div class="muted g-meta">
                                @c.DesdeGastoFecha.ToString("dd/MM/yyyy", Es) a @c.HastaFecha.ToString("dd/MM/yyyy", Es)
                                · cerrada el @c.CerradoEn.ToLocalTime().ToString("dd/MM/yyyy", Es)@(c.Autor is null ? "" : " por " + c.Autor)
                            </div>
                        </div>
                        <div class="g-importe">@Formato.Euros(c.Total)</div>
                    </div>
                }
            }
        }

        @if (_m.Liquidacion.Pagos.Count > 0)
        {
            <h3 class="u-sec">Pagos registrados</h3>
            @foreach (var p in _m.Liquidacion.Pagos.Where(p => _m.FiltraMiembro(p.DeMiembroId) || _m.FiltraMiembro(p.AMiembroId)).OrderByDescending(p => p.Fecha))
            {
                <div class="gastorow">
                    <div class="g-main">
                        <div class="g-concepto">@Formato.NombreMiembro(p.DeMiembroId, _m.Miembros) pagó a @Formato.NombreMiembro(p.AMiembroId, _m.Miembros)</div>
                        <div class="muted g-meta">@p.Fecha.ToString("dd/MM/yyyy", Es)@(string.IsNullOrWhiteSpace(p.Concepto) ? "" : " · " + p.Concepto)</div>
                    </div>
                    <div class="g-importe">@Formato.Euros(p.Importe)</div>
                    <div class="c-acc">
                        @if (_m.ConfirmandoEliminar == p.Id)
                        {
                            <span class="muted">¿Eliminar?</span>
                            <button class="linkbtn danger" type="button" @onclick="() => EliminarPagoAsync(p)">Sí</button>
                            <button class="linkbtn" type="button" @onclick="() => _m.ConfirmandoEliminar = null">No</button>
                        }
                        else if (Permisos.Tiene(Claves.PagosRegistrar))
                        {
                            <button class="linkbtn danger" type="button" aria-label="Eliminar el pago de @Formato.NombreMiembro(p.DeMiembroId, _m.Miembros) a @Formato.NombreMiembro(p.AMiembroId, _m.Miembros)" @onclick="() => _m.ConfirmandoEliminar = p.Id">Eliminar</button>
                        }
                    </div>
                </div>
            }
        }
    </section>

    <TarjetaCompartir NombreHogar="@(Hogar.HogarActual?.Nombre ?? "")" Mes="@_m.Mes" Liquidacion="@_m.Liquidacion" Miembros="@_m.Miembros" PorCiclos="@_m.PorCiclos" />

    @if (_m.Resumen.CuentaComun is { } cuenta)
    {
        <section class="card" aria-labelledby="t-cuenta-resumen">
            <div class="card-head"><h2 id="t-cuenta-resumen">Cuenta común</h2></div>
            <p class="muted">Saldos al final de @_m.NombreMes. Los gastos a su cargo no entran en la liquidación entre personas.</p>
            <div class="u-fila-mt10">
                <span class="chip">Saldo&nbsp;<b id="cuenta-saldo">@Formato.Euros(cuenta.Saldo)</b></span>
                <span class="chip">Efectivo&nbsp;<b>@Formato.Euros(cuenta.Efectivo)</b></span>
                <span class="chip">Aportado este mes&nbsp;<b>@Formato.Euros(cuenta.AportadoMes)</b></span>
                <span class="chip">Gastado este mes&nbsp;<b>@Formato.Euros(cuenta.GastadoMes)</b></span>
                <span class="chip">Ahorro disponible&nbsp;<b>@Formato.Euros(cuenta.AhorroDisponible)</b></span>
                @if (cuenta.Pendiente > 0)
                {
                    <span class="chip">Pendiente de reembolsar&nbsp;<b>@Formato.Euros(cuenta.Pendiente)</b></span>
                }
            </div>
            @if (cuenta.Saldo < 0)
            {
                <div class="aviso warn u-mt12" role="status">La cuenta no cubre los gastos: faltan @Formato.Euros(-cuenta.Saldo).</div>
            }
            <a class="linkbtn u-mt8-inline" href="cuenta-comun">Ver la cuenta común</a>
        </section>
    }

    <section class="card" aria-labelledby="t-resumen">
        <div class="card-head"><h2 id="t-resumen">Resumen del mes</h2></div>

        @if (_m.Resumen.GastosTotales == 0)
        {
            <div class="empty">
                <span>@(_m.Resumen.GastosPersonales > 0 ? "No hay gastos del hogar" : "No hay gastos") en @_m.NombreMes.</span>
                <a class="btn" href="gastos">Añadir un gasto</a>
            </div>
            @foreach (var m in _m.Resumen.Miembros.Where(m => m.DebeCuentaComun > 0))
            {
                <div class="catrow">
                    <div class="c-name"><Avatar Nombre="@m.Nombre" Color="@ColorMiembro.De(m.MiembroId, _m.Miembros)" Tamano="sm" /> @m.Nombre</div>
                    <div class="c-sel"><span class="chip">La cuenta común le debe&nbsp;<b>@Formato.Euros(m.DebeCuentaComun)</b></span></div>
                </div>
            }
        }
        else
        {
            <div class="u-fila-mt10">
                <span class="chip">Gastos del mes&nbsp;<b id="total">@Formato.Euros(_m.Resumen.GastosTotales)</b></span>
            </div>

            <h3 class="u-sec">Por persona</h3>
            @foreach (var m in _m.Resumen.Miembros)
            {
                <div class="catrow">
                    <div class="c-name"><Avatar Nombre="@m.Nombre" Color="@ColorMiembro.De(m.MiembroId, _m.Miembros)" Tamano="sm" /> @m.Nombre</div>
                    <div class="c-sel">
                        Ha pagado @Formato.Euros(m.Pagado) · le corresponden @Formato.Euros(m.Asumido)
                        @if (m.DebeCuentaComun > 0)
                        {
                            <span class="chip">La cuenta común le debe&nbsp;<b>@Formato.Euros(m.DebeCuentaComun)</b></span>
                        }
                    </div>
                </div>
            }

            <h3 class="u-sec">Por categoría</h3>
            @foreach (var f in _m.FilasCategorias())
            {
                var n = f.Nodo;
                var importe = f.Directo ? n.Propio : n.Total;
                <div class="catrow resrow nivel-@Math.Min(f.Nivel, 4)">
                    <div class="c-name @(f.Nivel > 0 ? "sub" : "")">
                        @if (!f.Directo && n.Hijos.Count > 0)
                        {
                            var abierto = _m.EstaAbierta(n.CategoriaId);
                            <button class="linkbtn" type="button" aria-expanded="@(abierto ? "true" : "false")"
                                    aria-label="@(abierto ? "Contraer" : "Desplegar") @n.Nombre" @onclick="() => _m.Alternar(n.CategoriaId)">@(abierto ? "▾" : "▸")</button>
                        }
                        @(f.Directo ? "Sin subcategoría" : n.Nombre)
                    </div>
                    <div class="c-sel">
                        <b class="g-importe">@Formato.Euros(importe)</b> <span class="muted">@_m.Porcentaje(importe) %</span>
                        <progress class="barra" max="100" value="@_m.Porcentaje(importe)" aria-label="@_m.Porcentaje(importe) % del total del mes"></progress>
                        @if (!f.Directo && n.PorMiembro.Count > 0)
                        {
                            <span class="g-reparto">
                                @foreach (var p in n.PorMiembro)
                                {
                                    <span class="chip">
                                        <Avatar Nombre="@Formato.NombreMiembro(p.MiembroId, _m.Miembros)" Color="@ColorMiembro.De(p.MiembroId, _m.Miembros)" Tamano="sm" />
                                        @Formato.Euros(p.Importe)
                                    </span>
                                }
                            </span>
                        }
                    </div>
                </div>
            }
        }

        @if (_m.Resumen.GastosPersonales > 0)
        {
            <h3 class="u-sec">Gastos personales</h3>
            <p class="muted">Cada uno es solo de quien lo paga: no entran en la liquidación ni en los totales de arriba.</p>
            @foreach (var m in _m.Resumen.Miembros.Where(m => m.Personal > 0))
            {
                <div class="catrow">
                    <div class="c-name"><Avatar Nombre="@m.Nombre" Color="@ColorMiembro.De(m.MiembroId, _m.Miembros)" Tamano="sm" /> @m.Nombre</div>
                    <div class="c-sel"><span class="tag admin">Personal</span> <b class="g-importe">@Formato.Euros(m.Personal)</b></div>
                </div>
            }
        }
    </section>
}

@code {
    private static readonly CultureInfo Es = new("es-ES");

    private ModeloResumen _m = default!;

    protected override Task OnInitializedAsync()
    {
        _m = new ModeloResumen(Api, DateOnly.FromDateTime(DateTime.Today));
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        _m.PorCiclos = Hogar.HogarActual?.LiquidacionModo == ModosLiquidacion.Ciclos;
        _m.IniciarCarga();
        await Permisos.AsegurarAsync();
        await _m.CargarAsync();
    }

    /// <summary>Saldo con signo explícito, para que no dependa solo del color.</summary>
    private static string Saldo(decimal saldo) => (saldo > 0 ? "+" : "") + Formato.Euros(saldo);

    private static string IdImporte(TransferenciaDto t) => $"pago-{t.De}-{t.A}";

    private static string IdError(TransferenciaDto t) => $"pago-error-{t.De}-{t.A}";

    private Task RegistrarPagoAsync(TransferenciaDto t) => Mostrar(_m.RegistrarPagoAsync(t));

    private Task EliminarPagoAsync(PagoLiquidacionDto p) => Mostrar(_m.EliminarPagoAsync(p));

    private Task CerrarCicloAsync() => Mostrar(_m.CerrarCicloAsync());

    /// <summary>Espera la operación del modelo y, si salió bien, muestra su aviso.</summary>
    private async Task Mostrar(Task<string?> operacion)
    {
        if (await operacion is { } aviso) Avisos.Mostrar(aviso);
    }
}

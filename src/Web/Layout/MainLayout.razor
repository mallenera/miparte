@inherits LayoutComponentBase
@implements IDisposable
@inject ServicioSesion Sesion
@inject EstadoHogar Hogar
@inject ServicioAvisos Avisos
@inject ServicioTema Apariencia
@inject NavigationManager Navegacion

<div class="wrap">
    <header class="top">
        <Logotipo Lema="@(Hogar.HogarActual is null)" />
        <AuthorizeView>
            <Authorized>
                <div class="right">
                    @if (Hogar.HogarActual is { } actual)
                    {
                        <MenuDesplegable Etiqueta="@($"Cambiar de hogar. Hogar actual: {actual.Nombre}")">
                            <Boton>
                                <span class="mb-lab">Hogar</span>
                                <span class="mb-val">@actual.Nombre</span>
                                <span class="caret"><Icono Nombre="chevron-down" Tamano="16" /></span>
                            </Boton>
                            <ChildContent>
                                @foreach (var h in Hogar.Hogares)
                                {
                                    var id = h.Id;
                                    <button class="mitem" type="button" role="menuitemradio" aria-checked="@((id == actual.Id).ToString().ToLowerInvariant())"
                                            @onclick="() => CambiarHogarAsync(id)">
                                        <span class="tick">@if (id == actual.Id) { <Icono Nombre="check" Tamano="16" /> }</span>@h.Nombre
                                    </button>
                                }
                                <div class="msep"></div>
                                <a class="mitem" href="sin-hogar" role="menuitem"><Icono Nombre="plus" Tamano="16" />Crear otro hogar o unirme a uno</a>
                            </ChildContent>
                        </MenuDesplegable>
                    }
                    <MenuDesplegable Etiqueta="@($"Menú de usuario {context.User.Identity?.Name}")" ClaseBoton="user">
                        <Boton>
                            <Avatar Nombre="@(context.User.Identity?.Name ?? "?")" Color="0" />
                            <span class="caret"><Icono Nombre="chevron-down" Tamano="16" /></span>
                        </Boton>
                        <ChildContent>
                            <div class="mhead">Sesión iniciada como<b>@context.User.Identity?.Name</b></div>
                            <div class="msep"></div>
                            <div class="mhead mhead-ico" id="tema-etiqueta"><Icono Nombre="palette" Tamano="14" />Tema</div>
                            <div role="group" aria-labelledby="tema-etiqueta">
                                @foreach (var t in ServicioTema.Todos)
                                {
                                    var id = t.Id;
                                    <button class="mitem" type="button" role="menuitemradio" aria-checked="@((id == Apariencia.Actual).ToString().ToLowerInvariant())"
                                            @onclick="() => Apariencia.ElegirAsync(id)">
                                        <span class="tick">@if (id == Apariencia.Actual) { <Icono Nombre="check" Tamano="16" /> }</span>@t.Nombre
                                        <span class="@(id == ServicioTema.Sistema ? "muestra auto" : "muestra")" data-tema="@(id == ServicioTema.Sistema ? null : id)" aria-hidden="true"><i></i><i></i><i></i></span>
                                    </button>
                                }
                            </div>
                            <div class="msep"></div>
                            <button class="mitem" type="button" role="menuitem" @onclick="CerrarSesionAsync"><Icono Nombre="log-out" Tamano="16" />Cerrar sesión</button>
                        </ChildContent>
                    </MenuDesplegable>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <AvisoActualizacion />
    <AvisoConexion />

    <AuthorizeView>
        <Authorized>
            @if (Sesion.EsDemoLocal)
            {
                <div class="aviso warn aviso-demo" role="status">
                    Estás en el modo demo: los datos son de ejemplo y se pierden al recargar la página.
                    <a href="login" @onclick="CerrarSesionAsync" @onclick:preventDefault>Salir de la demo</a>
                </div>
            }
            else if (Sesion.EsDemo)
            {
                <div class="aviso warn aviso-demo" role="status">
                    Estás en la cuenta demo compartida: cualquiera puede verla y modificarla, así que no escribas datos personales.
                </div>
            }
        </Authorized>
    </AuthorizeView>

    @if (Hogar.HogarActual is not null)
    {
        <AuthorizeView>
            <Authorized>
                <nav class="tabs" aria-label="Secciones">
                    <NavLink class="tab" ActiveClass="active" href="" Match="NavLinkMatch.All"><Icono Nombre="layout-dashboard" Tamano="16" />Resumen</NavLink>
                    <NavLink class="tab" ActiveClass="active" href="gastos"><Icono Nombre="receipt" Tamano="16" />Gastos</NavLink>
                    <NavLink class="tab" ActiveClass="active" href="recurrentes"><Icono Nombre="repeat" Tamano="16" />Recurrentes</NavLink>
                    <NavLink class="tab" ActiveClass="active" href="cuenta-comun"><Icono Nombre="wallet" Tamano="16" />Cuenta común</NavLink>
                    <NavLink class="tab" ActiveClass="active" href="hogar"><Icono Nombre="users" Tamano="16" />Hogar</NavLink>
                    <NavLink class="tab" ActiveClass="active" href="categorias"><Icono Nombre="tag" Tamano="16" />Categorías</NavLink>
                    <span class="tab off" aria-disabled="true"><Icono Nombre="message-circle" Tamano="16" />Chat<span class="soon">pronto</span></span>
                </nav>
            </Authorized>
        </AuthorizeView>
    }

    <main class="panel" tabindex="-1">
        @* La clave recrea la página al cambiar de hogar para que recargue sus datos. *@
        <div @key="Hogar.HogarActual?.Id">@Body</div>
    </main>

    <PiePagina />
</div>

@if (Avisos.Texto is { } aviso)
{
    <div class="toast" role="status" aria-live="polite">@aviso</div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Hogar.Cambiado += Refrescar;
        Avisos.Cambiado += Refrescar;
        Apariencia.Cambiado += Refrescar;
        await Apariencia.IniciarAsync();
    }

    private async Task CambiarHogarAsync(Guid id)
    {
        await Hogar.SeleccionarAsync(id);
        Navegacion.NavigateTo("");
    }

    private async Task CerrarSesionAsync()
    {
        await Sesion.CerrarSesionAsync();
        await Hogar.LimpiarAsync();
        Navegacion.NavigateTo("login");
    }

    private void Refrescar() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Hogar.Cambiado -= Refrescar;
        Avisos.Cambiado -= Refrescar;
        Apariencia.Cambiado -= Refrescar;
    }
}
